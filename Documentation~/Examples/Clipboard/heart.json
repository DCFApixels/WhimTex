        {
          "id": "3cfc9a67ac374ef0b254e9c9867d6c19",
          "layerName": "Heart Shape",
          "enabled": true,
          "clippingMask": false,
          "opacity": 1.0,
          "blendMode": "Normal",
          "colorRange": "Standard",
          "blendRange": "Standard",
          "swizzle": {
            "packed": 0
          },
          "fx": [
            {
              "$type": "ShaderFX",
              "$id": "fx0",
              "active": true,
              "code": "// @param float _HeartWidth = 1 [0.65 .. 1.25]\r\n// @param float _NotchDepth = 1 [0.35 .. 1.8]\r\n// @param float _TipLength = 1 [0.65 .. 1.3]\r\n// @param float _Fullness = 1 [0.25 .. 1.8]\r\n\r\nfloat2 HeartCurve(float2 a, float2 b, float2 c, float2 d, float t)\r\n{\r\n    float s = 1-t;\r\n    return s*s*s*a + 3*s*s*t*b + 3*s*t*t*c + t*t*t*d;\r\n}\r\nvoid HeartEdge(float2 p, float2 a, float2 b, inout float distanceSq, inout float crossings)\r\n{\r\n    float2 e=b-a, v=p-a;\r\n    float2 nearPoint=v-e*saturate(dot(v,e)/max(dot(e,e),0.000001));\r\n    distanceSq=min(distanceSq,dot(nearPoint,nearPoint));\r\n    if ((a.y>p.y)!=(b.y>p.y))\r\n    {\r\n        float x=a.x+(p.y-a.y)*(b.x-a.x)/(b.y-a.y);\r\n        if(x>p.x)crossings+=1;\r\n    }\r\n}\r\nvoid HeartArc(float2 p, float2 a, float2 b, float2 c, float2 d, inout float distanceSq, inout float crossings)\r\n{\r\n    float2 previous=a;\r\n    [unroll] for(int i=1;i<=20;i++)\r\n    {\r\n        float2 next=HeartCurve(a,b,c,d,i/20.0);\r\n        HeartEdge(p,previous,next,distanceSq,crossings);\r\n        previous=next;\r\n    }\r\n}\r\nfloat4 ApplyFX(float2 uv, float4 color)\r\n{\r\n    uv = LayerToLocal(uv);\r\n    float2 p=float2(abs(uv.x*512-256),(1-uv.y)*512);\r\n    float d=1000000, crossings=0;\r\n    // Shape controls move the curve anchors, keeping symmetry and smooth joins.\r\n    float width = _HeartWidth;\r\n    float notch = 96.0 + 62.0 * _NotchDepth;\r\n    float tip = 178.0 + 229.0 * _TipLength;\r\n    HeartArc(p, float2(0,notch), float2(22*width,96+21*_NotchDepth),\r\n        float2(62*width,96), float2(95*width,96), d,crossings);\r\n    HeartArc(p, float2(95*width,96), float2(144*width,96),\r\n        float2(180*width,131), float2(180*width,178), d,crossings);\r\n    HeartArc(p, float2(180*width,178), float2(180*width,178+88*_TipLength),\r\n        float2(79*width*_Fullness,178+164*_TipLength), float2(0,tip), d,crossings);\r\n    float signedDistance=sqrt(d)*(fmod(crossings,2)>0.5?-1:1);\r\n    float aa=max(fwidth(signedDistance), 0.0001);\r\n    color.a*=saturate(0.5-signedDistance/aa);\r\n    return color;\r\n}\r\n",
              "parameters": [
                {
                  "name": "_HeartWidth",
                  "type": "Float",
                  "floatValue": 1.0,
                  "id": "1f2a23b7ec1d4aee97610bbdb4a7eebf",
                  "declaredInCode": true
                },
                {
                  "name": "_NotchDepth",
                  "type": "Float",
                  "floatValue": 1.0,
                  "id": "28dc051991b74f5d9438898a39e558bf",
                  "declaredInCode": true
                },
                {
                  "name": "_TipLength",
                  "type": "Float",
                  "floatValue": 1.0,
                  "id": "aa2eabc8102e48deaf12cd20df6492fb",
                  "declaredInCode": true
                },
                {
                  "name": "_Fullness",
                  "type": "Float",
                  "floatValue": 1.0,
                  "id": "14378ec4dfbc404f94fe2e860b4666ce",
                  "declaredInCode": true
                }
              ],
              "shaderKey": "93631b06c547453b92e3a16480cb137d",
              "$name": "Heart Shape FX"
            }
          ],
