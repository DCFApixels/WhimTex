          "fx": [
            {
              "$type": "ShaderFX",
              "$id": "fx1",
              "active": true,
              "code": "// @whimtex-effect Distortion/Polar Coordinates\r\n// @param enum _Mode = 0 {ToPolar: 0, FromPolar: 1} // Wrap a strip into a circle, or unwrap a circle into a strip.\r\n// @param float _AngleOffset = 0 [~-180 .. ~180] // Angular offset in degrees.\r\n// @param float _RadialOffset = 0 [~-1 .. ~1] // Radial offset in normalized coordinates.\r\n// @param transform2D _Area\r\n\r\nfloat4 ApplyFX(float2 uv, float4 color)\r\n{\r\n    float2 sampleUV = uv;\r\n    if (_Mode < 0.5)\r\n    {\r\n        float2 p = (_Area_ToLocal(uv) - 0.5) * 2.0;\r\n        float radius = length(p);\r\n        // The center has no unique angle. Choose zero without evaluating atan2(0, 0).\r\n        float angle = 0.0;\r\n        if (radius > 0.0) angle = atan2(p.y, p.x) / 6.28318530718;\r\n        // Only the angular coordinate wraps; radius continues beyond the frame.\r\n        sampleUV = float2(frac(angle - _AngleOffset / 360.0), radius - _RadialOffset);\r\n    }\r\n    else\r\n    {\r\n        float angle = (uv.x + _AngleOffset / 360.0) * 6.28318530718;\r\n        float radius = uv.y + _RadialOffset;\r\n        float sine, cosine;\r\n        sincos(angle, sine, cosine);\r\n        float2 localUV = 0.5 + float2(cosine, sine) * radius * 0.5;\r\n        sampleUV = _Area_ToInput(localUV);\r\n    }\r\n    return SampleInput(sampleUV);\r\n}\r\n",
              "parameters": [
                {
                  "name": "_Mode",
                  "type": "Float",
                  "floatValue": 0.0,
                  "id": "81fa723ea73d40589762909731d9276e",
                  "declaredInCode": true
                },
                {
                  "name": "_AngleOffset",
                  "type": "Float",
                  "floatValue": 0.0,
                  "id": "35366c888b5249c297cd5ad9f13898b3",
                  "declaredInCode": true
                },
                {
                  "name": "_RadialOffset",
                  "type": "Float",
                  "floatValue": 0.0,
                  "id": "0ff1b0ed4225426d8f224d90e872d369",
                  "declaredInCode": true
                },
                {
                  "name": "_Area",
                  "type": "Transform2D",
                  "transformValue": {
                    "position": {
                      "x": 0.5,
