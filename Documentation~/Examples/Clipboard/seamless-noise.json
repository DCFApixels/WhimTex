{
  "format": "whimtex.layers",
  "version": 1,
  "canvas": { "width": 256, "height": 256 },
  "layers": [
    {
      "type": "makeSeamless",
      "name": "Seamless Noise",
      "target": "source",
      "properties": {
        "makeSeamless": {
          "mode": "OffsetBlend",
          "edgeWidth": 0.2,
          "offsetTransitionStart": -0.25,
          "offsetContrastCompensation": true,
          "offsetSeamCorrection": true,
          "offsetPoissonEdges": "AllEdges",
          "offsetAutoRadius": true
        }
      }
    },
    {
      "type": "noise",
      "id": "source",
      "name": "Noise Source",
      "properties": {
        "enabled": false,
        "noise": { "noiseType": "OpenSimplex2", "seed": 42, "scale": 6, "fractal": "FBm", "octaves": 4 }
      }
    }
  ]
}
