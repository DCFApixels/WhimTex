          "fx": [
            {
              "$type": "ShaderFX",
              "$id": "fx0",
              "active": true,
              "code": "// @param float _Seed = 7 [0 .. 100]\r\n// @param float _Width = 0.008 [0.002 .. 0.025]\r\n// @param float _Jaggedness = 0.13 [0 .. 0.25]\r\n// @param float _ForkSpread = 0.22 [0 .. 0.35]\r\n// @param color _Tint = (0.18, 0.48, 1, 1)\r\n\r\nfloat BoltHash(float n)\r\n{\r\n    return frac(sin(n * 127.1 + _Seed * 31.7) * 43758.5453);\r\n}\r\n\r\nfloat BoltNoise(float y, float frequency)\r\n{\r\n    float p = y * frequency;\r\n    float i = floor(p);\r\n    return lerp(BoltHash(i), BoltHash(i + 1), frac(p)) * 2 - 1;\r\n}\r\n\r\nfloat BoltPath(float y)\r\n{\r\n    return 0.5 + _Jaggedness * (BoltNoise(y, 11) + 0.3 * BoltNoise(y + 2, 29));\r\n}\r\n\r\nfloat4 ApplyFX(float2 uv, float4 color)\r\n{\r\n    float y = uv.y;\r\n    float envelope = smoothstep(0.02, 0.15, y) * (1 - smoothstep(0.86, 0.98, y));\r\n    float width = _Width * (0.25 + 0.75 * envelope);\r\n    float distanceToBolt = abs(uv.x - BoltPath(y));\r\n\r\n    float t1 = saturate((y - 0.36) / 0.40);\r\n    float branch1 = BoltPath(y) + _ForkSpread * t1;\r\n    float d1 = abs(uv.x - branch1);\r\n    float mask1 = step(0.36, y) * (1 - smoothstep(0.67, 0.76, y));\r\n\r\n    float t2 = saturate((y - 0.57) / 0.28);\r\n    float branch2 = BoltPath(y) - _ForkSpread * t2 * 0.85;\r\n    float d2 = abs(uv.x - branch2);\r\n    float mask2 = step(0.57, y) * (1 - smoothstep(0.77, 0.85, y));\r\n\r\n    float aa = max(fwidth(uv.x), 0.0001);\r\n    float core = 1 - smoothstep(width, width + aa, distanceToBolt);\r\n    float fork1 = (1 - smoothstep(width * 0.5, width * 0.5 + aa, d1)) * mask1;\r\n    float fork2 = (1 - smoothstep(width * 0.4, width * 0.4 + aa, d2)) * mask2;\r\n    float filament = max(core, max(fork1, fork2));\r\n\r\n    float aura = exp2(-distanceToBolt / max(width * 3, 0.0001));\r\n    aura = max(aura, exp2(-d1 / max(width * 2, 0.0001)) * mask1 * 0.65);\r\n    aura = max(aura, exp2(-d2 / max(width * 2, 0.0001)) * mask2 * 0.5);\r\n\r\n    float alpha = saturate(filament + aura * 0.35) * envelope * _Tint.a;\r\n    float3 rgb = lerp(_Tint.rgb, float3(0.92, 0.97, 1), filament);\r\n    return float4(rgb, alpha);\r\n}\r\n",
