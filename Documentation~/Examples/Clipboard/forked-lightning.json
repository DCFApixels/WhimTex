        {
          "id": "e7bcde82cf6b43f393d44722e699f71a",
          "layerName": "Electric Filament",
          "enabled": true,
          "clippingMask": false,
          "opacity": 1.0,
          "blendMode": "Normal",
          "colorRange": "Standard",
