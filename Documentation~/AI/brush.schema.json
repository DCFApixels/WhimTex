{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhimTex clipboard brush JSON, version 1",
  "description": "1 MiB UTF-8 JSON maximum. Replaces the current brush, not document layers. HLSL is compiled on the GPU: trust the source. Texture URL downloads require confirmation. Runtime validates shader syntax and gradient ordering.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "whimtex.brush"
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "source": {
          "const": "Standard"
        },
        "url": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "format",
        "version",
        "source"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": {
          "const": "whimtex.brush"
        },
        "version": {
          "const": 1
        },
        "name": {
          "type": "string",
          "maxLength": 4096
        },
        "settings": {
          "$ref": "#/$defs/settings"
        },
        "source": {
          "const": "HLSL"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536,
          "description": "At most 65,536 UTF-8 bytes, checked at runtime. Line 1 must be // @whimtex-brush Category/Name. Define exactly one float4 BrushTip with one float2 and optional BrushSequence/BrushMotion, each at most once, in any order; contexts make it Dynamic, otherwise Static. Only input arguments are supported. Parameters use shared FX @param types, groups, linked/conditional controls and @control on line 2; brush textures support Texture/None only."
        },
        "resolution": {
          "type": "integer",
          "minimum": 32,
          "maximum": 2048,
          "default": 512,
          "description": "Static tip bake resolution. Ignored by Dynamic tips."
        }
      },
      "required": [
        "format",
        "version",
        "source",
        "code"
      ]
    }
  ],
  "$defs": {
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "size": {
          "type": "number",
          "minimum": 1,
          "maximum": 4096
        },
        "hardness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "spacing": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 4
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flow": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pressure": {
          "type": "boolean"
        },
        "pressureSize": {
          "$ref": "#/$defs/pressureBinding"
        },
        "pressureOpacity": {
          "$ref": "#/$defs/pressureBinding"
        },
        "pressureFlow": {
          "$ref": "#/$defs/pressureBinding"
        },
        "writeChannels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15,
          "description": "Write mask: R=1, G=2, B=4, A=8. Disabled channels retain their previous straight values. Disabling A also preserves fully transparent pixels."
        },
        "scatter": {
          "type": "number",
          "minimum": 0,
          "maximum": 4
        },
        "scatterBias": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "sizeJitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "angleJitter": {
          "type": "number",
          "minimum": 0,
          "maximum": 180
        },
        "angleOffset": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "flipX": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "flipY": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rotationMode": {
          "type": "string",
          "enum": [
            "Fixed",
            "StrokeDirection"
          ]
        },
        "randomAlgorithm": {
          "type": "string",
          "enum": [
            "Random",
            "Sobol"
          ]
        },
        "tipChannel": {
          "type": "string",
          "enum": [
            "Alpha",
            "Luminance",
            "InvertedLuminance",
            "Color"
          ]
        },
        "tipSdf": {
          "type": "boolean"
        },
        "mode": {
          "type": "string",
          "enum": [
            "Hardness",
            "Gradient"
          ]
        },
        "tipGradient": {
          "$ref": "#/$defs/gradient"
        },
        "tintGradient": {
          "$ref": "#/$defs/gradient"
        },
        "blend": {
          "type": "string",
          "enum": [
            "Normal",
            "Multiply",
            "Add",
            "Subtract",
            "Divide",
            "Screen",
            "Overlay",
            "Darken",
            "Lighten",
            "Dodge",
            "Burn",
            "LinearDodge",
            "LinearBurn",
            "LinearLight",
            "LinearLightAddSub",
            "VividLight",
            "PinLight",
            "HardMix",
            "HardLight",
            "SoftLight",
            "Difference",
            "Exclusion",
            "Negation",
            "Hue",
            "Saturation",
            "Color",
            "Luminosity"
          ]
        },
        "blendApplication": {
          "type": "string",
          "enum": [
            "Stroke",
            "Stamp"
          ]
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": []
    },
    "pressureBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "curve": {
          "type": "string",
          "maxLength": 4096,
          "description": "Pressure response on 0..1. linear, easeIn, easeOut, easeInOut, one, or keys((time,value,inTangent,outTangent,inWeight,outWeight,weightedMode),...). At least two keys; times and values within 0..1. Evaluated output is clamped."
        }
      }
    },
    "gradient": {
      "oneOf": [
        {
          "$ref": "#/$defs/gradientStops"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colors": {
              "$ref": "#/$defs/gradientStops"
            },
            "alphas": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "time": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "alpha": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "midpoint": {
                    "type": "number",
                    "minimum": 0.01,
                    "maximum": 0.99
                  }
                },
                "required": [
                  "time",
                  "alpha"
                ]
              }
            },
            "colorMode": {
              "type": "string",
              "enum": [
                "Linear",
                "Gamma",
                "Perceptual",
                "Hue"
              ],
              "default": "Perceptual",
              "description": "Retained automatic color mode; Custom uses customColorMode."
            },
            "interpolation": {
              "type": "string",
              "enum": [
                "Blend",
                "Balanced",
                "Smooth",
                "Adaptive",
                "Fixed",
                "Custom"
              ],
              "default": "Balanced"
            },
            "customColorMode": {
              "type": "string",
              "enum": [
                "Linear",
                "Gamma",
                "Perceptual",
                "Hue"
              ]
            },
            "customKeys": {
              "type": [
                "array",
                "null"
              ],
              "maxItems": 256,
              "items": {
                "$ref": "#/$defs/gradientCurveKey"
              },
              "description": "Independent manual channels, including inactive data. At least one key per channel, at most 64 distinct RGB positions and 64 alpha keys. IDs must be unique; times within each channel strictly increase with spacing at least 0.000001. Marker groups are derived from all channels before color/alpha filtering, never serialized. The obsolete link field is rejected."
            },
            "huePath": {
              "type": "string",
              "enum": [
                "Shortest",
                "Longest",
                "Increasing",
                "Decreasing"
              ],
              "default": "Shortest"
            },
            "chromaCorrection": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0
            },
            "wrapMode": {
              "type": "string",
              "enum": [
                "Clamp",
                "Repeat",
                "Mirror"
              ],
              "default": "Clamp"
            },
            "smoothness": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 1
            },
            "colorSpace": {
              "type": "string",
              "enum": [
                "Gamma",
                "Linear"
              ],
              "default": "Gamma",
              "description": "Technical encoding of stored automatic keys; independent of colorMode."
            }
          },
          "required": [
            "colors"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "interpolation": {
                    "const": "Custom"
                  }
                },
                "required": [
                  "interpolation"
                ]
              },
              "then": {
                "required": [
                  "customKeys",
                  "customColorMode"
                ],
                "properties": {
                  "customKeys": {
                    "type": "array",
                    "minItems": 4
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "customKeys": {
                    "type": "array",
                    "minItems": 1
                  }
                },
                "required": [
                  "customKeys"
                ]
              },
              "then": {
                "required": [
                  "customColorMode"
                ]
              }
            }
          ],
          "description": "colors/alphas/colorMode always retain automatic data. customKeys/customColorMode retain independent manual curves, whether active or not. Active Custom requires explicit saved data; switching/conversion is a separate C# or UI operation."
        }
      ]
    },
    "gradientStops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "color": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number",
                "minimum": -107,
                "maximum": 107
              },
              {
                "type": "number",
                "minimum": -107,
                "maximum": 107
              },
              {
                "type": "number",
                "minimum": -107,
                "maximum": 107
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            ],
            "items": false,
            "minItems": 4,
            "maxItems": 4
          },
          "midpoint": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 0.99
          },
          "alphaMidpoint": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 0.99
          }
        },
        "required": [
          "time",
          "color"
        ]
      },
      "description": "Stops must have strictly increasing times."
    },
    "gradientCurveKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "channel": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "time": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "value": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38
        },
        "inTangent": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 0
        },
        "outTangent": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 0
        },
        "tangentMode": {
          "type": "string",
          "enum": [
            "Auto",
            "Smooth",
            "Broken",
            "Linear",
            "Constant"
          ]
        }
      },
      "required": [
        "id",
        "channel",
        "time",
        "value",
        "tangentMode"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "channel": {
                "const": 3
              }
            },
            "required": [
              "channel"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      ],
      "description": "Stable positive unique id; channels 0..2 follow customColorMode, channel 3 is alpha. Keys are independent; no persistent links. Markers cluster all channels by time/id within 0.00001 of each earliest anchor, not transitively. Constant uses the right key between knots, like Fixed."
    }
  }
}
