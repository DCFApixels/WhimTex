          "minimum": 0,
          "maximum": 16384
        },
        "outsideDistance": {
          "type": "number",
          "minimum": 0,
          "maximum": 16384
        },
        "profile": {
          "type": "string",
          "maxLength": 65536
        },
        "encoding": {
          "type": "string",
