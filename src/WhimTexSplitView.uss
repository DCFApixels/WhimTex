}

.whimtex-document-header {
    border-bottom-width: 0;
}

.unity-button.whimtex-user-settings-button {
    flex-shrink: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.whimtex-pane-header {
    height: 24px;
    flex-shrink: 0;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    background-color: var(--whimtex-header);
    color: #cfcfcf;
    border-bottom-width: 1px;
    border-bottom-color: #171717;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-pane-header--light {
    background-color: var(--whimtex-header-light);
    color: #252525;
    border-bottom-color: #858585;
}

.whimtex-layer-settings-pane {
    min-height: 100px;
    flex-grow: 1;
}

.whimtex-layer-settings-pane > .unity-scroll-view {
    min-height: 0;
    flex-grow: 1;
}

.whimtex-effect-target > .unity-base-field__input {
    background-image: none;
    background-color: #282828;
    border-width: 1px;
    border-color: #202020;
    border-radius: 3px;
    padding: 0 0 0 2px;
    align-items: center;
    min-width: 0;
}

.whimtex-effect-target--light > .unity-base-field__input {
    background-color: #e4e4e4;
    border-color: #999999;
}

.whimtex-effect-target > .unity-base-field__input:hover,
.whimtex-effect-target:focus > .unity-base-field__input {
    border-color: #5688b8;
}

.unity-base-popup-field__arrow.whimtex-effect-target-arrow {
    display: none;
}

.unity-base-popup-field__text.whimtex-effect-target-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 2px;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-effect-target-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.whimtex-effect-target-preview,
.whimtex-effect-target-fallback {
    position: absolute;
    left: 0;
    top: 0;
    width: 16px;
    height: 16px;
}

.whimtex-effect-target-selector {
    width: 18px;
    align-self: stretch;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-left-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.2);
}

.whimtex-effect-target-ring {
    width: 10px;
    height: 10px;
    border-width: 1px;
    border-color: #b0b0b0;
    border-radius: 5px;
    align-items: center;
    justify-content: center;
}

.whimtex-effect-target-dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: #b0b0b0;
}

.whimtex-effect-target--light .whimtex-effect-target-ring {
    border-color: #555555;
}

.whimtex-effect-target--light .whimtex-effect-target-dot {
    background-color: #555555;
}

.whimtex-effect-target.whimtex-effect-target--drop > .unity-base-field__input {
    border-width: 1px;
    border-color: #5688b8;
    background-color: #315c85;
}

.whimtex-document-separator {
    height: 3px;
    flex-shrink: 0;
    background-color: var(--split-line);
}

.whimtex-split {
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.whimtex-split > .whimtex-split-handle {
    position: relative;
    flex-shrink: 0;
}

.whimtex-split-handle,
.whimtex-document-separator {
    overflow: visible;
    --split-line: rgb(18, 18, 18);
    --split-grip: rgb(160, 160, 160);
}

.whimtex-split-handle--light,
.whimtex-document-separator--light {
    --split-line: rgb(82, 82, 82);
    --split-grip: rgb(210, 210, 210);
}

.whimtex-split-handle--columns {
    width: 3px;
    height: 100%;
    cursor: resize-horizontal;
}

.whimtex-split-handle--rows {
    width: 100%;
    height: 3px;
    cursor: resize-vertical;
}

.whimtex-split-hit-area {
    position: absolute;
}

.whimtex-split-handle--columns > .whimtex-split-hit-area {
    left: -1px;
    right: -1px;
    top: 0;
    bottom: 0;
    cursor: resize-horizontal;
}

.whimtex-split-handle--rows > .whimtex-split-hit-area {
    left: 0;
    right: 0;
    top: -1px;
    bottom: -1px;
    cursor: resize-vertical;
}

.whimtex-split-handle > .whimtex-split-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin: 0;
    background-color: var(--split-line);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.whimtex-split-handle--rows > .whimtex-split-line {
    flex-direction: row;
}

.whimtex-split-line > .whimtex-split-grip {
    width: 2px;
    height: 2px;
    flex-shrink: 0;
    margin: 2px;
    border-radius: 1px;
    background-color: var(--split-grip);
}

.whimtex-split-handle--columns > .whimtex-split-line > .whimtex-split-grip {
    margin-left: 0;
    margin-right: 0;
}

.whimtex-split-handle--rows > .whimtex-split-line > .whimtex-split-grip {
    margin-top: 0;
    margin-bottom: 0;
}

.whimtex-split-handle:hover > .whimtex-split-line,
.whimtex-split-handle--dragging > .whimtex-split-line {
    background-color: #3b6997;
}

.whimtex-split-handle:hover > .whimtex-split-line > .whimtex-split-grip,
.whimtex-split-handle--dragging > .whimtex-split-line > .whimtex-split-grip,
.whimtex-split-handle:active > .whimtex-split-line > .whimtex-split-grip {
    background-color: rgb(239, 246, 255);
}

.whimtex-shader-fx {
    padding: 4px;
}

.whimtex-shader-fx-code {
    height: 320px;
    flex-shrink: 0;
}

.whimtex-code-line-numbers,
.whimtex-code-current-line {
    --whimtex-code-current-line-color: rgba(255, 255, 255, 0.045);
    --whimtex-code-current-number-color: rgb(190, 190, 190);
}

.whimtex-code-light .whimtex-code-line-numbers,
.whimtex-code-light .whimtex-code-current-line {
    --whimtex-code-current-line-color: rgba(0, 0, 0, 0.035);
    --whimtex-code-current-number-color: rgb(55, 55, 55);
}

.whimtex-code-current-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.whimtex-brush-hlsl-scroll {
    flex-grow: 1;
    min-height: 0;
}

.whimtex-brush-hlsl-code {
    flex-grow: 1;
    min-height: 80px;
}

.whimtex-shader-fx-code .unity-text-field__input,
.whimtex-brush-hlsl-code .unity-text-field__input {
    -unity-text-align: upper-left;
}

.whimtex-brush-hlsl-code .unity-text-field__input {
    white-space: normal;
}

.whimtex-shader-fx-code .unity-text-field__input {
    white-space: nowrap;
}

.whimtex-code-line-numbers {
    width: 36px;
    flex-shrink: 0;
    align-self: stretch;
    overflow: hidden;
    padding-right: 6px;
    margin-right: 4px;
    border-right-width: 1px;
    border-right-color: rgba(128, 128, 128, 0.25);
    background-color: rgba(0, 0, 0, 0.12);
    color: rgb(135, 135, 135);
}

.whimtex-code-line-numbers-wide {
    width: 44px;
}

.whimtex-code-line-numbers-very-wide {
    width: 60px;
}

.whimtex-code-line-numbers-light {
    color: rgb(105, 105, 105);
    background-color: rgba(0, 0, 0, 0.04);
}

.whimtex-code-line-metrics {
    position: absolute;
    visibility: hidden;
    white-space: nowrap;
    margin: 0;
    padding: 0;
}

.whimtex-shader-fx-diagnostics {
    min-height: 48px;
    max-height: 180px;
    margin-top: 4px;
}

.whimtex-shader-fx-parameter {
    padding: 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.whimtex-shader-fx-hidden {
    display: none;
}

.whimtex-layer-fx-buttons {
    flex-wrap: wrap;
}

.whimtex-layer-fx {
    min-width: 0;
}

.unity-button.whimtex-layer-fx-add {
    align-self: center;
    width: 140px;
    max-width: 100%;
    height: 24px;
    flex-shrink: 0;
    margin: 6px 4px 2px;
}

.whimtex-layer-fx-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.whimtex-layer-fx-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.whimtex-layer-fx-entry {
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}

.whimtex-layer-fx-entry--shader {
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.38);
}

.whimtex-layer-fx-entry--after-shader {
    margin-top: 0;
    border-top-width: 0;
}

.whimtex-fx-hidden-foldout-toggle {
    display: none;
}

.whimtex-layer-fx-foldout > .unity-foldout__content {
    margin-left: 0;
    padding-left: 0;
}

.whimtex-fx-hidden-label {
    display: none;
}

.whimtex-layer-fx-header {
    min-height: 24px;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0.12);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
    -unity-font-style: bold;
    flex-wrap: nowrap;
    justify-content: flex-start;
}

.whimtex-layer-fx-entry-toolbar {
    flex-wrap: nowrap;
    justify-content: flex-start;
    flex-grow: 1;
    min-width: 0;
}

.whimtex-fx-visibility-toggle {
    flex-grow: 0;
    flex-shrink: 0;
    width: 18px;
    min-width: 18px;
    margin-right: 3px;
    padding: 0;
}

.whimtex-fx-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    margin-right: 3px;
}

.whimtex-fx-foldout-toggle {
    flex-shrink: 0;
    width: 20px;
    min-width: 20px;
    height: 20px;
    margin-right: 3px;
    padding: 0;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    font-size: 18px;
    -unity-text-align: middle-center;
}

.whimtex-fx-foldout-toggle:hover,
.whimtex-fx-foldout-toggle:active {
    background-color: rgba(0, 0, 0, 0);
}

.whimtex-layer-fx-entry--drop-before {
    border-top-width: 2px;
    border-top-color: #78aaff;
}

.whimtex-layer-fx-entry--drop-after {
    border-bottom-width: 2px;
    border-bottom-color: #78aaff;
}

.whimtex-fx-note {
    margin: 2px 6px;
    font-size: 10px;
    opacity: 0.7;
}

.whimtex-fx-reference {
    margin: 4px 2px;
}

.whimtex-fx-code-info {
    min-width: 0;
}

.whimtex-fx-pixel-local {
    flex-direction: row;
    align-items: center;
    padding: 2px 3px;
}

.whimtex-fx-pixel-local-title {
    flex-shrink: 0;
    margin-right: 7px;
    -unity-font-style: bold;
}

.whimtex-fx-pixel-local-value {
    flex-shrink: 0;
    padding: 1px 5px;
    background-color: rgba(128, 128, 128, 0.16);
    border-radius: 3px;
}

.whimtex-fx-pixel-local-value--yes {
    color: #b5d9b8;
    background-color: rgba(73, 131, 81, 0.2);
}

.whimtex-fx-pixel-local--light > .whimtex-fx-pixel-local-value--yes {
    color: #285e30;
}

.whimtex-fx-pixel-local-context {
    min-width: 0;
    flex-shrink: 1;
    margin-left: 7px;
    opacity: 0.65;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.whimtex-fx-reference-item {
    flex-direction: row;
    min-width: 0;
}

.whimtex-fx-reference-bullet {
    width: 11px;
    flex-shrink: 0;
    margin: 0 2px 0 0;
}

.whimtex-fx-reference-item > .whimtex-fx-reference-text {
    flex-grow: 1;
    flex-shrink: 1;
}

.whimtex-fx-reference-section {
    min-width: 0;
    margin-top: 7px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: rgba(128, 128, 128, 0.25);
}

.whimtex-fx-reference-section--first {
    margin-top: 2px;
    padding-top: 0;
    border-top-width: 0;
}

.whimtex-fx-reference-heading {
    margin: 0 0 4px 0;
    -unity-font-style: bold;
}

.whimtex-fx-reference-text {
    min-width: 0;
    margin: 0 0 5px 0;
    white-space: normal;
}

.whimtex-fx-reference-text--link-hover {
    cursor: link;
}

.whimtex-fx-reference-readonly {
    margin: 0 0 5px 0;
    white-space: normal;
    opacity: 0.7;
}

.whimtex-fx-reference-note {
    margin: 4px 0 7px 0;
    padding: 5px 8px;
    border-left-width: 3px;
    border-left-color: rgba(128, 128, 128, 0.6);
    background-color: rgba(128, 128, 128, 0.08);
}

.whimtex-fx-parameter-header {
    -unity-font-style: bold;
    margin: 8px 3px 3px 3px;
    white-space: normal;
}

.whimtex-fx-transform-header {
    flex-direction: row;
    align-items: center;
}

.whimtex-fx-transform-header > .unity-foldout__toggle {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.whimtex-fx-transform-header .unity-toggle__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-fx-canvas-row {
    flex-direction: row;
    align-items: center;
}

.whimtex-fx-preview-row {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    min-width: 0;
}

.whimtex-fx-preview-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.whimtex-fx-preview {
    overflow: hidden;
    background-color: #353535;
}

.whimtex-fx-preview--standalone {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    align-self: center;
    margin: 3px;
    border-width: 1px;
    border-color: #222222;
}

.whimtex-fx-preview--field {
    width: 44px;
    height: 20px;
    flex-shrink: 0;
    margin: 1px 3px 1px 4px;
    border-width: 1px;
    border-color: #222222;
}

.whimtex-fx-preview--slider {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
}

.whimtex-fx-preview-slider {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    flex-shrink: 0;
}

.whimtex-soft-range-number,
.whimtex-minmax-range-number {
    width: 50px;
    flex-basis: 50px;
    height: 18px;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 0 0 4px;
}

.whimtex-fx-preview-range .whimtex-soft-range-slider {
    margin-right: 0;
}

.whimtex-fx-preview-slider .unity-base-slider__tracker {
    top: 50%;
    bottom: auto;
    height: 10px;
    min-height: 10px;
    max-height: 10px;
    margin-top: -5px;
    border-radius: 2px;
    overflow: hidden;
}

.whimtex-fx-preview-slider .unity-base-slider__dragger {
    position: absolute;
    top: 50%;
    bottom: auto;
    width: 12px;
    min-width: 12px;
    max-width: 12px;
    height: 10px;
    min-height: 10px;
    max-height: 10px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-image: none;
    background-color: transparent;
    overflow: visible;
}

.whimtex-fx-preview-slider .unity-base-slider__dragger-border { display: none; }

.whimtex-fx-preview-thumb {
    position: absolute;
    left: 0;
    top: 0;
    width: 12px;
    height: 10px;
    color: #dedede;
}

.whimtex-fx-preview-slider:hover .whimtex-fx-preview-thumb { color: #ffffff; }
.whimtex-fx-preview-slider:disabled .whimtex-fx-preview-thumb { color: #999999; }

.whimtex-minmax-range > .unity-base-field__input { flex-direction: row; }
.whimtex-minmax-range.whimtex-fx-preview-range,
.whimtex-minmax-range.whimtex-fx-preview-range > .unity-base-field__input { overflow: visible; }
.whimtex-minmax-range-slider {
    flex-grow: 1;
    min-width: 28px;
    margin-left: 0;
    margin-right: 0;
}
.whimtex-fx-preview-minmax {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    overflow: visible;
}
.whimtex-fx-preview-minmax > .unity-min-max-slider__input {
    margin-left: -8px;
    margin-right: -4px;
    overflow: visible;
}
.whimtex-fx-preview-minmax .unity-min-max-slider__tracker {
    position: absolute;
    top: 5px;
    bottom: auto;
    left: 8px;
    right: 8px;
    height: 10px;
    margin: 0;
    border-width: 0;
    border-radius: 2px;
    overflow: hidden;
}
.whimtex-fx-preview-minmax .unity-min-max-slider__dragger {
    position: absolute;
    top: 5px;
    bottom: auto;
    height: 10px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-image: none;
    background-color: rgba(255, 255, 255, 0.08);
    overflow: visible;
}
.whimtex-fx-preview-minmax .unity-min-max-slider__min-thumb,
.whimtex-fx-preview-minmax .unity-min-max-slider__max-thumb {
    position: absolute;
    top: 0;
    bottom: auto;
    width: 8px;
    height: 16px;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-image: none;
    background-color: transparent;
    overflow: visible;
}
.whimtex-fx-preview-minmax .whimtex-fx-preview-thumb--half { top: 4px; left: 0; width: 8px; height: 12px; }
.whimtex-fx-preview-minmax:hover .whimtex-fx-preview-thumb { color: #ffffff; }

.whimtex-cyclic-range,
.whimtex-cyclic-range > .unity-base-field__input { overflow: visible; }
.whimtex-cyclic-range-slider { height: 20px; min-height: 20px; max-height: 20px; overflow: visible; }
.whimtex-cyclic-range-rail { position: absolute; left: 0; right: 4px; top: 5px; height: 10px; overflow: visible; }
.whimtex-cyclic-range-track {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: #373737; border-radius: 2px; overflow: hidden;
}
.whimtex-cyclic-range-selection {
    position: absolute; top: 0; height: 10px; background-color: rgba(255, 255, 255, 0.12);
}
.whimtex-cyclic-range-handle { position: absolute; top: 0; width: 8px; height: 16px; overflow: visible; }
.whimtex-cyclic-range-handle--start { margin-left: -8px; }
.whimtex-cyclic-range-handle .whimtex-fx-preview-thumb--half { top: 4px; width: 8px; height: 12px; }
.whimtex-cyclic-range-handle:hover .whimtex-fx-preview-thumb,
.whimtex-cyclic-range-handle:focus .whimtex-fx-preview-thumb { color: #ffffff; }
.whimtex-cyclic-range:disabled .whimtex-fx-preview-thumb { color: #999999; }

.whimtex-fx-preview--error {
    border-width: 1px;
    border-color: #b76b42;
}

.whimtex-fx-canvas-field {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.whimtex-fx-parameter-action {
    width: 24px;
    height: 20px;
    margin-left: 2px;
    margin-top: -1px;
    margin-bottom: -1px;
    font-size: 14px;
    align-items: center;
    justify-content: center;
}

.whimtex-fx-parameter-action > .whimtex-tool-icon {
    width: 18px;
    height: 18px;
}

.whimtex-fx-parameter-group {
    margin: 4px 2px 5px 2px;
    background-color: #393939;
    border-width: 1px;
    border-color: #242424;
    border-radius: 4px;
}

.whimtex-fx-parameter-group--light {
    background-color: #f2f2f2;
    border-color: #b5b5b5;
}

.whimtex-fx-parameter-foldout {
    margin: 0;
}

.whimtex-fx-parameter-foldout-toggle > .unity-base-field__input {
    flex-grow: 0;
    flex-shrink: 0;
}

.whimtex-fx-parameter-group-header.whimtex-fx-parameter-foldout-header {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-bottom-width: 0;
    background-color: transparent;
}

.whimtex-fx-parameter-foldout-header > .whimtex-fx-parameter-group-title {
    padding-top: 0;
}

.whimtex-fx-parameter-foldout > .unity-foldout__content {
    margin-left: 0;
}

.whimtex-fx-tabs {
    margin: 4px 2px 5px 2px;
    background-color: #2b2b2b;
    border-width: 1px;
    border-color: #242424;
    border-radius: 3px;
    min-width: 0;
}

.whimtex-fx-tabs-title {
    margin: 0;
    padding: 5px 8px 2px 8px;
    -unity-font-style: bold;
}

.whimtex-fx-tabs-strip {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: flex-end;
    padding: 5px 5px 0 5px;
    border-bottom-width: 1px;
    border-bottom-color: #242424;
}

.whimtex-fx-tab {
    flex-grow: 0;
    flex-shrink: 1;
    min-width: 0;
    min-height: 24px;
    margin: 0 2px -1px 0;
    padding: 3px 14px;
    border-width: 1px;
    border-color: transparent;
    border-bottom-color: #242424;
    border-radius: 0;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    background-color: transparent;
    color: #b7b7b7;
}

.whimtex-fx-tab:hover {
    background-color: #414141;
    color: #d7d7d7;
}

.whimtex-fx-tab--toggle {
    padding-left: 25px;
}

.whimtex-fx-tab-header {
    flex-direction: row;
    flex-shrink: 1;
    min-width: 0;
}

.whimtex-fx-tab-toggle {
    position: absolute;
    left: 5px;
    top: 1px;
    bottom: 0;
    margin: 0;
    padding: 0;
}

.whimtex-fx-tab.whimtex-fx-tab--selected {
    background-color: #393939;
    border-color: #242424;
    border-bottom-color: #393939;
    color: #d7d7d7;
}

.whimtex-fx-tab-page {
    padding: 5px 6px;
    background-color: #393939;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
}

.whimtex-fx-tab-page--inactive {
    display: none;
}

.whimtex-fx-tabs--light {
    background-color: #d0d0d0;
    border-color: #b5b5b5;
}

.whimtex-fx-tabs--light > .whimtex-fx-tabs-strip {
    border-bottom-color: #b5b5b5;
}

.whimtex-fx-tabs--light .whimtex-fx-tab {
    color: #454545;
    border-bottom-color: #b5b5b5;
}

.whimtex-fx-tabs--light .whimtex-fx-tab:hover {
    background-color: #e0e0e0;
    color: #242424;
}

.whimtex-fx-tabs--light .whimtex-fx-tab.whimtex-fx-tab--selected {
    background-color: #f2f2f2;
    color: #242424;
    border-color: #b5b5b5;
    border-bottom-color: #f2f2f2;
}

.whimtex-fx-tabs--light > .whimtex-fx-tab-page {
    background-color: #f2f2f2;
}

.whimtex-fx-parameter-group-header,
.whimtex-fx-parameter-foldout-toggle {
    flex-direction: row;
    align-items: center;
    min-height: 20px;
    padding: 2px 4px 3px 4px;
    margin-bottom: 4px;
    background-color: #414141;
    border-bottom-width: 1px;
    border-bottom-color: #292929;
    border-radius: 3px;
}

.whimtex-fx-parameter-group-content {
    padding: 4px 6px;
}

.whimtex-fx-parameter-group--light > .whimtex-fx-parameter-group-header,
.whimtex-fx-parameter-group--light .whimtex-fx-parameter-foldout-toggle {
    background-color: #f8f8f8;
    border-bottom-color: #d0d0d0;
}

.whimtex-fx-parameter-group-toggle {
    width: 18px;
    min-width: 18px;
    margin: 0 4px 0 0;
}

.whimtex-fx-group-header-field {
    width: 40%;
    min-width: 130px;
    max-width: 320px;
    margin: 0;
    flex-shrink: 1;
}

.whimtex-fx-effect-control {
    flex-direction: row;
    align-items: center;
    width: 100px;
    max-width: 45%;
    flex-shrink: 1;
    margin-right: 4px;
}
.whimtex-fx-effect-control--bool { width: 20px; }
.whimtex-fx-effect-control--vector { width: 200px; }
.whimtex-fx-effect-control--seed { width: 170px; }
.whimtex-fx-effect-control > .whimtex-fx-group-header-field {
    flex-grow: 1;
    width: auto;
    min-width: 0;
    max-width: none;
}

.whimtex-fx-effect-control-handle {
    opacity: 0.7;
    width: 18px;
    flex-shrink: 0;
    margin: 0 2px 0 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.whimtex-fx-group-header-field > .unity-base-field__label {
    display: none;
}

.whimtex-fx-group-header-field > .unity-base-field__input {
    flex-grow: 1;
    width: auto;
}

.whimtex-fx-parameter-group-title {
    flex-grow: 1;
    min-width: 0;
    margin: 2px 0 0 0;
    padding-left: 1px;
    -unity-font-style: bold;
    white-space: normal;
}

.whimtex-fx-parameter-group-title--draggable {
    cursor: resize-horizontal;
}

.whimtex-fx-parameter-group--empty > .whimtex-fx-parameter-group-header {
    margin-bottom: 0;
    border-bottom-width: 0;
}

.whimtex-fx-parameter-group--empty > .whimtex-fx-parameter-group-content,
.whimtex-fx-parameter-group--empty > .whimtex-fx-parameter-foldout > .unity-foldout__content > .whimtex-fx-parameter-group-content {
    display: none;
}

.whimtex-fx-conditional-parameter--hidden {
    display: none;
}

.whimtex-output-preview-footer { min-height: 20px; flex-shrink: 0; overflow: hidden; }
.whimtex-output-preview-title {
    height: 20px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.45);
    border-bottom-color: rgba(0, 0, 0, 0.45);
    -unity-font-style: bold;
    cursor: resize-vertical;
}
.whimtex-output-preview-grip {
    flex-grow: 1;
    height: 5px;
    margin-left: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(128, 128, 128);
}
.whimtex-output-preview-surface {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(36, 36, 36);
}
.whimtex-output-preview-surface--hidden { display: none; }
.whimtex-output-preview-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.whimtex-pattern-field--hidden {
    display: none;
}

.whimtex-canvas-view-footer {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.whimtex-canvas-view-status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-align: middle-center;
    font-size: 10px;
}

.whimtex-canvas-view-status--hidden {
    visibility: hidden;
}

.whimtex-canvas-view-quality {
    flex-direction: row;
    align-items: center;
    height: 22px;
    flex-shrink: 0;
}

.whimtex-canvas-view-quality-label {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 10px;
}

.whimtex-canvas-view-quality-slider {
    width: 60px;
    height: 20px;
    flex-shrink: 0;
    margin: 0 4px;
}

.whimtex-canvas-view-footer-side,
.whimtex-canvas-view-footer-group {
    flex-direction: row;
    flex-shrink: 0;
    height: 22px;
    align-items: center;
}

.whimtex-canvas-view-channels {
    margin-left: auto;
}

.whimtex-canvas-view-footer-group--separated,
.whimtex-transform-action-group--separated {
    margin-left: 6px;
    padding-left: 4px;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.25);
}

.whimtex-canvas-view-footer--compact {
    height: auto;
    min-height: 26px;
    flex-wrap: wrap;
}

.whimtex-canvas-view-footer--compact .whimtex-canvas-view-status {
    display: none;
}

.whimtex-canvas-view-footer--compact > .whimtex-canvas-view-footer-side {
    flex-wrap: wrap;
    height: auto;
    max-width: 100%;
}

.unity-button.whimtex-channel-button {
    --channel-fill: #6a6a6e;
    --channel-hover: #79797d;
    --channel-text: #eeeeef;
    --channel-border: #939397;
    width: 24px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
    padding: 1px 0 0 0;
    background-image: none;
    background-color: #252527;
    color: #a2a2a6;
    border-width: 1px;
    border-top-color: #111113;
    border-left-color: #19191b;
    border-right-color: #424246;
    border-bottom-color: #56565a;
    border-radius: 2px;
    font-size: 10px;
}

.unity-button.whimtex-channel-button:hover {
    background-color: #2e2e31;
}

.unity-button.whimtex-channel-button--enabled {
    padding: 0;
    background-color: var(--channel-fill);
    color: var(--channel-text);
    border-color: var(--channel-border);
}

.unity-button.whimtex-channel-button--enabled:hover {
    background-color: var(--channel-hover);
}

.unity-button.whimtex-channel-button--r {
    --channel-fill: #92555d;
    --channel-hover: #a2646c;
    --channel-text: #ead9d9;
    --channel-border: #b77981;
}

.unity-button.whimtex-channel-button--g {
    --channel-fill: #487c59;
    --channel-hover: #578b68;
    --channel-text: #dce8df;
    --channel-border: #6ba27e;
}

.unity-button.whimtex-channel-button--b {
    --channel-fill: #4b70a0;
    --channel-hover: #5a7faf;
    --channel-text: #dce3ed;
    --channel-border: #7298c5;
}
.whimtex-layer-preview-channels {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-left: 4px;
    cursor: arrow;
}
.unity-button.whimtex-channel-button.whimtex-layer-preview-channel {
    --channel-fill: #696969;
    --channel-hover: #797979;
    --channel-text: #eeeeee;
    --channel-border: #939393;
    width: 20px;
    height: 16px;
    min-height: 0;
    -unity-font-style: normal;
    cursor: arrow;
}
.whimtex-storage-description { font-size: 10px; margin-left: 3px; margin-top: 2px; opacity: 0.7; }
.whimtex-compact-storage { align-self: flex-start; margin-bottom: 6px; }
.unity-button.whimtex-hdr-button {
    width: 36px;
    margin-right: 6px;
}

.whimtex-seamless-channels {
    flex-direction: row;
    align-items: center;
}

.whimtex-seamless-channels > .unity-toggle {
    margin-left: 0;
    margin-right: 8px;
    flex-shrink: 0;
}

.whimtex-channel-mapping-row,
.whimtex-channel-mapping-channels {
    flex-direction: row;
    align-items: center;
}

.whimtex-channel-mapping {
    flex-shrink: 0;
}

.whimtex-channel-mapping-channels {
    flex-grow: 1;
    min-width: 0;
}

.whimtex-channel-mapping-channel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 2px;
    margin-right: 0;
}

.whimtex-channel-mapping-hint--hidden {
    display: none;
}

.whimtex-channel-mapping-channel > .unity-base-field__input {
    min-width: 0;
}

.whimtex-channel-mapping-presets {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.whimtex-channel-mapping-presets > .unity-toolbar-menu__text {
    display: none;
}

.whimtex-channel-mapping-presets > .unity-toolbar-menu__arrow {
    margin: 0;
}

.whimtex-canvas-view-exposure {
    width: 88px;
    flex-shrink: 0;
    margin-right: 7px;
}

.whimtex-canvas-view-exposure > .unity-base-field__label {
    min-width: 24px;
    width: 24px;
    flex-shrink: 0;
    margin: 0 2px 0 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.whimtex-canvas-view-exposure > .unity-base-field__input {
    min-width: 0;
}

.whimtex-canvas-view-exposure--adjusted > .unity-base-field__label {
    color: rgb(231, 186, 111);
}

.whimtex-canvas-view-exposure--adjusted > .unity-base-field__input {
    background-color: rgb(78, 62, 39);
}

.unity-button.whimtex-channel-button.whimtex-channel-button--error { color: rgb(255, 125, 195); }
.unity-button.whimtex-debug-button { align-items: center; justify-content: center; padding: 0; }

.whimtex-user-settings {
    padding: 8px 10px;
}

.whimtex-user-settings-heading {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 6px;
}

.whimtex-user-settings-color > .unity-base-field__label {
    min-width: 120px;
}

.whimtex-user-settings-color > .unity-base-field__input {
    flex-grow: 1;
    min-width: 50px;
}

.whimtex-user-settings-folder-row {
    flex-direction: row;
    align-items: center;
}

.whimtex-user-settings-folder {
    flex-grow: 1;
    min-width: 0;
}

.whimtex-user-settings-folder > .unity-base-field__label {
    min-width: 100px;
    width: 100px;
}

.whimtex-user-settings-folder > .unity-base-field__input {
    min-width: 0;
}

.whimtex-user-settings-folder-button {
    width: 24px;
    flex-shrink: 0;
    margin-left: 0;
    padding-left: 0;
    padding-right: 0;
}

.whimtex-user-settings-note {
    white-space: normal;
    margin-top: 12px;
    margin-bottom: 8px;
    opacity: 0.7;
}

.whimtex-user-settings-reset {
    align-self: flex-start;
}
.whimtex-normal-map-simple .whimtex-normal-map-advanced,
.whimtex-normal-map-hidden {
    display: none;
}

.whimtex-normal-map-heading {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.3);
}

.whimtex-normal-map-hint {
    white-space: normal;
    opacity: 0.7;
    margin-bottom: 4px;
}

.whimtex-normal-map-notice {
    -unity-text-align: middle-left;
    white-space: normal;
    background-color: transparent;
    border-width: 0;
    opacity: 0.7;
}

.whimtex-normal-map-notice:hover {
    opacity: 1;
}
.whimtex-hidden,
.whimtex-brush-setting--hidden {
    display: none;
}
.whimtex-layer-agent-status {
    min-width: 16px;
    -unity-text-align: middle-center;
    color: rgba(170, 193, 212, 0.8);
}

.whimtex-layer-settings-header {
    flex-direction: row;
    align-items: center;
}

.whimtex-layer-settings-title {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy {
    flex-shrink: 0;
    height: 22px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    border-width: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.2);
    border-right-color: rgba(0, 0, 0, 0.2);
    border-radius: 0;
    background-image: none;
    background-color: transparent;
    font-size: 10px;
    opacity: 0.75;
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy:hover {
    background-color: rgba(128, 128, 128, 0.16);
    opacity: 1;
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy:active {
    background-color: rgba(128, 128, 128, 0.3);
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy:disabled {
    background-color: transparent;
    opacity: 0.35;
}
.whimtex-missing-thumbnail {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: #e9b86d;
}

.whimtex-shape-corners {
    width: 100%;
    max-width: 288px;
    height: 132px;
    align-self: center;
    margin: 4px 0;
}

.whimtex-fx-seed-row {
    flex-direction: row;
    align-items: center;
}

.whimtex-fx-seed-input {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}

.whimtex-fx-seed-random {
    flex-shrink: 0;
    margin-left: 3px;
}
.whimtex-shape-corners-radial { height: 200px; }
.whimtex-shape-corners-select { height: 196px; }
.whimtex-shape-corner-fields {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}
.whimtex-shape-corner-control {
    position: absolute;
    width: 33.333%;
    flex-direction: row;
    align-items: center;
}
.whimtex-shape-corner-control > .unity-float-field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
}
.whimtex-shape-corner-control > .unity-float-field > .unity-base-field__label {
    min-width: 0;
    width: auto;
    padding: 0;
    margin: 0 3px 0 0;
    -unity-text-align: middle-left;
}
.whimtex-shape-corner-style {
    width: 28px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
}
.whimtex-shape-corner-style > .unity-base-field__input { padding: 0; }
.whimtex-shape-corner-style .unity-enum-field__text { display: none; }
.whimtex-shape-corner-style .unity-enum-field__arrow {
    width: 8px;
    margin: 0;
}
.whimtex-shape-corner-icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
}
.whimtex-shape-corner-diagram {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 30%;
    height: 88px;
    color: var(--whimtex-icon);
}
.whimtex-shape-corners-select > .whimtex-shape-corner-diagram {
    top: 4px;
    translate: -50% 0;
    width: 152px;
    height: 152px;
}
.whimtex-shape-corner-link {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #202020;
    border-radius: 3px;
    background-color: var(--whimtex-surface);
    color: var(--whimtex-icon);
}
.whimtex-shape-corner-link-edge {
    left: auto;
    right: 0;
    top: 0;
    translate: 0 0;
}
.whimtex-shape-corner-link > .whimtex-tool-icon { width: 18px; height: 18px; }
.whimtex-shape-corner-link:hover { background-color: var(--whimtex-hover-overlay); }
.whimtex-shape-corner-nw { left: 0; top: 0; }
.whimtex-shape-corner-ne { right: 0; top: 0; }
.whimtex-shape-corner-sw { left: 0; bottom: 0; }
.whimtex-shape-corner-se { right: 0; bottom: 0; }
.whimtex-shape-corner-n { left: 50%; top: 0; translate: -50% 0; }
.whimtex-shape-corner-s { left: 50%; bottom: 0; translate: -50% 0; }
.whimtex-shape-corner-w { left: 0; top: 50%; translate: 0 -50%; }
.whimtex-shape-corner-e { right: 0; top: 50%; translate: 0 -50%; }
.whimtex-shape-corners-groups .whimtex-shape-corner-control { width: 46%; }
.whimtex-shape-corners-radial .whimtex-shape-corner-nw,
.whimtex-shape-corners-radial .whimtex-shape-corner-ne { top: 40px; }
.whimtex-shape-corners-radial .whimtex-shape-corner-sw,
.whimtex-shape-corners-radial .whimtex-shape-corner-se { bottom: 40px; }

.whimtex-linked-vector > .unity-base-field__input > .whimtex-vector-link {
    width: 22px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 3px 0 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.whimtex-vector-link > .whimtex-tool-icon {
    width: 18px;
    height: 18px;
}

.whimtex-shape-picker {
    position: absolute;
    width: 36px;
    padding: 2px;
    border-width: 1px;
    border-color: #202020;
    border-radius: 3px;
    background-color: var(--whimtex-surface);
    color: var(--whimtex-icon);
}

.whimtex-shape-picker--light {
    background-color: var(--whimtex-surface-light);
    color: var(--whimtex-neutral-33);
    border-color: #858585;
}

.whimtex-shape-picker-item {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
}

.whimtex-shape-picker-item--selected {
    background-color: var(--whimtex-hover-overlay);
}

.whimtex-shape-picker-item--hover {
    background-color: #2e619e;
    color: #eeeeee;
}
.whimtex-content-fill {
    padding: 8px;
}
.whimtex-content-fill-field {
    margin-bottom: 3px;
}
.whimtex-content-fill-message {
    white-space: normal;
    margin-top: 5px;
    margin-bottom: 7px;
}
.whimtex-content-fill-preview {
    flex-grow: 1;
    min-height: 140px;
    background-color: rgb(30, 30, 30);
    margin-top: 5px;
    margin-bottom: 5px;
}
.whimtex-content-fill-actions {
    flex-direction: row;
}
.whimtex-content-fill-actions > Button {
    flex-grow: 1;
}
.whimtex-soft-range > .unity-base-field__input {
    flex-direction: row;
}
.whimtex-soft-range-slider {
    flex-grow: 1;
    min-width: 0;
    margin-left: 0;
}
.whimtex-double2-input { flex-direction: row; }
.whimtex-double2-component { flex-grow: 1; flex-basis: 0; min-width: 0; }
.whimtex-double2-component > .unity-base-field__label { min-width: 12px; width: 12px; }
.whimtex-linked-output-actions {
    flex-direction: row;
    margin-left: 190px;
}
.whimtex-linked-output-actions > Button {
    flex-grow: 1;
}
.whimtex-linked-output-note {
    white-space: normal;
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 6px;
    color: rgb(170, 170, 170);
}

.whimtex-export-window { padding: 10px; }
.whimtex-export-body { flex-grow: 1; }
.whimtex-export-field { margin-bottom: 6px; }
.whimtex-export-field > .unity-base-field__label { min-width: 92px; width: 92px; }
.whimtex-export-description { white-space: normal; margin: 3px 3px 9px 3px; }
.whimtex-export-actions { flex-direction: row; justify-content: flex-end; margin-top: 8px; flex-shrink: 0; }
.whimtex-export-actions > Button { min-width: 84px; height: 24px; margin-left: 6px; }

.whimtex-text-content > .unity-base-text-field__input { min-height: 54px; white-space: normal; }
.whimtex-text-format-row { flex-direction: row; align-items: center; flex-shrink: 0; margin-top: 1px; margin-bottom: 1px; }
.whimtex-text-format-row > .unity-base-field__label { min-width: 0; flex-shrink: 1; text-overflow: ellipsis; overflow: hidden; }
.whimtex-text-format-row > .unity-base-field { flex-grow: 0; flex-shrink: 0; margin: 0; }
/* Native inputs rely on flex-grow to expand from zero width; these groups fit their buttons instead. */
.whimtex-text-format-row > .unity-base-field > .unity-base-field__input { width: auto; flex-grow: 0; flex-basis: auto; }
.whimtex-text-format-separator { width: 1px; height: 14px; margin: 0 5px; flex-shrink: 0; background-color: var(--whimtex-hover-overlay); }
.whimtex-text-size .unity-composite-field__field > .unity-base-field__label { width: auto; min-width: 0; flex-basis: auto; margin-right: 3px; }
.whimtex-text-spacing > .unity-base-field__input { flex-direction: column; background-color: transparent; }
.whimtex-text-spacing-row { flex-direction: row; flex-wrap: wrap; }
.whimtex-text-spacing-row > .unity-base-field { flex-grow: 1; flex-basis: 110px; min-width: 0; margin: 0 2px; }
.whimtex-text-spacing-row .unity-base-field__label { width: 64px; min-width: 64px; padding-right: 2px; }
.whimtex-text-spacing-row .unity-base-field__input { min-width: 32px; }
.whimtex-text-font-list { flex-grow: 1; }
.whimtex-system-font-field > .unity-base-field__input { background-color: transparent; min-width: 0; }
.unity-button.whimtex-system-font-button {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    height: 18px;
    margin: 0;
    padding: 0 4px;
}
.whimtex-system-font-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    font-size: 12px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.whimtex-system-font-arrow { flex-shrink: 0; width: 12px; margin: 0 0 0 4px; -unity-text-align: middle-center; }
.whimtex-system-font-option {
    font-size: 15px;
    padding: 0 6px;
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.whimtex-canvas-header-row .whimtex-text-tool-font > .unity-base-field__input { width: 160px; min-width: 160px; }
.whimtex-text-font-preview { height: 44px; font-size: 24px; -unity-text-align: middle-center; }
.whimtex-text-font-actions { flex-direction: row; justify-content: flex-end; }
.whimtex-stroke-style > .unity-base-field__input,
.whimtex-gradient-type > .unity-base-field__input,
.whimtex-text-alignment > .unity-base-field__input,
.whimtex-text-casing > .unity-base-field__input,
.whimtex-text-style > .unity-base-field__input {
    flex-direction: row;
    align-items: center;
    background-color: transparent;
}
.whimtex-gradient-type .unity-button.whimtex-tool-button {
    width: 24px;
    height: 24px;
    margin: 0 2px 0 0;
}
.whimtex-gradient-type .whimtex-tool-icon {
    width: 22px;
    height: 22px;
}
.whimtex-canvas-header-row .whimtex-gradient-type > .unity-base-field__input {
    width: auto;
    min-width: 0;
    height: 22px;
}
.whimtex-canvas-header-row .whimtex-gradient-type .unity-button.whimtex-tool-button {
    width: 24px;
    height: 22px;
    margin: 0 2px 0 0;
    padding: 0;
}
.whimtex-canvas-header-row .whimtex-text-alignment > .unity-base-field__input,
.whimtex-canvas-header-row .whimtex-text-casing > .unity-base-field__input,
.whimtex-canvas-header-row .whimtex-text-style > .unity-base-field__input {
    width: auto;
    min-width: 0;
    height: 22px;
}
.whimtex-text-alignment .unity-button.whimtex-icon-action,
.whimtex-text-casing .unity-button.whimtex-icon-action,
.whimtex-text-style .unity-button.whimtex-icon-action {
    flex-shrink: 0;
    margin: 0 2px;
    border-width: 1px;
    border-color: transparent;
}
.whimtex-text-alignment .unity-button.whimtex-text-format-button--selected,
.whimtex-text-casing .unity-button.whimtex-text-format-button--selected,
.whimtex-text-style .unity-button.whimtex-text-format-button--selected {
    border-color: #8d8d8d;
}
.whimtex-stroke-style .unity-button.whimtex-icon-action {
    height: 24px;
    width: 28px;
    flex-shrink: 0;
    margin: 0 2px;
    border-width: 1px;
    border-color: transparent;
}
.whimtex-stroke-style .unity-button.whimtex-stroke-style--selected {
    border-color: #8d8d8d;
    background-color: var(--whimtex-hover-overlay);
}
.whimtex-text-style-icon,
.whimtex-canvas-header-row .whimtex-text-style-icon {
    width: 16px;
    height: 16px;
    margin: 0;
    padding: 0;
    font-size: 14px;
    -unity-text-align: middle-center;
}
.whimtex-text-style-icon--bold,
.whimtex-canvas-header-row .whimtex-text-style-icon--bold { -unity-font-style: bold; }
.whimtex-text-style-icon--italic,
.whimtex-canvas-header-row .whimtex-text-style-icon--italic { -unity-font-style: italic; }
.whimtex-text-casing-icon { width: 20px; height: 16px; flex-direction: row; justify-content: center; align-items: flex-end; }
.whimtex-text-casing-icon > Label,
.whimtex-canvas-header-row .whimtex-text-casing-icon > Label {
    margin: 0; padding: 0; height: 16px; font-size: 12px;
    -unity-text-align: lower-center; -unity-font-style: normal;
}
.whimtex-text-casing-icon > .whimtex-text-casing-icon--small,
.whimtex-canvas-header-row .whimtex-text-casing-icon > .whimtex-text-casing-icon--small { font-size: 9px; }
.whimtex-canvas-text-input { position: absolute; margin: 0; padding: 0; }
.whimtex-canvas-text-input > .unity-base-text-field__input {
    margin: 0; padding: 0;
    border-width: 1px;
    border-color: rgb(80, 190, 235);
    background-color: rgb(35, 35, 35);
    color: rgb(238, 238, 238);
    white-space: normal;
}
.whimtex-canvas-text-input--manual > .unity-base-text-field__input { white-space: nowrap; }

.whimtex-layer-row--hide-opacity > .whimtex-layer-opacity,
.whimtex-layer-row--hide-blend > .whimtex-layer-blend {
    display: none;
}

.whimtex-comment-overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.whimtex-dashes { margin-top: 4px; flex-shrink: 0; }
.whimtex-dashes-header { flex-direction: row; align-items: center; }
.whimtex-dashes-label { width: 132px; min-width: 132px; margin-left: 0; flex-shrink: 0; }
.whimtex-dashes-header > Button { flex-grow: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.whimtex-dashes-gallery { padding: 3px; background-color: rgba(128, 128, 128, 0.12); }
.whimtex-dashes-preset { flex-direction: row; align-items: center; min-height: 25px; }
.whimtex-dashes-preset > Label { min-width: 0; flex-grow: 1; flex-shrink: 1; overflow: hidden; text-overflow: ellipsis; -unity-text-align: middle-left; }
.whimtex-dashes-preset--selected { border-color: #8d8d8d; background-color: var(--whimtex-hover-overlay); }
.whimtex-dashes-preview { height: 32px; margin: 3px 2px; overflow: hidden; flex-shrink: 0; background-color: rgba(128, 128, 128, 0.13); }
.whimtex-dashes-thumbnail { width: 100px; height: 20px; margin: 0 3px; background-color: transparent; }
.whimtex-dashes-pairs { max-height: 160px; flex-grow: 0; flex-shrink: 0; }
.whimtex-dashes-pair { flex-direction: row; align-items: center; flex-shrink: 0; }
.whimtex-dashes-pair > FloatField { flex-grow: 1; flex-basis: 0; min-width: 65px; }
.whimtex-dashes-pair > Button { width: 23px; min-width: 23px; flex-shrink: 0; margin-right: 0; }
.whimtex-dashes-hint { white-space: normal; font-size: 10px; opacity: 0.8; margin-bottom: 4px; }
.whimtex-dashes-error { white-space: normal; font-size: 10px; color: rgb(222, 126, 89); }
.whimtex-dashes-invalid > .unity-base-text-field__input { border-color: rgb(222, 126, 89); }

.whimtex-comment-pin {
    position: absolute; left: 0; top: 0; width: 26px; height: 26px;
    margin: 0; padding: 0; color: white;
}
.whimtex-comment-pin-number {
    position: absolute; left: 1px; top: 0; width: 24px; height: 20px; margin: 0; padding: 0;
    -unity-text-align: middle-center; -unity-font-style: bold; font-size: 10px;
}
.whimtex-comment-card {
    position: absolute; width: 296px; padding: 8px 0 0; border-width: 1px;
    border-color: rgb(89, 89, 89); border-radius: 4px; background-color: rgb(44, 44, 44);
    color: rgb(220, 220, 220); overflow: hidden;
}
.whimtex-comment-card--light { background-color: rgb(224, 224, 224); border-color: rgb(145, 145, 145); color: rgb(35, 35, 35); }
.whimtex-comment-heading { flex-direction: row; align-items: center; flex-shrink: 0; }
.whimtex-comment-heading > Label { flex-grow: 1; min-width: 0; }
.whimtex-comment-heading > Button { flex-shrink: 0; }
.whimtex-comment-card--focused {
    border-color: rgb(112, 112, 112);
}

.whimtex-comment-card-header {
    min-height: 27px; margin: -7px 1px 3px; padding: 3px 6px;
    background-color: rgba(128, 128, 128, 0.12); border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3); cursor: move-arrow;
}
.whimtex-comment-card-header > Label { -unity-font-style: bold; font-size: 11px; overflow: hidden; text-overflow: ellipsis; cursor: move-arrow; }
.whimtex-comment-card-header > Button { width: 20px; min-width: 0; margin: 0 1px; padding: 1px; }
.whimtex-comment-header-icon { width: 16px; height: 16px; flex-shrink: 0; }
.whimtex-comment-card-header > Button, .whimtex-comment-card-header .whimtex-comment-color { cursor: arrow; }
.whimtex-comment-connector { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.whimtex-comment-resize { position: absolute; }
.whimtex-comment-resize-h { cursor: resize-horizontal; }
.whimtex-comment-resize-v { cursor: resize-vertical; }
.whimtex-comment-resize-nw { cursor: resize-up-left; }
.whimtex-comment-resize-ne { cursor: resize-up-right; }
.whimtex-comment-color { width: 24px; min-width: 0; height: 20px; flex-shrink: 0; margin: 0 1px; padding: 0; }
.whimtex-comment-messages { min-height: 0; max-height: 248px; flex-shrink: 1; }
.whimtex-comment-messages-content { padding: 0 8px 8px; }
.whimtex-comment-card--sized .whimtex-comment-messages { max-height: none; flex-grow: 1; flex-basis: 0; }
.whimtex-comment-message-editor { flex-grow: 0; flex-shrink: 0; margin-top: 5px; }
.unity-button.whimtex-comment-reply {
    --reply-background: rgba(77, 77, 77, 0.75); --reply-hover: rgba(99, 99, 99, 0.75);
    --reply-active: rgba(36, 84, 140, 0.85);
    position: absolute; right: 0; bottom: 0; width: 28px; height: 24px;
    margin: 0; padding: 0; border-width: 0; border-radius: 4px 0 0 0;
    background-color: var(--reply-background); background-image: none;
    color: var(--whimtex-icon); font-size: 16px; -unity-text-align: middle-center;
}
.whimtex-comment-card--light .whimtex-comment-reply {
    --reply-background: rgba(203, 203, 203, 0.75); --reply-hover: rgba(221, 221, 221, 0.75);
    --reply-active: rgba(4, 52, 109, 0.85);
    color: var(--whimtex-neutral-33);
}
.unity-button.whimtex-comment-reply:hover { background-color: var(--reply-hover); }
.unity-button.whimtex-comment-reply:active { background-color: var(--reply-active); color: #eeeeee; }
.whimtex-comment-message { padding-top: 5px; padding-bottom: 6px; border-bottom-width: 1px; border-bottom-color: rgba(128, 128, 128, 0.3); }
.whimtex-comment-card--single-message .whimtex-comment-message { border-bottom-width: 0; }
.whimtex-comment-message--day-end { border-bottom-width: 0; }
.whimtex-comment-day { flex-direction: row; align-items: center; height: 16px; flex-shrink: 0; margin: 8px 2px 4px; }
.whimtex-comment-day > Label { font-size: 10px; -unity-font-style: normal; opacity: 0.65; margin: 0 8px; flex-shrink: 0; }
.whimtex-comment-day-line { height: 1px; flex-grow: 1; background-color: rgba(128, 128, 128, 0.3); }
.whimtex-comment-author { border-left-width: 5px; padding-left: 4px; margin-right: 4px; flex-grow: 1; flex-shrink: 1; min-width: 0; }
.whimtex-comment-author > Label { font-size: 11px; -unity-font-style: bold; white-space: normal; }
.whimtex-comment-time { font-size: 10px; opacity: 0.65; white-space: normal; margin-left: 9px; margin-top: 2px; }
.whimtex-comment-time { flex-shrink: 1; min-width: 0; }
.whimtex-comment-body { white-space: normal; margin: 5px 2px 3px; }
.unity-toolbar-menu.whimtex-comment-message-menu { height: auto; min-height: 16px; align-self: stretch; }
.whimtex-comment-message-menu > .unity-toolbar-menu__text,
.whimtex-comment-message-menu > .unity-toolbar-menu__arrow { display: none; }
.whimtex-comment-input { min-height: 64px; max-height: 128px; margin-top: 0; flex-grow: 0; flex-shrink: 0; }
.whimtex-comment-input > .unity-base-text-field__input { white-space: normal; }
.whimtex-comment-actions { flex-direction: row; justify-content: flex-end; margin: 6px 2px 0; flex-shrink: 0; }
.whimtex-comment-actions > Button { min-width: 56px; flex-shrink: 0; margin: 0 0 0 4px; padding: 0 8px; }
.unity-button.whimtex-comment-delete:hover {
    color: #e88b90; background-color: rgba(232, 109, 115, 0.1); border-color: rgba(232, 109, 115, 0.3);
}
.unity-button.whimtex-comment-delete:active {
    color: #f4b4b8; background-color: rgba(232, 109, 115, 0.22); border-color: #c46b72;
}
.whimtex-comment-card--light .whimtex-comment-delete:hover { color: #ad4048; }
.whimtex-comment-confirmation { padding: 12px; }
.whimtex-comment-confirmation-message { white-space: normal; flex-grow: 1; margin: 0; }
.whimtex-comment-confirmation-actions { flex-direction: row; justify-content: flex-end; flex-shrink: 0; margin-top: 12px; }
.whimtex-comment-confirmation-actions > Button { width: 80px; height: 24px; margin: 0 0 0 6px; }
.whimtex-comment-attachment-editor { max-height: 138px; flex-grow: 0; flex-shrink: 0; }
.whimtex-comment-attachments { margin-top: 3px; padding-bottom: 2px; }
.whimtex-comment-attachment-row { flex-direction: row; align-items: center; margin-top: 2px; flex-shrink: 0; }
.unity-button.whimtex-comment-attachment-field {
    height: 20px; min-width: 0; flex-grow: 1; margin: 0; padding: 0 3px;
    flex-direction: row; align-items: center; border-radius: 2px;
    background-color: rgba(0, 0, 0, 0.18); border-width: 1px; border-color: rgba(0, 0, 0, 0.45);
}
.whimtex-comment-attachment-icon { width: 14px; height: 14px; margin-right: 3px; flex-shrink: 0; }
.whimtex-comment-mask-row .whimtex-comment-attachment-field { height: 32px; }
.whimtex-comment-mask-thumbnail { width: 28px; height: 28px; margin-right: 4px; flex-shrink: 0; background-color: #171717; }
.whimtex-comment-attachment-actions { flex-direction: row; justify-content: flex-end; margin-top: 3px; }
.whimtex-comment-attachment-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.whimtex-comment-attachment--missing { opacity: 0.65; }
.whimtex-comment-attachment-add { align-self: flex-end; width: 25px; margin-top: 3px; }
.whimtex-comment-attachment-drop-highlight {
    position: absolute; left: -1px; top: -1px; right: -1px; bottom: -1px;
    border-width: 1px; border-color: #339eff; border-radius: 2px;
    background-color: rgba(51, 158, 255, 0.08);
}
.whimtex-layer-ping {
    position: absolute;
    background-color: rgba(215, 207, 117, 0.055);
    border-width: 2px; border-color: rgb(190, 183, 105); border-radius: 5px;
}
.whimtex-comments-drawer { max-height: 100%; }
.whimtex-comment-list-filters { flex-direction: row; align-items: center; margin: 5px 4px 2px; flex-shrink: 0; }
.whimtex-comment-query-options { margin: 2px 4px 4px; flex-shrink: 0; }
.whimtex-comment-query-error { white-space: normal; font-size: 10px; color: rgb(232, 150, 115); }
.whimtex-comment-cluster-choice { height: 44px; margin: 2px 4px; padding-left: 6px; border-left-width: 4px; align-items: flex-start; }
.whimtex-comment-cluster-preview { max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; opacity: 0.75; }
.whimtex-comment-text-link { align-self: flex-start; margin: 2px 0; }
.whimtex-comments-header { flex-direction: row; align-items: center; padding-right: 4px; }
.whimtex-comments-header > Label { flex-grow: 1; min-width: 0; margin: 0; overflow: hidden; text-overflow: ellipsis; }
.whimtex-comments-header > Button { flex-shrink: 0; margin: 0; }
.whimtex-comment-filter { width: 65px; min-width: 65px; flex-shrink: 0; margin: 0 4px 0 0; }
.whimtex-comment-status { width: 36px; min-width: 36px; flex-shrink: 0; margin: 0 4px 0 0; }
.whimtex-comment-status-icon { width: 14px; height: 14px; flex-shrink: 0; }
.whimtex-comment-choice {
    --comment-choice-background: #454545;
    --comment-choice-border: #292929;
    --comment-choice-hover: #535353;
    --comment-choice-pressed: #383838;
    height: 20px; min-height: 20px; cursor: arrow; color: var(--whimtex-icon);
}
.whimtex-comment-choice--light {
    --comment-choice-background: #c8c8c8;
    --comment-choice-border: #969696;
    --comment-choice-hover: #d5d5d5;
    --comment-choice-pressed: #b6b6b6;
    color: var(--whimtex-neutral-33);
}
.whimtex-comment-card-header > .whimtex-comment-choice {
    --comment-choice-background: transparent;
    --comment-choice-border: transparent;
    --comment-choice-hover: var(--whimtex-hover-overlay);
    --comment-choice-pressed: #254e7e;
}
.whimtex-comment-card-header > .whimtex-comment-choice--open { color: #eeeeee; }
.whimtex-comment-choice > .whimtex-comment-choice-input {
    min-width: 0; min-height: 0; margin: 0; padding: 0 4px;
    flex-direction: row; align-items: center; justify-content: space-between;
    background-image: none; background-color: var(--comment-choice-background);
    border-width: 1px; border-color: var(--comment-choice-border); border-radius: 3px;
}
.whimtex-comment-choice:hover > .whimtex-comment-choice-input { background-color: var(--comment-choice-hover); }
.whimtex-comment-choice:focus > .whimtex-comment-choice-input { border-color: #5688b8; }
.whimtex-comment-choice--open > .whimtex-comment-choice-input {
    background-color: var(--comment-choice-pressed); border-color: #5688b8;
}
.whimtex-comment-choice-label { flex-grow: 1; min-width: 0; margin: 0; padding: 0; -unity-text-align: middle-left; }
.whimtex-comment-choice-arrow { width: 8px; height: 14px; flex-shrink: 0; opacity: 0.75; }
.whimtex-comment-choice-overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.whimtex-comment-status-options {
    position: absolute; padding: 2px 0;
    background-color: #383838; border-width: 1px; border-color: #202020; border-radius: 2px;
    color: var(--whimtex-icon);
}
.whimtex-comment-status-options--light { background-color: #c8c8c8; border-color: #969696; color: var(--whimtex-neutral-33); }
.unity-button.whimtex-comment-status-option {
    height: 22px; flex-shrink: 0; margin: 0; padding: 0 6px;
    align-items: center; justify-content: center;
    background-image: none; background-color: transparent; color: var(--whimtex-icon);
    border-width: 0; border-radius: 0;
}
.whimtex-comment-status-options--light > .whimtex-comment-status-option { color: var(--whimtex-neutral-33); }
.unity-button.whimtex-comment-status-option--selected { background-color: rgba(128, 128, 128, 0.2); }
.unity-button.whimtex-comment-status-option:hover,
.unity-button.whimtex-comment-status-option:focus,
.unity-button.whimtex-comment-status-option:active,
.unity-button.whimtex-comment-status-option--hover {
    background-color: #2c5d87; color: #eeeeee;
}
.whimtex-comment-list-filters ToolbarSearchField { min-width: 40px; flex-grow: 1; flex-shrink: 1; }
.whimtex-comments-list { flex-grow: 0; flex-shrink: 1; min-height: 0; margin: 4px 0 0; padding: 0; }
.whimtex-comments-empty { margin: 8px; white-space: normal; }
.unity-button.whimtex-comment-list-row {
    height: 76px; margin: 0; padding: 0;
    flex-direction: column; align-items: stretch; justify-content: flex-start;
    border-width: 0; border-left-width: 5px; border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3); border-radius: 0;
    background-color: rgba(0, 0, 0, 0.12);
}
.unity-button.whimtex-comment-list-row:hover { background-color: var(--whimtex-hover-overlay); }
.unity-button.whimtex-comment-list-row--selected { background-color: rgba(128, 128, 128, 0.4); }
.whimtex-comment-list-heading {
    height: 19px; margin: 0; padding: 0 7px 0 23px; font-size: 10px; flex-shrink: 0;
    background-color: rgba(255, 255, 255, 0.055);
    border-width: 1px; border-color: rgba(0, 0, 0, 0.18);
    -unity-text-align: middle-left;
}
.whimtex-comment-list-preview { margin: 0; padding: 5px 7px 0; min-height: 0; white-space: normal; overflow: hidden; -unity-text-align: upper-left; }
