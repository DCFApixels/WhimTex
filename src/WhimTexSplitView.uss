}

.whimtex-layers-footer > .whimtex-layer-action.whimtex-layer-action--drop-target {
    background-color: #3b6997;
}

.whimtex-layer-action-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.whimtex-layer-action:disabled > .whimtex-layer-action-icon {
    opacity: 0.35;
