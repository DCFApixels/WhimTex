.whimtex-theme {
    --whimtex-surface: #383838;
    --whimtex-surface-light: #c4c4c4;
    --whimtex-header: #454545;
    --whimtex-header-light: #d0d0d0;
    --whimtex-icon: #d2d2d2;
    --whimtex-neutral-33: #333333;
    --whimtex-hover-overlay: rgba(128, 128, 128, 0.25);
}

.unity-button.whimtex-layer-menu-button,
.unity-toolbar-menu.whimtex-comment-message-menu,
.unity-toolbar-menu.whimtex-inspector-section-menu,
.whimtex-group-foldout {
    --menu-hover: rgba(255, 255, 255, 0.12);
    --menu-pressed: rgba(255, 255, 255, 0.2);
    --menu-dot: var(--whimtex-icon);
    flex-direction: column;
    width: 14px;
    min-width: 0;
    height: 22px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
    padding: 0;
    border-width: 0;
    border-radius: 2px;
    background-image: none;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.unity-button.whimtex-layer-menu-button--light,
.whimtex-comment-card--light .whimtex-comment-message-menu,
.whimtex-inspector-section--light .whimtex-inspector-section-menu,
.whimtex-group-foldout.whimtex-layer-menu-button--light {
    --menu-hover: rgba(0, 0, 0, 0.1);
    --menu-pressed: rgba(0, 0, 0, 0.18);
    --menu-dot: var(--whimtex-neutral-33);
}

.unity-button.whimtex-layer-menu-button:hover,
.unity-toolbar-menu.whimtex-comment-message-menu:hover,
.whimtex-inspector-section-menu:hover > .whimtex-inspector-section-menu-visual,
.whimtex-group-foldout:hover {
    background-color: var(--menu-hover);
}

.unity-button.whimtex-layer-menu-button:active,
.unity-toolbar-menu.whimtex-comment-message-menu:active,
.whimtex-inspector-section-menu:active > .whimtex-inspector-section-menu-visual,
.whimtex-group-foldout:active {
    background-color: var(--menu-pressed);
}

.whimtex-group-foldout,
.whimtex-layer-thumbnail {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin: 0 3px 0 0;
}

.whimtex-group-foldout > .unity-label {
    margin: 0;
    font-size: 10px;
}

.whimtex-layer-thumbnail {
    background-color: #474747;
}

.whimtex-layer-thumbnail__image {
    width: 100%;
    height: 100%;
    margin: 0;
    background-color: transparent;
}

.whimtex-layer-empty-icon {
    position: absolute;
    left: 1px;
    top: 1px;
}

.whimtex-document-reference-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(224, 143, 70, 0.7);
}

.whimtex-layer-table-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 24px;
    padding: 0 3px;
    background-color: var(--whimtex-header);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
}

.whimtex-settings-pane--light .whimtex-layer-table-header {
    background-color: var(--whimtex-header-light);
}

.whimtex-layer-name-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    margin: 0;
}

.whimtex-layer-name-cell > .whimtex-layer-name {
    min-width: 0;
    margin: 0 2px 0 0;
}

.whimtex-layer-name-cell > .whimtex-layer-name,
.whimtex-layer-row > .whimtex-layer-opacity,
.whimtex-layer-row > .whimtex-layer-blend {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
}

.whimtex-layer-opacity,
.whimtex-layer-blend {
    flex-shrink: 0;
    min-width: 0;
    margin: 0 2px;
}

.whimtex-layer-opacity {
    width: 48px;
}

.whimtex-layer-blend {
    width: 126px;
}

.whimtex-layer-opacity > .unity-base-field__input,
.whimtex-layer-blend > .unity-base-field__input {
    min-width: 0;
}

.whimtex-layer-table-header > .whimtex-layer-opacity {
    align-items: center;
    justify-content: center;
}

.whimtex-layer-table-header > .unity-button.whimtex-layer-enabled,
.whimtex-layer-table-header > .whimtex-layer-name-cell,
.whimtex-layer-table-header > .whimtex-layer-opacity {
    align-self: stretch;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.4);
}

.whimtex-layer-table-header > .whimtex-layer-name-cell {
    padding-left: 7px;
    padding-right: 3px;
    -unity-text-align: middle-left;
}

.whimtex-layer-table-header > .whimtex-layer-blend {
    padding-left: 3px;
    padding-right: 3px;
    -unity-text-align: middle-left;
}

.whimtex-layer-table-header .whimtex-layer-action-icon {
    opacity: 0.5;
}

.whimtex-layer-table-header > .whimtex-layer-opacity > .whimtex-layer-action-icon {
    opacity: 0.65;
}

.whimtex-layer-menu-space {
    width: 14px;
    flex-shrink: 0;
    margin-left: 2px;
}

.whimtex-layer-drop-marker {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-color: #339eff;
}

.whimtex-layer-drop-endpoint {
    position: absolute;
    left: -3px;
    width: 5px;
    height: 5px;
    background-color: #339eff;
    border-radius: 3px;
}

.whimtex-layer-row--drop-inside > .whimtex-layer-drop-marker {
    display: flex;
    border-width: 1px;
    background-color: rgba(51, 158, 255, 0.15);
}

.whimtex-layer-row--drop-before > .whimtex-layer-drop-marker {
    display: flex;
    border-top-width: 2px;
}

.whimtex-layer-row--drop-after > .whimtex-layer-drop-marker {
    display: flex;
    border-bottom-width: 2px;
}

.whimtex-layer-row--drop-fx > .whimtex-layer-drop-marker {
    display: flex;
    border-width: 1px;
    background-color: rgba(51, 158, 255, 0.15);
}

.whimtex-layer-menu-dot {
    width: 2px;
    height: 2px;
    flex-shrink: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 1px;
    background-color: var(--menu-dot);
}

.whimtex-canvas-toolbar {
    flex-shrink: 0;
    background-color: var(--whimtex-surface);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.whimtex-canvas-header-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    min-height: 27px;
    flex-shrink: 0;
    padding: 0 4px;
    font-size: 12px;
    -unity-font-style: normal;
}

.whimtex-canvas-header-row > *,
.whimtex-canvas-header-row .unity-base-field {
    flex-grow: 0;
    flex-shrink: 0;
    flex-basis: auto;
    width: auto;
    min-width: 0;
    height: 22px;
    min-height: 0;
    margin: 2px;
    padding-top: 0;
    padding-bottom: 0;
    align-items: center;
}

.whimtex-canvas-header-row Label {
    font-size: 12px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
}

.whimtex-canvas-header-row .unity-base-field__label {
    width: auto;
    min-width: 0;
    max-width: none;
    height: 22px;
    align-self: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0 4px 0 0;
    padding: 0;
    white-space: nowrap;
}

.whimtex-canvas-header-row .unity-base-field > .unity-base-field__input {
    width: 54px;
    min-width: 54px;
    flex-basis: auto;
    height: 18px;
    min-height: 0;
    flex-grow: 0;
    flex-shrink: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.whimtex-canvas-header-row .unity-base-popup-field > .unity-base-field__input,
.whimtex-canvas-header-row .unity-enum-field > .unity-base-field__input {
    width: 100px;
    min-width: 0;
    flex-grow: 0;
}

.whimtex-canvas-header-row .whimtex-header-dropdown-fixed > .unity-base-field__input,
.whimtex-canvas-header-row .whimtex-canvas-filter > .unity-base-field__input,
.whimtex-canvas-header-row .whimtex-canvas-precision > .unity-base-field__input,
.whimtex-canvas-header-row .whimtex-shape-kind > .unity-base-field__input,
.whimtex-canvas-header-row .whimtex-area-mode > .unity-base-field__input {
    width: auto;
    flex-grow: 1;
}

.whimtex-canvas-header-row .unity-toggle > .unity-base-field__input,
.whimtex-canvas-header-row .unity-base-slider > .unity-base-field__input {
    width: auto;
    min-width: 0;
}

.whimtex-canvas-header-row .unity-base-slider__drag-container {
    width: 80px;
    min-width: 80px;
    flex-grow: 1;
    flex-shrink: 0;
    margin: 0 4px;
}

.whimtex-canvas-header-row .unity-base-slider__text-field {
    width: 54px;
    min-width: 54px;
    margin: 0;
}

.whimtex-canvas-header-row--compact .unity-base-slider__drag-container {
    display: none;
}

.whimtex-canvas-header-row .unity-button,
.whimtex-canvas-header-row .unity-button.whimtex-channel-button {
    width: auto;
    min-width: 0;
    flex-grow: 0;
    flex-shrink: 0;
    margin: 2px;
    padding: 0 6px;
    font-size: 12px;
    -unity-font-style: normal;
    -unity-text-align: middle-center;
}

.whimtex-canvas-header-row .whimtex-header-input--swatch > .unity-base-field__input { width: 54px; }
.whimtex-canvas-header-row .whimtex-header-dropdown--72 { width: 72px; }
.whimtex-canvas-header-row .whimtex-header-dropdown--78 { width: 78px; }
.whimtex-canvas-header-row .whimtex-header-dropdown--90 { width: 90px; }
.whimtex-canvas-header-row .whimtex-header-dropdown--118 { width: 118px; }
.whimtex-canvas-header-row .whimtex-header-dropdown--150 { width: 150px; }
.whimtex-canvas-header-row .whimtex-header-dropdown-input--94,
.whimtex-canvas-header-row .whimtex-header-dropdown-input--100 { width: auto; }
.whimtex-canvas-header-row .whimtex-header-dropdown-input--94 > .unity-base-field__input { width: 94px; flex-grow: 0; }
.whimtex-canvas-header-row .whimtex-header-dropdown-input--100 > .unity-base-field__input { width: 100px; flex-grow: 0; }
.whimtex-canvas-header-row .whimtex-canvas-filter { width: 142px; }
.whimtex-canvas-header-row .whimtex-canvas-precision { width: 158px; }
.whimtex-canvas-header-row .whimtex-shape-kind { width: 112px; }
.whimtex-canvas-header-row .whimtex-area-mode { width: 86px; }

.whimtex-canvas-header-row .whimtex-gradient-test-field {
    height: 18px;
    flex-grow: 1;
    margin: 0;
    padding: 0;
}

.whimtex-canvas-header-row .whimtex-gradient-tool-ramp > .unity-base-field__input {
    width: 160px;
    min-width: 160px;
}

.whimtex-canvas-toolbar--light { background-color: var(--whimtex-surface-light); }

.whimtex-canvas-shadow {
    position: absolute;
}

.whimtex-tiled-image {
    position: absolute;
    display: none;
}

.whimtex-canvas-view-image--visible {
    display: flex;
}

.whimtex-canvas--empty > .whimtex-canvas-surface {
    display: none;
}

.whimtex-canvas-view-backdrop--hidden,
.whimtex-canvas-shadow--hidden,
.whimtex-post-fx-field--hidden,
.whimtex-canvas-view-image--hidden {
    display: none;
}

.whimtex-workspace {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.whimtex-tools-scroll {
    width: 36px;
    min-height: 0;
    flex-shrink: 0;
    background-color: var(--whimtex-surface);
    border-right-width: 1px;
    border-right-color: #171717;
}

.whimtex-tools-scroll--light {
    background-color: var(--whimtex-surface-light);
    border-right-color: #858585;
}

.whimtex-tools {
    width: 35px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 4px;
    background-color: var(--whimtex-surface);
}

.whimtex-workspace-split {
    flex-basis: 0;
    min-width: 0;
}

.whimtex-tools--light {
    background-color: var(--whimtex-surface-light);
}

.unity-button.whimtex-tool-button,
.whimtex-comment-card-header > Button {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin: 0 0 3px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 3px;
    color: var(--whimtex-icon);
    --whimtex-tool-icon-tint: var(--whimtex-icon);
}

.whimtex-tools--light > .unity-button.whimtex-tool-button,
.whimtex-comment-card--light .whimtex-comment-card-header > Button {
    color: var(--whimtex-neutral-33);
    --whimtex-tool-icon-tint: var(--whimtex-neutral-33);
}

.unity-button.whimtex-tool-button:hover,
.whimtex-comment-card-header > Button:hover {
    background-color: var(--whimtex-hover-overlay);
}

.unity-button.whimtex-tool-button--selected,
.unity-button.whimtex-tool-button--selected:hover {
    background-color: #2e619e;
    border-color: #578ac0;
}

.whimtex-tools > .unity-button.whimtex-tool-button--selected,
.whimtex-canvas-view-drawer-tabs > .unity-button.whimtex-tool-button--selected {
    color: #eeeeee;
    --whimtex-tool-icon-tint: #eeeeee;
}

.unity-button.whimtex-tool-button:active,
.whimtex-comment-card-header > Button:active {
    background-color: #254e7e;
}

.unity-button.whimtex-tool-button:focus,
.whimtex-comment-card-header > Button:focus {
    border-color: #578ac0;
}

.unity-button.whimtex-tool-button:disabled,
.whimtex-comment-card-header > Button:disabled {
    opacity: 0.4;
}

.whimtex-tool-button--unavailable > .whimtex-tool-icon {
    opacity: 0.4;
}

.whimtex-tool-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

.whimtex-tool-icon--quick-selection {
    overflow: hidden;
    translate: 0 -2px;
}

.whimtex-tool-icon--quick-selection > .whimtex-tool-icon {
    position: absolute;
    left: 29.166667%;
    top: -2.5%;
    translate: 0 1px;
    width: 100%;
    height: 100%;
}

.whimtex-tool-vector-image {
    --unity-image-tint-color: var(--whimtex-tool-icon-tint);
    position: absolute;
    left: 4.545455%;
    top: 4.545455%;
    width: 90.90909%;
    height: 90.90909%;
}

.whimtex-tool-vector-image--pencil {
    left: -4.545455%;
    top: -4.545455%;
    width: 109.09091%;
    height: 109.09091%;
}

.whimtex-tool-dropdown-marker {
    position: absolute;
    right: 1px;
    bottom: 1px;
    width: 4px;
    height: 4px;
    opacity: 0.65;
}

.whimtex-tool-options--hidden {
    display: none;
}

.whimtex-tool-settings-space {
    height: 28px;
    flex-shrink: 0;
}

.whimtex-tool-settings-panel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    min-height: 28px;
    background-color: rgb(41, 41, 41);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.whimtex-tool-settings-panel--light {
    background-color: rgb(199, 199, 199);
}

.whimtex-healing-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.whimtex-context-tool--hidden {
    display: none;
}

.whimtex-context-tool-separator {
    width: 24px;
    height: 1px;
    flex-shrink: 0;
    margin-top: 3px;
    margin-bottom: 6px;
    background-color: #171717;
}

.whimtex-tools--light > .whimtex-context-tool-separator {
    background-color: #858585;
}

.whimtex-canvas.whimtex-canvas-cursor--pan {
    cursor: pan;
}

.whimtex-canvas.whimtex-canvas-cursor--zoom {
    cursor: zoom;
}

.whimtex-canvas.whimtex-canvas-cursor--scale {
    cursor: scale-arrow;
}

.whimtex-canvas.whimtex-canvas-cursor--rotate {
    cursor: rotate-arrow;
}

.whimtex-canvas.whimtex-canvas-cursor--move {
    cursor: move-arrow;
}

.whimtex-canvas.whimtex-canvas-cursor--add {
    cursor: arrow-plus;
}

.whimtex-canvas {
    cursor: arrow;
    overflow: hidden;
}

.whimtex-canvas-view-backdrop {
    position: absolute;
    opacity: 0.035;
}

.whimtex-canvas-view-inset-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.whimtex-canvas-view-workspace,
.whimtex-canvas-view-viewport {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.whimtex-canvas-view-workspace {
    flex-direction: row;
}

.whimtex-post-fx-overlay {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 36px;
    align-items: flex-end;
}

.whimtex-post-fx-panel {
    flex-direction: row;
    flex-shrink: 1;
    min-height: 0;
    max-width: 100%;
}

.whimtex-tools.whimtex-canvas-view-drawer-tabs {
    flex-shrink: 0;
    width: 36px;
    border-left-width: 1px;
    border-left-color: #171717;
}

.whimtex-tools--light.whimtex-canvas-view-drawer-tabs {
    border-left-color: #858585;
}

.whimtex-canvas-drawer-content {
    flex-shrink: 1;
    min-height: 0;
}

.whimtex-canvas-drawer-header {
    flex-direction: row;
    align-items: center;
}

.whimtex-canvas-drawer-title {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
}

.whimtex-canvas-drawer-toggle {
    flex-shrink: 0;
    margin: 0;
}

.unity-button.whimtex-canvas-drawer-activate {
    flex-shrink: 0;
    margin: 0 0 0 6px;
    height: 18px;
    min-height: 18px;
}

.whimtex-brush-spacing-info {
    font-size: 10px;
    opacity: 0.65;
    margin-bottom: 6px;
}

.whimtex-brush-section-header {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.15);
    margin: 6px 0 4px 0;
    padding: 2px 2px 2px 6px;
    flex-shrink: 0;
}

.whimtex-brush-section-title {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    -unity-font-style: bold;
}

.whimtex-brush-section-reset,
.whimtex-fx-parameter-action {
    width: 20px;
    height: 18px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

.whimtex-brush-tint-row {
    flex-direction: row;
    align-items: center;
}

.whimtex-brush-tint-row > .whimtex-brush-tint-gradient {
    flex-grow: 1;
    min-width: 0;
}

.whimtex-brush-tint-row > .whimtex-brush-tint-reset {
    width: 20px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 2px 0 2px;
    padding: 0;
}

.whimtex-canvas-header-row .whimtex-brush-edge {
    flex-direction: row;
    align-items: center;
}

.whimtex-canvas-header-row .unity-button.whimtex-brush-edge-mode {
    border-width: 0;
    background-color: transparent;
}

.unity-button.whimtex-brush-edge-mode:hover {
    background-color: var(--whimtex-hover-overlay);
}

.whimtex-post-fx-drawer {
    width: 300px;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--whimtex-surface);
    border-width: 1px;
    border-color: #191919;
    border-radius: 3px;
    overflow: hidden;
}

.whimtex-post-fx-panel > .whimtex-post-fx-drawer {
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
}

.whimtex-brush-stroke-preview {
    height: 96px;
    flex-shrink: 0;
    margin: 0 6px 6px 6px;
    border-width: 1px;
    border-color: #252525;
    border-radius: 3px;
    background-color: #292929;
    overflow: hidden;
}

.whimtex-brush-preset-row {
    flex-direction: row;
    flex-shrink: 0;
    margin: 4px 4px 0 4px;
}

.whimtex-brush-preset-picker {
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-brush-preset-save {
    flex-shrink: 0;
}

.whimtex-brush-preview-scale {
    flex-shrink: 0;
    margin: 0 6px 6px 6px;
}

.whimtex-brush-preview-scale > .unity-base-field__label {
    min-width: 110px;
    width: 110px;
}

.whimtex-post-fx-settings {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    min-height: 0;
    padding: 6px;
}

.whimtex-post-fx-overlay--hidden,
.whimtex-post-fx-drawer--hidden {
    display: none;
}

.whimtex-post-fx-settings .unity-base-field__label {
    min-width: 100px;
    width: 100px;
}

.unity-button.whimtex-channel-button.whimtex-guides-button {
    width: 52px;
    min-width: 52px;
}

.unity-button.whimtex-channel-button.whimtex-tiled-button {
    width: auto;
    min-width: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.unity-button.whimtex-channel-button.whimtex-live-output-button {
    align-items: center;
    justify-content: center;
}

.whimtex-live-output-indicator {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #89898b;
    border-radius: 6px;
}

.whimtex-live-output-disc {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 4px;
    background-color: #89898b;
}

.whimtex-live-output-button.whimtex-channel-button--enabled > .whimtex-live-output-indicator {
    border-color: #dedee0;
}

.whimtex-live-output-button.whimtex-channel-button--enabled .whimtex-live-output-disc {
    background-color: #f07860;
}

.whimtex-guides-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.whimtex-canvas-navigation {
    --whimtex-canvas-navigation-size: 16px;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    background-color: #303030;
    color: #bcbcbc;
}

.whimtex-canvas-header-row > .whimtex-transform-actions {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    align-items: center;
    max-width: 100%;
    height: auto;
    margin: 0;
}

.whimtex-transform-action-group {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    max-width: 100%;
    align-items: center;
}

.unity-button.whimtex-icon-action,
.whimtex-canvas-header-row .unity-button.whimtex-icon-action {
    width: 24px;
    padding: 0;
    border-width: 0;
    border-radius: 2px;
    background-image: none;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.unity-button.whimtex-icon-action:hover {
    background-color: var(--whimtex-hover-overlay);
}

.unity-button.whimtex-icon-action:disabled {
    background-color: transparent;
}

.whimtex-icon-action > .whimtex-layer-action-icon {
    scale: 1.25 1.25;
}

.whimtex-transform-action .whimtex-transform-action-ratio {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.whimtex-icon-action:disabled > .whimtex-layer-action-icon {
    opacity: 0.35;
}

.whimtex-canvas-navigation--light {
    background-color: #c7c7c7;
    color: #454545;
}

.whimtex-canvas-navigation-row {
    flex-direction: row;
    flex-shrink: 0;
    min-width: 0;
}

.whimtex-canvas-navigation-body {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.whimtex-canvas-navigation-corner {
    width: var(--whimtex-canvas-navigation-size);
    height: var(--whimtex-canvas-navigation-size);
    flex-shrink: 0;
}

.whimtex-canvas-ruler {
    --whimtex-canvas-ruler-label-height: 12px;
    overflow: hidden;
    flex-shrink: 0;
    cursor: arrow;
}

.whimtex-canvas-ruler--horizontal,
.whimtex-canvas-scrollbar--horizontal {
    height: var(--whimtex-canvas-navigation-size);
    flex-grow: 1;
    min-width: 0;
}

.whimtex-canvas-ruler--vertical,
.whimtex-canvas-scrollbar--vertical {
    width: var(--whimtex-canvas-navigation-size);
    min-height: 0;
}

.whimtex-canvas-ruler-label {
    position: absolute;
    height: var(--whimtex-canvas-ruler-label-height);
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-text-align: middle-left;
    overflow: hidden;
}

.whimtex-canvas-ruler-label--vertical {
    left: var(--whimtex-canvas-ruler-label-height);
    transform-origin: 0 0;
    rotate: 90deg;
}

.whimtex-canvas-scrollbar {
    flex-shrink: 0;
    overflow: hidden;
    cursor: arrow;
}

.whimtex-canvas-scrollbar--horizontal {
    flex-direction: row;
}

.whimtex-canvas-scrollbar-track {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.whimtex-canvas-scrollbar-arrow {
    width: var(--whimtex-canvas-navigation-size);
    height: var(--whimtex-canvas-navigation-size);
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-image: none;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.whimtex-canvas-scrollbar-arrow:hover,
.whimtex-canvas-scrollbar-arrow:active {
    background-color: var(--whimtex-hover-overlay);
}

.whimtex-canvas-scrollbar-arrow:disabled {
    opacity: 0.25;
    background-color: transparent;
}

.whimtex-canvas-scrollbar-arrow-icon {
    width: 10px;
    height: 10px;
}

.whimtex-canvas-scrollbar-thumb {
    position: absolute;
    border-radius: 3px;
    background-color: #454545;
}

.whimtex-canvas-scrollbar--horizontal > .whimtex-canvas-scrollbar-track > .whimtex-canvas-scrollbar-thumb {
    top: 0;
    bottom: 0;
}

.whimtex-canvas-scrollbar--vertical > .whimtex-canvas-scrollbar-track > .whimtex-canvas-scrollbar-thumb {
    left: 0;
    right: 0;
}

.whimtex-canvas-scrollbar-track:hover > .whimtex-canvas-scrollbar-thumb,
.whimtex-canvas-scrollbar--dragging > .whimtex-canvas-scrollbar-track > .whimtex-canvas-scrollbar-thumb {
    background-color: #606060;
}

.whimtex-canvas-navigation--light .whimtex-canvas-scrollbar-thumb {
    background-color: #979797;
}

.whimtex-canvas-navigation--light .whimtex-canvas-scrollbar-track:hover > .whimtex-canvas-scrollbar-thumb,
.whimtex-canvas-navigation--light .whimtex-canvas-scrollbar--dragging > .whimtex-canvas-scrollbar-track > .whimtex-canvas-scrollbar-thumb {
    background-color: #777777;
}

.whimtex-canvas-scrollbar--disabled > .whimtex-canvas-scrollbar-track > .whimtex-canvas-scrollbar-thumb {
    opacity: 0.25;
}

.whimtex-vector-actions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.whimtex-vector-actions > Button {
    min-width: 42px;
}

.whimtex-vector-figure-name {
    flex-grow: 1;
    -unity-text-align: middle-left;
}

.whimtex-area-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.whimtex-area-status {
    -unity-text-align: middle-left;
    color: rgb(170, 170, 170);
}

.whimtex-zoom-selection {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.whimtex-saved-output-preview {
    height: 160px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 6px;
}

.whimtex-saved-output-preview--empty {
    display: none;
}

.whimtex-inspector-section.unity-foldout {
    flex-shrink: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
    border-top-width: 1px;
    border-top-color: #252525;
    background-color: var(--whimtex-surface);
}

.whimtex-inspector-section > .unity-foldout__toggle {
    height: 24px;
    flex-shrink: 0;
    min-width: 0;
    margin: 0;
    padding: 0 6px;
    background-color: #414141;
    -unity-font-style: bold;
}

.whimtex-inspector-section > .unity-foldout__toggle:hover {
    background-color: #494949;
}

.whimtex-inspector-section > .unity-foldout__toggle .unity-toggle__text {
    margin-left: 22px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-inspector-section-content {
    margin: 0;
    padding: 5px 8px 7px;
    min-width: 0;
}

.whimtex-inspector-section--menu > .unity-foldout__toggle {
    padding-right: 22px;
}

.unity-toolbar-menu.whimtex-inspector-section-menu {
    position: absolute;
    top: 1px;
    right: 2px;
    width: 18px;
    margin: 0;
}

.whimtex-inspector-section-menu-visual {
    position: absolute;
    left: 2px;
    right: 2px;
    top: 0;
    bottom: 0;
    border-radius: 2px;
    align-items: center;
    justify-content: center;
}

.whimtex-inspector-section-menu > .unity-toolbar-menu__text,
.whimtex-inspector-section-menu > .unity-toolbar-menu__arrow { display: none; }

.whimtex-inspector-section--add-fx > .unity-foldout__toggle {
    padding-right: 48px;
}

.unity-button.whimtex-fx-header-add {
    position: absolute;
    top: 1px;
    right: 22px;
    width: 22px;
    margin: 0;
    color: var(--menu-dot);
}

.whimtex-fx-section-content {
    padding-left: 0;
    padding-right: 0;
}

.whimtex-inspector-section-icon {
    position: absolute;
    left: 21px;
    top: 4px;
    width: 16px;
    height: 16px;
    color: #a4b9cd;
}

.whimtex-inspector-section--light.unity-foldout {
    background-color: var(--whimtex-surface-light);
    border-top-color: #9a9a9a;
}

.whimtex-inspector-section--light > .unity-foldout__toggle {
    background-color: #cecece;
}

.whimtex-inspector-section--light > .unity-foldout__toggle:hover {
    background-color: #d8d8d8;
}

.whimtex-inspector-section--light > .whimtex-inspector-section-icon {
    color: #577185;
}

.whimtex-inspector-section:disabled > .unity-foldout__toggle {
    background-color: #3b3b3b;
    color: #858585;
}

.whimtex-inspector-section:disabled > .whimtex-inspector-section-icon {
    opacity: 0.35;
}

.whimtex-inspector-section--light:disabled > .unity-foldout__toggle {
    background-color: #c7c7c7;
    color: #8a8a8a;
}

.whimtex-rendering-card > .unity-foldout__toggle {
    padding-right: 116px;
}

.whimtex-rendering-preset {
    position: absolute;
    top: 3px;
    right: 6px;
    width: 104px;
    margin: 0;
}

.whimtex-rendering-preset > .unity-base-field__input {
    min-width: 0;
}

.whimtex-layer-inspector {
    padding: 0;
    flex-basis: 0;
}

.whimtex-properties-window {
    padding: 0;
    background-color: var(--whimtex-surface);
}

.whimtex-properties-window--light {
    background-color: var(--whimtex-surface-light);
}

.whimtex-fx-warning {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    align-self: center;
    margin-left: 2px;
    margin-right: 2px;
    color: #ffba33;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.whimtex-layer-row .whimtex-fx-warning {
    width: 8px;
    margin-left: 1px;
    margin-right: 1px;
}

.whimtex-fx-section-warning {
    margin-left: 22px;
}

.whimtex-inspector-section--fx-warning > .unity-foldout__toggle .unity-toggle__text {
    margin-left: 2px;
}

.whimtex-properties-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    padding: 0;
}

.whimtex-theme .unity-vector2-field .unity-composite-field__field-spacer {
    display: none;
}

.whimtex-theme .unity-vector2-field .unity-composite-field__field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.whimtex-canvas-header-row .whimtex-canvas-view-actions {
    flex-direction: row;
    align-items: center;
}

.whimtex-eyedropper-lens {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    background-color: #202020;
    border-width: 1px;
    border-color: #777777;
    border-radius: 3px;
}

.whimtex-eyedropper-sample {
    position: absolute;
    left: 50%;
    margin-left: -44px;
    top: 3px;
    width: 88px;
    height: 88px;
}

.whimtex-eyedropper-swatch {
    position: absolute;
    left: 50%;
    margin-left: -44px;
    width: 88px;
    top: 95px;
    height: 16px;
}

.whimtex-pencil-cursor {
    position: absolute;
    left: 0;
    top: 0;
}

.whimtex-pencil-cursor--hidden {
    visibility: hidden;
}

.whimtex-layer-row {
    --layer-row-background: var(--whimtex-surface);
    --layer-row-hover: #404040;
    --layer-row-divider: #242424;
    --layer-row-selected: #2e4766;
    --layer-row-active: #2e619e;
    --layer-row-outline: #4377b0;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 26px;
    padding: 0 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--layer-row-divider);
    background-color: var(--layer-row-background);
}

.whimtex-layer-row--light {
    --layer-row-background: #d1d1d1;
    --layer-row-hover: #dbdbdb;
    --layer-row-divider: #a8a8a8;
    --layer-row-selected: #99b8d9;
    --layer-row-active: #619ee0;
    --layer-row-outline: #78afe8;
}

.whimtex-layer-row:hover {
    background-color: var(--layer-row-hover);
}

.whimtex-layer-name {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
}

.unity-button.whimtex-layer-enabled {
    width: 26px;
    min-width: 0;
    height: 22px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.whimtex-layer-enabled > .whimtex-layer-action-icon {
    scale: 1.125 1.125;
}

.whimtex-layer-enabled > .whimtex-layer-eye {
    opacity: 0;
}

.whimtex-layer-enabled > .whimtex-layer-eye-off {
    display: none;
    opacity: 0.45;
}

.whimtex-layer-row:hover > .whimtex-layer-enabled > .whimtex-layer-eye {
    opacity: 0.2;
}

.whimtex-layer-enabled--hidden > .whimtex-layer-eye {
    display: none;
}

.whimtex-layer-enabled--hidden > .whimtex-layer-eye-off {
    display: flex;
}

.whimtex-layer-row > .whimtex-layer-enabled:hover > .whimtex-layer-eye {
    opacity: 0.35;
}

.whimtex-layer-name > .unity-base-field__input {
    min-width: 0;
}

.whimtex-layer-name > .whimtex-layer-name__editor {
    display: none;
}

.whimtex-layer-name > .whimtex-layer-name__display {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    margin: 0;
    padding: 0 4px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    -unity-text-align: middle-left;
}

.whimtex-layer-name--editing > .whimtex-layer-name__editor {
    display: flex;
}

.whimtex-layer-name--editing > .whimtex-layer-name__display {
    display: none;
}

.whimtex-layer-drag-ghost {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0.6;
    overflow: hidden;
    margin: 0;
    padding: 0;
}

.whimtex-quilting-seed-row > .unity-base-field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.whimtex-quilting-seed-row > .unity-button {
    flex-shrink: 0;
}

.whimtex-seamless-section {
    margin-top: 6px;
    padding-top: 4px;
    border-top-width: 1px;
    border-top-color: var(--whimtex-hover-overlay);
}

.whimtex-seamless-heading {
    margin: 1px 3px;
    padding: 0 1px;
    height: 18px;
    -unity-text-align: middle-left;
}

.whimtex-seamless-edges {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    align-self: center;
    margin: 4px 0 6px 0;
}

.whimtex-seamless-image {
    position: absolute;
    left: 12px;
    right: 12px;
    top: 12px;
    bottom: 12px;
    background-color: rgba(128, 128, 128, 0.08);
    border-width: 1px;
    border-color: var(--whimtex-hover-overlay);
    border-radius: 2px;
    opacity: 0.6;
}

.unity-button.whimtex-seamless-edge {
    position: absolute;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 2px;
    background-color: var(--whimtex-hover-overlay);
}

.whimtex-seamless-edge--left {
    left: 0;
    top: 12px;
    bottom: 12px;
    width: 10px;
}

.whimtex-seamless-edge--right {
    right: 0;
    top: 12px;
    bottom: 12px;
    width: 10px;
}

.whimtex-seamless-edge--top {
    top: 0;
    left: 12px;
    right: 12px;
    height: 10px;
}

.whimtex-seamless-edge--bottom {
    bottom: 0;
    left: 12px;
    right: 12px;
    height: 10px;
}

.unity-button.whimtex-seamless-image {
    margin: 0;
    padding: 0;
    min-width: 0;
    min-height: 0;
}

.whimtex-seamless-center-icon {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.unity-button.whimtex-seamless-image:hover {
    background-color: rgba(128, 128, 128, 0.2);
    opacity: 1;
}

.unity-button.whimtex-seamless-image:focus {
    border-color: #90bce3;
}

.unity-button.whimtex-seamless-edge:hover,
.unity-button.whimtex-seamless-edge--hovered {
    background-color: rgba(128, 128, 128, 0.5);
}

.unity-button.whimtex-seamless-edge--selected {
    background-color: #3979b5;
    border-color: #6194c2;
}

.unity-button.whimtex-seamless-edge--selected:hover,
.unity-button.whimtex-seamless-edge--selected.whimtex-seamless-edge--hovered {
    background-color: #488bcc;
}

.unity-button.whimtex-seamless-edge:focus {
    border-color: #90bce3;
}

.whimtex-layer-drag-ghost-part {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.whimtex-layer-drag-ghost-name {
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-layer-row--selected,
.whimtex-layer-row--selected:hover {
    background-color: var(--layer-row-selected);
}

.whimtex-layer-row--active,
.whimtex-layer-row--active:hover {
    background-color: var(--layer-row-active);
}

.whimtex-layer-active-outline {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 1px;
    border-color: var(--layer-row-outline);
}

.whimtex-layer-row--active > .whimtex-layer-active-outline {
