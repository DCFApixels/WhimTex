.whimtex-theme {
    --whimtex-surface: #383838;
    --whimtex-surface-light: #c4c4c4;
    --whimtex-header: #454545;
    --whimtex-header-light: #d0d0d0;
    --whimtex-icon: #d2d2d2;
    --whimtex-neutral-33: #333333;
    --whimtex-hover-overlay: rgba(128, 128, 128, 0.25);
}

.unity-button.whimtex-layer-menu-button,
.whimtex-group-foldout {
    --menu-hover: rgba(255, 255, 255, 0.12);
    --menu-pressed: rgba(255, 255, 255, 0.2);
    --menu-dot: var(--whimtex-icon);
    flex-direction: column;
    width: 14px;
    min-width: 0;
    height: 22px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
    padding: 0;
    border-width: 0;
    border-radius: 2px;
    background-image: none;
    background-color: transparent;
    align-items: center;
    justify-content: center;
}

.unity-button.whimtex-layer-menu-button--light,
.whimtex-group-foldout.whimtex-layer-menu-button--light {
    --menu-hover: rgba(0, 0, 0, 0.1);
    --menu-pressed: rgba(0, 0, 0, 0.18);
    --menu-dot: var(--whimtex-neutral-33);
}

.unity-button.whimtex-layer-menu-button:hover,
.whimtex-group-foldout:hover {
    background-color: var(--menu-hover);
}

.unity-button.whimtex-layer-menu-button:active,
.whimtex-group-foldout:active {
    background-color: var(--menu-pressed);
}

.whimtex-group-foldout,
.whimtex-layer-thumbnail {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin: 0 3px 0 0;
}

.whimtex-group-foldout > .unity-label {
    margin: 0;
    font-size: 10px;
}

.whimtex-layer-thumbnail {
    background-color: #474747;
}

.whimtex-compositor-reference-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background-color: rgba(224, 143, 70, 0.7);
}

.whimtex-layer-table-header {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    min-height: 24px;
    padding: 0 3px;
    background-color: var(--whimtex-header);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.4);
}

.whimtex-settings-pane--light .whimtex-layer-table-header {
    background-color: var(--whimtex-header-light);
}

.whimtex-layer-name-cell {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    overflow: hidden;
    margin: 0;
}

.whimtex-layer-name-cell > .whimtex-layer-name {
    min-width: 0;
    margin: 0 2px 0 0;
}

.whimtex-layer-name-cell > .whimtex-layer-name,
.whimtex-layer-row > .whimtex-layer-opacity,
.whimtex-layer-row > .whimtex-layer-blend {
    height: 20px;
    margin-top: 0;
    margin-bottom: 0;
}

.whimtex-layer-opacity,
.whimtex-layer-blend {
    flex-shrink: 0;
    min-width: 0;
    margin: 0 2px;
}

.whimtex-layer-opacity {
    width: 48px;
}

.whimtex-layer-blend {
    width: 126px;
}

.whimtex-layer-opacity > .unity-base-field__input,
.whimtex-layer-blend > .unity-base-field__input {
    min-width: 0;
}

.whimtex-layer-table-header > .whimtex-layer-opacity {
    align-items: center;
    justify-content: center;
}

.whimtex-layer-table-header > .unity-button.whimtex-layer-enabled,
.whimtex-layer-table-header > .whimtex-layer-name-cell,
.whimtex-layer-table-header > .whimtex-layer-opacity {
    align-self: stretch;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.4);
}

.whimtex-layer-table-header > .whimtex-layer-name-cell {
    padding-left: 7px;
    padding-right: 3px;
    -unity-text-align: middle-left;
}

.whimtex-layer-table-header > .whimtex-layer-blend {
    padding-left: 3px;
    padding-right: 3px;
    -unity-text-align: middle-left;
}

.whimtex-layer-table-header .whimtex-layer-action-icon {
    opacity: 0.5;
}

.whimtex-layer-table-header > .whimtex-layer-opacity > .whimtex-layer-action-icon {
    opacity: 0.65;
}

.whimtex-layer-menu-space {
    width: 14px;
    flex-shrink: 0;
    margin-left: 2px;
}

.whimtex-layer-drop-marker {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-color: #339eff;
}

.whimtex-layer-row--drop-inside > .whimtex-layer-drop-marker {
    display: flex;
    border-width: 1px;
    background-color: rgba(51, 158, 255, 0.15);
}

.whimtex-layer-row--drop-before > .whimtex-layer-drop-marker {
    display: flex;
    border-top-width: 2px;
}

.whimtex-layer-row--drop-after > .whimtex-layer-drop-marker {
    display: flex;
    border-bottom-width: 2px;
}

.whimtex-layer-menu-dot {
    width: 2px;
    height: 2px;
    flex-shrink: 0;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 1px;
    background-color: var(--menu-dot);
}

.whimtex-canvas-toolbar {
    flex-shrink: 0;
}

.whimtex-preview-canvas-shadow {
    position: absolute;
}

.whimtex-tiled-image {
    position: absolute;
    display: none;
}

.whimtex-preview-image--visible {
    display: flex;
}

.whimtex-preview-canvas--empty > .whimtex-preview-surface {
    display: none;
}

.whimtex-preview-backdrop--hidden,
.whimtex-preview-canvas-shadow--hidden,
.whimtex-post-fx-field--hidden,
.whimtex-preview-image--hidden {
    display: none;
}

.whimtex-workspace {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.whimtex-tools {
    width: 36px;
    flex-shrink: 0;
    align-items: center;
    padding-top: 4px;
    background-color: var(--whimtex-surface);
    border-right-width: 1px;
    border-right-color: #171717;
}

.whimtex-workspace-split {
    flex-basis: 0;
    min-width: 0;
}

.whimtex-tools--light {
    background-color: var(--whimtex-surface-light);
    border-right-color: #858585;
}

.unity-button.whimtex-tool-button {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
    margin: 0 0 3px 0;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-image: none;
    background-color: transparent;
    border-width: 1px;
    border-color: transparent;
    border-radius: 3px;
    color: var(--whimtex-icon);
}

.whimtex-tools--light > .unity-button.whimtex-tool-button {
    color: var(--whimtex-neutral-33);
}

.unity-button.whimtex-tool-button:hover {
    background-color: var(--whimtex-hover-overlay);
}

.unity-button.whimtex-tool-button--selected,
.unity-button.whimtex-tool-button--selected:hover {
    background-color: #2e619e;
    border-color: #578ac0;
}

.whimtex-tools > .unity-button.whimtex-tool-button--selected {
    color: #eeeeee;
}

.unity-button.whimtex-tool-button:active {
    background-color: #254e7e;
}

.unity-button.whimtex-tool-button:focus {
    border-color: #578ac0;
}

.unity-button.whimtex-tool-button:disabled {
    opacity: 0.4;
}

.whimtex-tool-button--unavailable > .whimtex-tool-icon {
    opacity: 0.4;
}

.whimtex-tool-icon {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
}

.whimtex-tool-dropdown-marker {
    position: absolute;
    right: 1px;
    bottom: 1px;
    width: 4px;
    height: 4px;
    opacity: 0.65;
}

.whimtex-tool-options--hidden {
    display: none;
}

.whimtex-tool-options--empty > * {
    visibility: hidden;
}

.whimtex-preview-canvas.whimtex-preview-cursor--pan {
    cursor: pan;
}

.whimtex-preview-canvas.whimtex-preview-cursor--zoom {
    cursor: zoom;
}

.whimtex-preview-canvas.whimtex-preview-cursor--scale {
    cursor: scale-arrow;
}

.whimtex-preview-canvas.whimtex-preview-cursor--rotate {
    cursor: rotate-arrow;
}

.whimtex-preview-canvas.whimtex-preview-cursor--move {
    cursor: move-arrow;
}

.whimtex-preview-canvas {
    cursor: arrow;
    overflow: hidden;
}

.whimtex-preview-backdrop {
    position: absolute;
    opacity: 0.035;
}

.whimtex-preview-inset-shadow {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.whimtex-preview-workspace {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}

.whimtex-post-fx-overlay {
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 0;
    right: 0;
    align-items: flex-end;
}

.whimtex-post-fx-panel {
    flex-direction: row;
    flex-shrink: 1;
    min-height: 0;
    max-width: 100%;
}

.whimtex-preview-drawer-tabs {
    flex-shrink: 0;
}

.whimtex-brush-spacing-info {
    font-size: 10px;
    opacity: 0.65;
    margin-bottom: 6px;
}

.whimtex-brush-section-header {
    flex-direction: row;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.15);
    margin: 6px 0 4px 0;
    padding: 2px 2px 2px 6px;
    flex-shrink: 0;
}

.whimtex-brush-section-title {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    -unity-font-style: bold;
}

.whimtex-brush-section-reset {
    width: 20px;
    height: 18px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
}

.whimtex-brush-tint-row {
    flex-direction: row;
    align-items: center;
}

.whimtex-brush-tint-row > .whimtex-brush-tint-gradient {
    flex-grow: 1;
    min-width: 0;
}

.whimtex-brush-tint-row > .whimtex-brush-tint-reset {
    width: 20px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 2px 0 2px;
    padding: 0;
}

.whimtex-brush-strength > .unity-base-field__label {
    width: 44px;
    min-width: 44px;
    flex-shrink: 0;
}

.whimtex-brush-edge {
    width: 150px;
    height: 20px;
    flex-shrink: 0;
    margin: 0 2px;
}

.whimtex-brush-edge-field {
    flex-grow: 1;
    margin: 0;
    min-width: 0;
}

.whimtex-brush-edge-field > .unity-base-field__label {
    width: 58px;
    min-width: 58px;
    flex-shrink: 0;
    margin-right: 18px;
    -unity-text-align: middle-left;
}

.whimtex-brush-edge-field > .unity-base-field__input {
    flex-grow: 1;
    min-width: 0;
}

.unity-button.whimtex-brush-edge-mode {
    position: absolute;
    left: 58px;
    top: 0;
    bottom: 0;
    width: 16px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

.unity-button.whimtex-brush-edge-mode:hover {
    background-color: var(--whimtex-hover-overlay);
}

.whimtex-post-fx-drawer {
    width: 300px;
    flex-shrink: 1;
    min-width: 0;
    min-height: 0;
    background-color: var(--whimtex-surface);
    border-width: 1px;
    border-color: #191919;
    border-radius: 3px;
    overflow: hidden;
}

.whimtex-brush-stroke-preview {
    height: 96px;
    flex-shrink: 0;
    margin: 0 6px 6px 6px;
    border-width: 1px;
    border-color: #252525;
    border-radius: 3px;
    background-color: #292929;
    overflow: hidden;
}

.whimtex-brush-preset-row {
    flex-direction: row;
    flex-shrink: 0;
    margin: 4px 4px 0 4px;
}

.whimtex-brush-preset-picker {
    flex-grow: 1;
    min-width: 0;
    -unity-text-align: middle-left;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-brush-preset-save {
    flex-shrink: 0;
}

.whimtex-brush-preview-scale {
    flex-shrink: 0;
    margin: 0 6px 6px 6px;
}

.whimtex-brush-preview-scale > .unity-base-field__label {
    min-width: 110px;
    width: 110px;
}

.whimtex-post-fx-settings {
    flex-grow: 0;
    flex-shrink: 1;
    flex-basis: auto;
    min-height: 0;
    padding: 6px;
}

.whimtex-post-fx-overlay--hidden,
.whimtex-post-fx-drawer--hidden {
    display: none;
}

.whimtex-post-fx-settings .unity-base-field__label {
    min-width: 100px;
    width: 100px;
}

.unity-button.whimtex-post-fx-tab {
    width: 16px;
    height: 44px;
    flex-shrink: 0;
    align-self: flex-start;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: #191919;
    border-top-left-radius: 4px;
    border-bottom-left-radius: 4px;
    background-color: var(--whimtex-surface);
    color: #b8b8b8;
    font-size: 18px;
}

.unity-button.whimtex-post-fx-tab:hover {
    color: #66b8ff;
    background-color: var(--whimtex-header);
}

.unity-button.whimtex-channel-button.whimtex-post-fx-button,
.unity-button.whimtex-channel-button.whimtex-guides-button {
    width: 52px;
    min-width: 52px;
}

.unity-button.whimtex-channel-button.whimtex-tiled-button {
    width: auto;
    min-width: 0;
    padding-left: 4px;
    padding-right: 4px;
}

.unity-button.whimtex-channel-button.whimtex-live-output-button {
    align-items: center;
    justify-content: center;
}

.whimtex-live-output-indicator {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: #89898b;
    border-radius: 6px;
}

.whimtex-live-output-disc {
    width: 8px;
    height: 8px;
    flex-shrink: 0;
    border-radius: 4px;
    background-color: #89898b;
}

.whimtex-live-output-button.whimtex-channel-button--enabled > .whimtex-live-output-indicator {
    border-color: #dedee0;
}

.whimtex-live-output-button.whimtex-channel-button--enabled .whimtex-live-output-disc {
    background-color: #f07860;
}

.whimtex-zoom-settings,
.whimtex-fill-settings,
.whimtex-transform-settings {
    flex-wrap: wrap;
    flex-shrink: 0;
}

.whimtex-zoom-settings > * {
    flex-shrink: 0;
    margin: 1px 3px;
    min-height: 22px;
}

.whimtex-zoom-percent {
    min-width: 66px;
    -unity-text-align: middle-left;
}

.whimtex-view-field {
    width: 130px;
}

.whimtex-view-field > .unity-base-field__label {
    min-width: 0;
    margin-right: 4px;
    flex-shrink: 0;
}

.whimtex-guides-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.whimtex-guide-rail {
    position: absolute;
    background-color: rgba(85, 85, 85, 0.45);
    align-items: center;
    justify-content: center;
}

.whimtex-guide-rail:hover {
    background-color: rgba(110, 150, 160, 0.65);
}

.whimtex-guide-rail--left {
    left: 0;
    top: 8px;
    bottom: 0;
    width: 8px;
}

.whimtex-guide-rail--top {
    left: 0;
    right: 0;
    top: 0;
    height: 8px;
}

.whimtex-guide-grip {
    width: 2px;
    height: 18px;
    background-color: rgba(200, 220, 225, 0.3);
}

.whimtex-guide-rail--top > .whimtex-guide-grip {
    width: 18px;
    height: 2px;
}

.whimtex-area-overlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    overflow: hidden;
}

.whimtex-area-settings > * {
    flex-shrink: 0;
    margin-right: 3px;
}

.whimtex-area-mode {
    width: 86px;
}

.whimtex-area-status {
    -unity-text-align: middle-left;
    color: rgb(170, 170, 170);
}

.whimtex-zoom-selection {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.whimtex-fill-settings > * {
    flex-shrink: 0;
    margin: 1px 3px;
    height: 22px;
}

.whimtex-fill-settings > .unity-base-field {
    align-items: center;
}

.whimtex-fill-tolerance {
    width: 184px;
}

.whimtex-fill-expand {
    width: 156px;
}

.whimtex-fill-settings > .unity-base-field > .unity-base-field__label {
    min-width: 0;
    width: auto;
    flex-grow: 0;
    flex-shrink: 0;
    align-self: stretch;
    margin: 0 6px 0 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.whimtex-fill-settings > .unity-toggle > .unity-base-field__input {
    flex-grow: 0;
    flex-shrink: 0;
    margin: 0;
}

.whimtex-saved-output-preview {
    height: 160px;
    flex-shrink: 0;
    margin-top: 4px;
    margin-bottom: 6px;
}

.whimtex-saved-output-preview--empty {
    display: none;
}

.whimtex-inspector-section.unity-foldout {
    flex-shrink: 0;
    min-width: 0;
    margin: 0;
    padding: 0;
    border-top-width: 1px;
    border-top-color: #252525;
    background-color: var(--whimtex-surface);
}

.whimtex-inspector-section > .unity-foldout__toggle {
    height: 24px;
    flex-shrink: 0;
    min-width: 0;
    margin: 0;
    padding: 0 6px;
    background-color: #414141;
    -unity-font-style: bold;
}

.whimtex-inspector-section > .unity-foldout__toggle:hover {
    background-color: #494949;
}

.whimtex-inspector-section > .unity-foldout__toggle .unity-toggle__text {
    margin-left: 22px;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-inspector-section-content {
    margin: 0;
    padding: 5px 8px 7px;
    min-width: 0;
}

.whimtex-inspector-section-icon {
    position: absolute;
    left: 21px;
    top: 4px;
    width: 16px;
    height: 16px;
    color: #a4b9cd;
}

.whimtex-inspector-section--light.unity-foldout {
    background-color: var(--whimtex-surface-light);
    border-top-color: #9a9a9a;
}

.whimtex-inspector-section--light > .unity-foldout__toggle {
    background-color: #cecece;
}

.whimtex-inspector-section--light > .unity-foldout__toggle:hover {
    background-color: #d8d8d8;
}

.whimtex-inspector-section--light > .whimtex-inspector-section-icon {
    color: #577185;
}

.whimtex-inspector-section:disabled > .unity-foldout__toggle {
    background-color: #3b3b3b;
    color: #858585;
}

.whimtex-inspector-section:disabled > .whimtex-inspector-section-icon {
    opacity: 0.35;
}

.whimtex-inspector-section--light:disabled > .unity-foldout__toggle {
    background-color: #c7c7c7;
    color: #8a8a8a;
}

.whimtex-color-card > .unity-foldout__toggle {
    padding-right: 116px;
}

.whimtex-color-preset {
    position: absolute;
    top: 3px;
    right: 6px;
    width: 104px;
    margin: 0;
}

.whimtex-color-preset > .unity-base-field__input {
    min-width: 0;
}

.whimtex-layer-inspector {
    padding: 0 0 8px;
}

.whimtex-properties-window {
    padding: 0 0 8px;
    background-color: var(--whimtex-surface);
}

.whimtex-properties-window--light {
    background-color: var(--whimtex-surface-light);
}

.whimtex-transform-card .unity-vector2-field .unity-composite-field__field-spacer {
    display: none;
}

.whimtex-transform-card .unity-vector2-field .unity-composite-field__field {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
}

.whimtex-transform-option,
.whimtex-transform-settings > .unity-button {
    flex-shrink: 0;
    min-height: 24px;
}

.whimtex-preview-actions {
    flex-direction: row;
    flex-grow: 1;
    flex-shrink: 0;
    align-items: center;
    justify-content: flex-end;
    margin-left: 4px;
}

.whimtex-canvas-title {
    -unity-font-style: bold;
    flex-shrink: 0;
    margin-right: 6px;
}

.whimtex-canvas-size {
    flex-basis: 98px;
    min-width: 60px;
    flex-shrink: 1;
}

.whimtex-canvas-filter {
    flex-basis: 142px;
    min-width: 122px;
    flex-shrink: 1;
}

.whimtex-canvas-filter > .unity-base-field__label {
    min-width: 34px;
    width: 34px;
    flex-shrink: 0;
}

.whimtex-eyedropper-lens {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0;
    background-color: #202020;
    border-width: 1px;
    border-color: #777777;
    border-radius: 3px;
}

.whimtex-eyedropper-sample {
    position: absolute;
    left: 50%;
    margin-left: -44px;
    top: 3px;
    width: 88px;
    height: 88px;
}

.whimtex-eyedropper-swatch {
    position: absolute;
    left: 50%;
    margin-left: -44px;
    width: 88px;
    top: 95px;
    height: 16px;
}

.whimtex-pencil-cursor {
    position: absolute;
    left: 0;
    top: 0;
}

.whimtex-pencil-cursor--hidden {
    visibility: hidden;
}

.whimtex-brush-size > .unity-base-field__label {
    width: 30px;
    min-width: 30px;
    flex-shrink: 0;
}

.whimtex-canvas-size > .unity-base-field__label {
    width: 22px;
    min-width: 22px;
    flex-shrink: 0;
}

.whimtex-layer-row {
    --layer-row-background: var(--whimtex-surface);
    --layer-row-hover: #404040;
    --layer-row-divider: #242424;
    --layer-row-selected: #2e4766;
    --layer-row-active: #2e619e;
    --layer-row-outline: #4377b0;
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 26px;
    padding: 0 3px;
    border-bottom-width: 1px;
    border-bottom-color: var(--layer-row-divider);
    background-color: var(--layer-row-background);
}

.whimtex-layer-row--light {
    --layer-row-background: #d1d1d1;
    --layer-row-hover: #dbdbdb;
    --layer-row-divider: #a8a8a8;
    --layer-row-selected: #99b8d9;
    --layer-row-active: #619ee0;
    --layer-row-outline: #78afe8;
}

.whimtex-layer-row:hover {
    background-color: var(--layer-row-hover);
}

.whimtex-layer-name {
    flex-basis: 0;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 72px;
    overflow: hidden;
}

.unity-button.whimtex-layer-enabled {
    width: 26px;
    min-width: 0;
    height: 22px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    align-items: center;
    justify-content: center;
}

.whimtex-layer-enabled > .whimtex-layer-action-icon {
    scale: 1.125 1.125;
}

.whimtex-layer-enabled > .whimtex-layer-eye {
    opacity: 0;
}

.whimtex-layer-enabled > .whimtex-layer-eye-off {
    display: none;
    opacity: 0.45;
}

.whimtex-layer-row:hover > .whimtex-layer-enabled > .whimtex-layer-eye {
    opacity: 0.2;
}

.whimtex-layer-enabled--hidden > .whimtex-layer-eye {
    display: none;
}

.whimtex-layer-enabled--hidden > .whimtex-layer-eye-off {
    display: flex;
}

.whimtex-layer-row > .whimtex-layer-enabled:hover > .whimtex-layer-eye {
    opacity: 0.35;
}

.whimtex-layer-name > .unity-base-field__input {
    min-width: 0;
}

.whimtex-layer-drag-ghost {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0.6;
    overflow: hidden;
    margin: 0;
    padding: 0;
}

.whimtex-seamless-edges {
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    align-self: center;
    margin: 6px 0 10px 0;
}

.whimtex-seamless-image {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 14px;
    bottom: 14px;
    background-color: rgba(128, 128, 128, 0.08);
    border-width: 1px;
    border-color: var(--whimtex-hover-overlay);
    border-radius: 2px;
    opacity: 0.6;
}

.unity-button.whimtex-seamless-edge {
    position: absolute;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.35);
    border-radius: 2px;
    background-color: var(--whimtex-hover-overlay);
}

.whimtex-seamless-edge--left {
    left: 0;
    top: 14px;
    bottom: 14px;
    width: 12px;
}

.whimtex-seamless-edge--right {
    right: 0;
    top: 14px;
    bottom: 14px;
    width: 12px;
}

.whimtex-seamless-edge--top {
    top: 0;
    left: 14px;
    right: 14px;
    height: 12px;
}

.whimtex-seamless-edge--bottom {
    bottom: 0;
    left: 14px;
    right: 14px;
    height: 12px;
}

.unity-button.whimtex-seamless-edge:hover {
    background-color: rgba(128, 128, 128, 0.5);
}

.unity-button.whimtex-seamless-edge--selected {
    background-color: #3979b5;
    border-color: #6194c2;
}

.unity-button.whimtex-seamless-edge--selected:hover {
    background-color: #488bcc;
}

.unity-button.whimtex-seamless-edge:focus {
    border-color: #90bce3;
}

.whimtex-layer-drag-ghost-part {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

.whimtex-layer-drag-ghost-name {
    -unity-text-align: middle-left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-layer-row--selected,
.whimtex-layer-row--selected:hover {
    background-color: var(--layer-row-selected);
}

.whimtex-layer-row--active,
.whimtex-layer-row--active:hover {
    background-color: var(--layer-row-active);
}

.whimtex-layer-active-outline {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 1px;
    border-color: var(--layer-row-outline);
}

.whimtex-layer-row--active > .whimtex-layer-active-outline {
    display: flex;
}

.whimtex-layers-pane {
    min-height: 100px;
}

.whimtex-layer-list {
    background-color: #252525;
}

.whimtex-layer-list--light {
    background-color: #adadad;
}

.whimtex-layers-footer,
.whimtex-preview-footer {
    height: 26px;
    flex-shrink: 0;
}

.whimtex-layers-footer {
    --footer-button: #464646;
    --footer-divider: #121212;
    --footer-hover: #4c4c4c;
    --footer-pressed: #5c5c5c;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    background-color: var(--whimtex-neutral-33);
    border-top-width: 1px;
    border-top-color: #121212;
}

.whimtex-layers-footer--light {
    --footer-button: #cecece;
    --footer-divider: #525252;
    --footer-hover: #b2b2b2;
    --footer-pressed: #a3a3a3;
    background-color: #c8c8c8;
    border-top-color: #525252;
}

.whimtex-layers-footer > .whimtex-layer-action {
    width: 24px;
    height: 24px;
    min-width: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-image: none;
    background-color: var(--footer-button);
    align-items: center;
    justify-content: center;
}

.whimtex-layers-footer > .whimtex-layer-action--separated {
    border-left-width: 1px;
    border-left-color: var(--footer-divider);
}

.whimtex-layers-footer > .whimtex-layer-action:hover {
    background-color: var(--footer-hover);
}

.whimtex-layers-footer > .whimtex-layer-action:active {
    background-color: var(--footer-pressed);
}

.whimtex-layers-footer > .whimtex-layer-action:disabled {
    background-color: var(--footer-button);
}

.whimtex-layers-footer > .whimtex-layer-action.whimtex-layer-action--drop-target {
    background-color: #3b6997;
}

.whimtex-layer-action-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.whimtex-layer-action:disabled > .whimtex-layer-action-icon {
    opacity: 0.35;
}

.whimtex-settings-pane,
.whimtex-document-header {
    background-color: var(--whimtex-surface);
}

.whimtex-settings-pane--light,
.whimtex-document-header--light {
    background-color: #c2c2c2;
}

.whimtex-document-header {
    border-bottom-width: 0;
}

.unity-button.whimtex-user-settings-button {
    flex-shrink: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.whimtex-pane-header {
    height: 24px;
    flex-shrink: 0;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-left;
    background-color: var(--whimtex-header);
    color: #cfcfcf;
    border-bottom-width: 1px;
    border-bottom-color: #171717;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-pane-header--light {
    background-color: var(--whimtex-header-light);
    color: #252525;
    border-bottom-color: #858585;
}

.whimtex-layer-settings-pane {
    min-height: 100px;
    flex-grow: 1;
}

.whimtex-layer-settings-pane > .unity-scroll-view {
    min-height: 0;
    flex-grow: 1;
}

.whimtex-effect-target > .unity-base-field__input {
    background-image: none;
    background-color: #282828;
    border-width: 1px;
    border-color: #202020;
    border-radius: 3px;
    padding: 0 0 0 2px;
    align-items: center;
    min-width: 0;
}

.whimtex-effect-target--light > .unity-base-field__input {
    background-color: #e4e4e4;
    border-color: #999999;
}

.whimtex-effect-target > .unity-base-field__input:hover,
.whimtex-effect-target:focus > .unity-base-field__input {
    border-color: #5688b8;
}

.unity-base-popup-field__arrow.whimtex-effect-target-arrow {
    display: none;
}

.unity-base-popup-field__text.whimtex-effect-target-text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    margin: 0 2px;
    padding: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-effect-target-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.whimtex-effect-target-preview,
.whimtex-effect-target-fallback {
    position: absolute;
    left: 0;
    top: 0;
    width: 16px;
    height: 16px;
}

.whimtex-effect-target-selector {
    width: 18px;
    align-self: stretch;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-left-width: 1px;
    border-left-color: rgba(128, 128, 128, 0.2);
}

.whimtex-effect-target-ring {
    width: 10px;
    height: 10px;
    border-width: 1px;
    border-color: #b0b0b0;
    border-radius: 5px;
    align-items: center;
    justify-content: center;
}

.whimtex-effect-target-dot {
    width: 4px;
    height: 4px;
    border-radius: 2px;
    background-color: #b0b0b0;
}

.whimtex-effect-target--light .whimtex-effect-target-ring {
    border-color: #555555;
}

.whimtex-effect-target--light .whimtex-effect-target-dot {
    background-color: #555555;
}

.whimtex-effect-target.whimtex-effect-target--drop > .unity-base-field__input {
    border-width: 1px;
    border-color: #5688b8;
    background-color: #315c85;
}

.whimtex-document-separator {
    height: 3px;
    flex-shrink: 0;
    background-color: var(--split-line);
}

.whimtex-split-handle,
.whimtex-document-separator {
    overflow: visible;
    --split-line: rgb(18, 18, 18);
    --split-grip: rgb(160, 160, 160);
}

.whimtex-split-handle--light,
.whimtex-document-separator--light {
    --split-line: rgb(82, 82, 82);
    --split-grip: rgb(210, 210, 210);
}

.whimtex-split-handle--columns {
    width: 3px;
    height: 100%;
    cursor: resize-horizontal;
}

.whimtex-split-handle--rows {
    width: 100%;
    height: 3px;
    cursor: resize-vertical;
}

.whimtex-split-hit-area {
    position: absolute;
}

.whimtex-split-handle--columns > .whimtex-split-hit-area {
    left: -1px;
    right: -1px;
    top: 0;
    bottom: 0;
    cursor: resize-horizontal;
}

.whimtex-split-handle--rows > .whimtex-split-hit-area {
    left: 0;
    right: 0;
    top: -1px;
    bottom: -1px;
    cursor: resize-vertical;
}

.whimtex-split-handle > .whimtex-split-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: auto;
    height: auto;
    margin: 0;
    background-color: var(--split-line);
    border-width: 0;
    align-items: center;
    justify-content: center;
}

.whimtex-split-handle--rows > .whimtex-split-line {
    flex-direction: row;
}

.whimtex-split-line > .whimtex-split-grip {
    width: 2px;
    height: 2px;
    flex-shrink: 0;
    margin: 2px;
    border-radius: 1px;
    background-color: var(--split-grip);
}

.whimtex-split-handle--columns > .whimtex-split-line > .whimtex-split-grip {
    margin-left: 0;
    margin-right: 0;
}

.whimtex-split-handle--rows > .whimtex-split-line > .whimtex-split-grip {
    margin-top: 0;
    margin-bottom: 0;
}

.whimtex-split-handle:hover > .whimtex-split-line {
    background-color: #3b6997;
}

.whimtex-split-handle:hover > .whimtex-split-line > .whimtex-split-grip,
.whimtex-split-handle:active > .whimtex-split-line > .whimtex-split-grip {
    background-color: rgb(239, 246, 255);
}

.whimtex-shader-fx {
    padding: 4px;
}

.whimtex-shader-fx-code {
    height: 320px;
    flex-shrink: 0;
}

.whimtex-brush-hlsl-code {
    flex-grow: 1;
    min-height: 80px;
}

.whimtex-shader-fx-code .unity-text-field__input,
.whimtex-brush-hlsl-code .unity-text-field__input {
    -unity-text-align: upper-left;
    white-space: normal;
}

.whimtex-shader-fx-diagnostics {
    min-height: 48px;
    max-height: 180px;
    margin-top: 4px;
}

.whimtex-shader-fx-parameter {
    padding: 4px;
    margin-bottom: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.3);
}

.whimtex-shader-fx-hidden {
    display: none;
}

.whimtex-modifier-buttons {
    flex-wrap: wrap;
}

.whimtex-layer-fx {
    min-width: 0;
}

.whimtex-layer-fx-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.whimtex-layer-fx-name {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-layer-fx-entry {
    margin-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.3);
}

.whimtex-layer-fx-header {
    flex-wrap: nowrap;
    min-height: 24px;
    padding: 2px 4px;
    background-color: rgba(0, 0, 0, 0.12);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.2);
    -unity-font-style: bold;
}

.whimtex-fx-menu-button {
    width: 22px;
    height: 20px;
    flex-shrink: 0;
    padding: 0;
}

.whimtex-fx-note {
    margin: 2px 6px;
    font-size: 10px;
    opacity: 0.7;
}

.whimtex-fx-reference {
    white-space: normal;
    margin: 4px 2px;
}

.whimtex-fx-parameter-header {
    -unity-font-style: bold;
    margin: 8px 3px 3px 3px;
    white-space: normal;
}

.whimtex-output-settings-scroll {
    flex-grow: 1;
    min-height: 0;
    padding: 4px;
}

.whimtex-output-settings-hidden {
    display: none;
}

.whimtex-output-settings-fields .unity-foldout__content {
    margin-left: 0;
}

.whimtex-output-row {
    flex-direction: row;
    align-self: stretch;
    align-items: center;
    min-height: 22px;
    min-width: 0;
}

.whimtex-output-row-label {
    width: 190px;
    flex-shrink: 0;
    margin: 0;
    padding-left: 4px;
}

.whimtex-output-section .whimtex-output-row-label { padding-left: 20px; }
.whimtex-output-advanced .whimtex-output-row-label { padding-left: 36px; }
.whimtex-output-section > .unity-toggle { margin-left: 16px; }
.whimtex-output-advanced > .unity-toggle { margin-left: 32px; }

.whimtex-output-row-control {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
}

.whimtex-output-row-control > .unity-base-field__input {
    min-width: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

.whimtex-output-row-control.unity-toggle > .unity-base-field__input {
    flex-grow: 0;
    margin: 0;
}

.whimtex-output-compression {
    flex-direction: column;
    align-items: stretch;
    margin-top: 8px;
    padding: 4px;
}


.whimtex-output-compression-group {
    min-width: 0;
    align-self: stretch;
    flex-shrink: 1;
}

.whimtex-output-compression-group > .unity-help-box {
    min-width: 0;
    align-self: stretch;
    margin-left: 0;
    margin-right: 0;
}

.whimtex-output-compression-group > .unity-help-box > .unity-help-box__text {
    min-width: 0;
    flex-shrink: 1;
    flex-basis: 0;
}

.whimtex-output-compression .whimtex-output-row-label { width: 185px; }

.whimtex-output-compression-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.whimtex-output-split { flex-grow: 1; min-height: 0; }
.whimtex-output-settings-pane { min-height: 120px; flex-grow: 1; flex-basis: 0; }
.whimtex-output-preview-footer { min-height: 20px; flex-shrink: 0; overflow: hidden; }
.whimtex-output-preview-title {
    height: 20px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    padding-left: 6px;
    padding-right: 6px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.45);
    border-bottom-color: rgba(0, 0, 0, 0.45);
    -unity-font-style: bold;
    cursor: resize-vertical;
}
.whimtex-output-preview-grip {
    flex-grow: 1;
    height: 5px;
    margin-left: 4px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgb(128, 128, 128);
}
.whimtex-output-preview-surface {
    flex-grow: 1;
    min-height: 0;
    overflow: hidden;
    background-color: rgb(36, 36, 36);
}
.whimtex-output-preview-surface--hidden { display: none; }
.whimtex-output-preview-image { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.whimtex-output-preview-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 4px;
    white-space: normal;
    -unity-text-align: middle-center;
    color: white;
    -unity-font-style: bold;
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: rgba(0, 0, 0, 0.5);
}
.whimtex-output-preview-shadow {
    left: 1px;
    right: -1px;
    bottom: -2px;
    color: black;
    -unity-text-outline-color: black;
}

.whimtex-output-info {
    white-space: normal;
    padding: 4px;
}

.whimtex-output-actions { flex-direction: row; flex-shrink: 0; }
.whimtex-output-actions > .whimtex-output-apply { flex-grow: 1; }
.whimtex-output-revert { width: 70px; }
.whimtex-output-row--invalid { flex-wrap: wrap; }
.whimtex-output-row--invalid > .whimtex-output-row-control { border-color: rgb(200, 97, 85); }
.whimtex-output-field-error {
    width: 100%;
    white-space: normal;
    color: rgb(225, 130, 115);
    padding-left: 20px;
    margin-bottom: 4px;
}
.whimtex-output-border { flex-direction: row; flex-wrap: wrap; }
.whimtex-output-border > .unity-base-field { width: 50%; margin-left: 0; margin-right: 0; }
.whimtex-output-border .unity-base-field__label { min-width: 0; width: 42px; padding-left: 2px; }
.whimtex-output-preview-channel { width: 68px; margin: 0 2px; }
.whimtex-output-preview-mip { width: 68px; margin: 0; }
.whimtex-output-preview-status {
    position: absolute;
    top: 2px;
    left: 4px;
    right: 4px;
    -unity-text-align: middle-center;
    color: rgb(230, 196, 121);
    -unity-text-outline-width: 0.5px;
    -unity-text-outline-color: black;
}

.whimtex-output-apply.whimtex-output-apply--pending:enabled {
    background-color: rgb(48, 88, 122);
    border-color: rgb(79, 139, 186);
    color: white;
}
.whimtex-output-apply.whimtex-output-apply--pending:enabled:hover {
    background-color: rgb(58, 105, 145);
}
.whimtex-output-apply.whimtex-output-apply--pending:enabled:active {
    background-color: rgb(39, 72, 100);
}

.whimtex-pattern-field--hidden {
    display: none;
}

.whimtex-preview-footer {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.whimtex-preview-status {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    -unity-text-align: middle-center;
    font-size: 10px;
}

.whimtex-preview-status--hidden {
    visibility: hidden;
}

.whimtex-preview-quality {
    flex-direction: row;
    align-items: center;
    width: 170px;
    height: 22px;
    flex-shrink: 0;
}

.whimtex-preview-quality-label {
    margin: 0;
    padding: 0;
    flex-shrink: 0;
    font-size: 10px;
}

.whimtex-preview-quality-slider {
    flex-grow: 1;
    min-width: 40px;
    margin: 0 4px;
}

.whimtex-preview-quality-value {
    width: 34px;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    font-size: 10px;
    -unity-text-align: middle-right;
}

.whimtex-preview-footer-side,
.whimtex-preview-footer-group {
    flex-direction: row;
    flex-shrink: 0;
    height: 22px;
    align-items: center;
}

.whimtex-preview-channels {
    margin-left: auto;
}

.whimtex-preview-footer-group--separated {
    margin-left: 6px;
    padding-left: 4px;
    border-left-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.25);
}

.whimtex-preview-footer--compact {
    height: auto;
    min-height: 26px;
    flex-wrap: wrap;
}

.whimtex-preview-footer--compact .whimtex-preview-status {
    display: none;
}

.whimtex-preview-footer--compact > .whimtex-preview-footer-side {
    flex-wrap: wrap;
    height: auto;
    max-width: 100%;
}

.whimtex-preview-footer--compact .whimtex-preview-quality {
    width: 146px;
}

.unity-button.whimtex-channel-button {
    --channel-fill: #6a6a6e;
    --channel-hover: #79797d;
    --channel-text: #eeeeef;
    --channel-border: #939397;
    width: 24px;
    height: 18px;
    flex-shrink: 0;
    margin: 0 0 0 2px;
    padding: 1px 0 0 0;
    background-image: none;
    background-color: #252527;
    color: #a2a2a6;
    border-width: 1px;
    border-top-color: #111113;
    border-left-color: #19191b;
    border-right-color: #424246;
    border-bottom-color: #56565a;
    border-radius: 2px;
    font-size: 10px;
}

.unity-button.whimtex-channel-button:hover {
    background-color: #2e2e31;
}

.unity-button.whimtex-channel-button--enabled {
    padding: 0;
    background-color: var(--channel-fill);
    color: var(--channel-text);
    border-color: var(--channel-border);
}

.unity-button.whimtex-channel-button--enabled:hover {
    background-color: var(--channel-hover);
}

.unity-button.whimtex-channel-button--r {
    --channel-fill: #92555d;
    --channel-hover: #a2646c;
    --channel-text: #ead9d9;
    --channel-border: #b77981;
}

.unity-button.whimtex-channel-button--g {
    --channel-fill: #487c59;
    --channel-hover: #578b68;
    --channel-text: #dce8df;
    --channel-border: #6ba27e;
}

.unity-button.whimtex-channel-button--b {
    --channel-fill: #4b70a0;
    --channel-hover: #5a7faf;
    --channel-text: #dce3ed;
    --channel-border: #7298c5;
}
.whimtex-storage-description { font-size: 10px; margin-left: 3px; margin-top: 2px; opacity: 0.7; }
.whimtex-compact-storage { align-self: flex-start; margin-bottom: 6px; }
.unity-button.whimtex-hdr-button {
    width: 36px;
    margin-right: 6px;
}

.whimtex-swizzle-row,
.whimtex-swizzle-channels {
    flex-direction: row;
    align-items: center;
}

.whimtex-swizzle {
    flex-shrink: 0;
}

.whimtex-swizzle-channels {
    flex-grow: 1;
    min-width: 0;
}

.whimtex-swizzle-channel {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-left: 2px;
    margin-right: 0;
}

.whimtex-swizzle-hint--hidden {
    display: none;
}

.whimtex-swizzle-channel > .unity-base-field__input {
    min-width: 0;
}

.whimtex-preview-exposure {
    width: 88px;
    flex-shrink: 0;
    margin-right: 7px;
}

.whimtex-preview-exposure > .unity-base-field__label {
    min-width: 24px;
    width: 24px;
    flex-shrink: 0;
    margin: 0 2px 0 0;
    padding: 0;
    -unity-text-align: middle-left;
}

.whimtex-preview-exposure > .unity-base-field__input {
    min-width: 0;
}

.whimtex-preview-exposure--adjusted > .unity-base-field__label {
    color: rgb(231, 186, 111);
}

.whimtex-preview-exposure--adjusted > .unity-base-field__input {
    background-color: rgb(78, 62, 39);
}

.unity-button.whimtex-channel-button.whimtex-channel-button--error { color: rgb(255, 125, 195); }
.unity-button.whimtex-debug-button { align-items: center; justify-content: center; padding: 0; }

.whimtex-user-settings {
    padding: 8px 10px;
}

.whimtex-user-settings-heading {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 6px;
}

.whimtex-user-settings-color > .unity-base-field__label {
    min-width: 120px;
}

.whimtex-user-settings-color > .unity-base-field__input {
    flex-grow: 1;
    min-width: 50px;
}

.whimtex-user-settings-folder-row {
    flex-direction: row;
    align-items: center;
}

.whimtex-user-settings-folder {
    flex-grow: 1;
    min-width: 0;
}

.whimtex-user-settings-folder > .unity-base-field__label {
    min-width: 100px;
    width: 100px;
}

.whimtex-user-settings-folder > .unity-base-field__input {
    min-width: 0;
}

.whimtex-user-settings-folder-button {
    width: 24px;
    flex-shrink: 0;
    margin-left: 0;
    padding-left: 0;
    padding-right: 0;
}

.whimtex-user-settings-note {
    white-space: normal;
    margin-top: 12px;
    margin-bottom: 8px;
    opacity: 0.7;
}

.whimtex-user-settings-reset {
    align-self: flex-start;
}
.whimtex-normal-map-simple .whimtex-normal-map-advanced,
.whimtex-normal-map-hidden {
    display: none;
}

.whimtex-normal-map-heading {
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.3);
}

.whimtex-normal-map-hint {
    white-space: normal;
    opacity: 0.7;
    margin-bottom: 4px;
}

.whimtex-normal-map-notice {
    -unity-text-align: middle-left;
    white-space: normal;
    background-color: transparent;
    border-width: 0;
    opacity: 0.7;
}

.whimtex-normal-map-notice:hover {
    opacity: 1;
}
.whimtex-hidden,
.whimtex-brush-setting--hidden {
    display: none;
}
.whimtex-layer-agent-status {
    min-width: 16px;
    -unity-text-align: middle-center;
    color: rgba(170, 193, 212, 0.8);
}

.whimtex-layer-settings-header {
    flex-direction: row;
    align-items: center;
}

.whimtex-layer-settings-title {
    flex-grow: 1;
    min-width: 0;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy {
    flex-shrink: 0;
    height: 22px;
    margin: 0 0 0 4px;
    padding: 0 6px;
    border-width: 0;
    border-left-width: 1px;
    border-right-width: 1px;
    border-left-color: rgba(0, 0, 0, 0.2);
    border-right-color: rgba(0, 0, 0, 0.2);
    border-radius: 0;
    background-image: none;
    background-color: transparent;
    font-size: 10px;
    opacity: 0.75;
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy:hover {
    background-color: rgba(128, 128, 128, 0.16);
    opacity: 1;
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy:active {
    background-color: rgba(128, 128, 128, 0.3);
}

.whimtex-layer-settings-header > .whimtex-layer-guid-copy:disabled {
    background-color: transparent;
    opacity: 0.35;
}
.whimtex-missing-thumbnail {
    -unity-text-align: middle-center;
    -unity-font-style: bold;
    color: #e9b86d;
}

.whimtex-shape-kind {
    width: 112px;
}

.whimtex-shape-color {
    width: 64px;
}

.whimtex-shape-corners {
    width: 240px;
    height: 108px;
    align-self: center;
    margin: 4px 0;
}

.whimtex-shape-corner-diagram {
    position: absolute;
    left: 76px;
    top: 10px;
    width: 88px;
    height: 88px;
}

.whimtex-shape-corner-field {
    position: absolute;
    width: 72px;
    margin: 0;
}

.whimtex-shape-corner-field > .unity-base-field__label {
    min-width: 0;
    width: 18px;
    padding: 0;
    margin: 0 2px 0 0;
    -unity-text-align: middle-left;
}

.whimtex-shape-corner-tl { left: 0; top: 0; }
.whimtex-shape-corner-tr { right: 0; top: 0; }
.whimtex-shape-corner-br { right: 0; bottom: 0; }
.whimtex-shape-corner-bl { left: 0; bottom: 0; }

.whimtex-shape-corner-link {
    position: absolute;
    left: 108px;
    top: 42px;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    align-items: center;
    justify-content: center;
}

.whimtex-shape-picker {
    position: absolute;
    width: 36px;
    padding: 2px;
    border-width: 1px;
    border-color: #202020;
    border-radius: 3px;
    background-color: var(--whimtex-surface);
    color: var(--whimtex-icon);
}

.whimtex-shape-picker--light {
    background-color: var(--whimtex-surface-light);
    color: var(--whimtex-neutral-33);
    border-color: #858585;
}

.whimtex-shape-picker-item {
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 2px;
}

.whimtex-shape-picker-item--selected {
    background-color: var(--whimtex-hover-overlay);
}

.whimtex-shape-picker-item--hover {
    background-color: #2e619e;
    color: #eeeeee;
}
.whimtex-content-fill {
    padding: 8px;
}
.whimtex-content-fill-field {
    margin-bottom: 3px;
}
.whimtex-content-fill-message {
    white-space: normal;
    margin-top: 5px;
    margin-bottom: 7px;
}
.whimtex-content-fill-preview {
    flex-grow: 1;
    min-height: 140px;
    background-color: rgb(30, 30, 30);
    margin-top: 5px;
    margin-bottom: 5px;
}
.whimtex-content-fill-actions {
    flex-direction: row;
}
.whimtex-content-fill-actions > Button {
    flex-grow: 1;
}
.whimtex-soft-range > .unity-base-field__input {
    flex-direction: row;
}
.whimtex-soft-range-slider {
    flex-grow: 1;
    min-width: 0;
    margin-left: 0;
}
.whimtex-soft-range-number {
    width: 60px;
    flex-shrink: 0;
    margin-right: 0;
}
.whimtex-double2-input { flex-direction: row; }
.whimtex-double2-component { flex-grow: 1; flex-basis: 0; min-width: 0; }
.whimtex-double2-component > .unity-base-field__label { min-width: 12px; width: 12px; }
.whimtex-linked-output-actions {
    flex-direction: row;
    margin-left: 190px;
}
.whimtex-linked-output-actions > Button {
    flex-grow: 1;
}
.whimtex-linked-output-note {
    white-space: normal;
    margin-left: 4px;
    margin-right: 4px;
    margin-bottom: 6px;
    color: rgb(170, 170, 170);
}
