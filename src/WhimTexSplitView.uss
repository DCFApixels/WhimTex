.whimtex-layers-footer > .whimtex-layer-action {
    width: 24px;
    height: 24px;
    min-width: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 0;
    background-image: none;
    background-color: var(--footer-button);
    align-items: center;
    justify-content: center;
}

.whimtex-layers-footer > .whimtex-layer-action--separated {
    border-left-width: 1px;
    border-left-color: var(--footer-divider);
}

.whimtex-layers-footer > .whimtex-layer-action:hover {
    background-color: var(--footer-hover);
}

.whimtex-layers-footer > .whimtex-layer-action:active {
    background-color: var(--footer-pressed);
}

.whimtex-layers-footer > .whimtex-layer-action:disabled {
