}

.whimtex-layers-footer,
.whimtex-canvas-view-footer {
    height: 26px;
    flex-shrink: 0;
}

.whimtex-layers-footer {
    --footer-button: #464646;
    --footer-divider: #121212;
    --footer-hover: #4c4c4c;
    --footer-pressed: #5c5c5c;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    background-color: var(--whimtex-neutral-33);
    border-top-width: 1px;
    border-top-color: #121212;
}

.whimtex-layers-footer--light {
    --footer-button: #cecece;
    --footer-divider: #525252;
    --footer-hover: #b2b2b2;
