.whimtex-morph-editor {
    padding: 6px;
}
.whimtex-morph-editor .unity-base-field__input {
    min-width: 0;
}
.whimtex-morph-header {
    min-height: 76px;
    overflow: hidden;
}
.whimtex-morph-settings {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}
.whimtex-morph-views {
    flex-direction: row;
    flex-grow: 1;
    min-height: 64px;
}
.whimtex-morph-pane {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 44px;
    overflow: hidden;
}
.whimtex-morph-caption {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
.whimtex-morph-surface {
    flex-grow: 1;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.2);
}
.whimtex-morph-frame {
    position: absolute;
    left: 0;
    top: 0;
}
.whimtex-morph-correction-overlay {
    overflow: hidden;
}
.whimtex-morph-correction-handle {
    position: absolute;
    width: 10px;
    height: 10px;
    translate: -50% -50%;
    border-width: 1px;
    border-color: black;
    background-color: white;
}
.whimtex-morph-width-handle {
    border-radius: 50%;
}
.whimtex-morph-feather-handle {
    width: 8px;
    height: 8px;
    rotate: 45deg;
    background-color: rgb(125, 224, 238);
}
.whimtex-morph-marker {
    position: absolute;
    width: 20px;
    height: 20px;
    margin: -10px 0 0 -10px;
    padding: 0;
    border-width: 1px;
    border-color: white;
    border-radius: 10px;
    background-color: rgb(42, 51, 62);
    color: white;
    font-size: 10px;
    -unity-text-align: middle-center;
}
.whimtex-morph-marker--selected {
    background-color: rgb(28, 95, 164);
    border-color: rgb(152, 218, 255);
}
.whimtex-morph-point-radius {
    position: absolute;
    translate: -50% -50%;
    border-radius: 50%;
    border-width: 1px;
    border-color: yellow;
    background-color: rgba(255, 217, 51, 0.15);
}
.whimtex-morph-hint, .whimtex-morph-error {
    white-space: normal;
}
.whimtex-morph-error {
    flex-grow: 1;
    -unity-text-align: middle-center;
}
