/* Same 16 logical px icon size as WhimTexSearchDropdown's native SearchWindow metrics. */
.whimtex-graph-catalog-icon {
    color: var(--unity-colors-label-text);
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    width: 21px;
    height: 16px;
    padding-left: 5px;
    margin-right: 3px;
}
