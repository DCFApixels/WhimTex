/* Standard editor icons use 16 logical pixels; layout belongs to the caller. */
.whimtex-icon { width: 16px; height: 16px; flex-shrink: 0; }
.whimtex-icon-mark {
    width: 16px;
    height: 16px;
    min-width: 0;
    flex-shrink: 0;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}
.whimtex-icon-small-symbol { font-size: 9px; }
