/* SearchWindow reference geometry: 7 px top / 8 px sides, search 20,
   pages at y=30, category header 25, item row 20, icon 16 logical px. */
.whimtex-search-popup { overflow: hidden; }
.whimtex-search-input {
    width: auto;
    min-width: 0;
    margin-top: 7px;
    margin-left: 8px;
    margin-right: 8px;
    margin-bottom: 0;
    height: 20px;
    min-height: 20px;
    flex-shrink: 0;
}
.whimtex-search-viewport { position: absolute; top: 30px; bottom: 0; left: 1px; right: 1px; overflow: hidden; }
.whimtex-search-page { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.whimtex-search-header { height: 25px; flex-shrink: 0; justify-content: center; }
.whimtex-search-title { flex-grow: 1; margin: 0; white-space: nowrap; overflow: hidden; }
.whimtex-search-list { flex-grow: 1; min-height: 0; }
.whimtex-search-row { flex-direction: row; align-items: center; height: 20px; flex-shrink: 0; overflow: hidden; }
.whimtex-search-row-background { position: absolute; top: 0; bottom: 0; left: 0; right: 0; }
.whimtex-search-row-label { flex-grow: 1; min-width: 0; margin: 0; padding: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.whimtex-search-icon { width: 16px; height: 16px; margin-right: 2px; flex-shrink: 0; }
.whimtex-search-back, .whimtex-search-forward { position: absolute; top: 50%; translate: 0 -50%; }
.whimtex-search-empty { margin: 8px; -unity-text-align: middle-center; opacity: 0.65; }
