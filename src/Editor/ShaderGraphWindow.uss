.whimtex-shader-graph-body {
    flex-grow: 1;
    min-height: 0;
}
.whimtex-shader-graph-sidebar {
    min-width: 230px;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.4);
}
.whimtex-shader-graph-properties {
    flex-grow: 1;
    min-height: 0;
}
.whimtex-shader-graph-parameter {
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.25);
    padding-bottom: 4px;
}
.whimtex-shader-graph-parameter:hover {
    background-color: rgba(128, 128, 128, 0.14);
}
.whimtex-shader-graph-parameter-highlight #node-border {
    background-color: rgba(128, 180, 205, 0.28);
    border-color: var(--unity-colors-highlight-background);
}
.whimtex-shader-graph-area {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
}
.whimtex-shader-graph-layer-preview {
    position: absolute;
    left: 0;
    top: 0;
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    background-color: var(--unity-colors-window-background);
    cursor: move-arrow;
}
.whimtex-shader-graph-preview--left { border-left-color: var(--unity-colors-highlight-background); }
.whimtex-shader-graph-preview--right { border-right-color: var(--unity-colors-highlight-background); }
.whimtex-shader-graph-preview--top { border-top-color: var(--unity-colors-highlight-background); }
.whimtex-shader-graph-preview--bottom { border-bottom-color: var(--unity-colors-highlight-background); }
.whimtex-shader-graph-layer-preview > #layer-preview { flex-grow: 1; min-height: 0; }
.whimtex-shader-graph-layer-preview #layer-preview-header { flex-shrink: 0; cursor: move-arrow; }
.whimtex-shader-graph-layer-preview #layer-preview-header > Label { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.whimtex-shader-graph-preview-resize { position: absolute; }
.whimtex-shader-graph-preview-resize--left { left: 0; top: 8px; bottom: 8px; width: 6px; cursor: resize-horizontal; }
.whimtex-shader-graph-preview-resize--right { right: 0; top: 8px; bottom: 8px; width: 6px; cursor: resize-horizontal; }
.whimtex-shader-graph-preview-resize--top { left: 8px; right: 8px; top: 0; height: 4px; cursor: resize-vertical; }
.whimtex-shader-graph-preview-resize--bottom { left: 8px; right: 8px; bottom: 0; height: 6px; cursor: resize-vertical; }
.whimtex-shader-graph-preview-resize--top-left { left: 0; top: 0; width: 8px; height: 8px; cursor: resize-up-left; }
.whimtex-shader-graph-preview-resize--top-right { right: 0; top: 0; width: 8px; height: 8px; cursor: resize-up-right; }
.whimtex-shader-graph-preview-resize--bottom-left { left: 0; bottom: 0; width: 8px; height: 8px; cursor: resize-up-right; }
.whimtex-shader-graph-preview-resize--bottom-right { right: 0; bottom: 0; width: 8px; height: 8px; cursor: resize-up-left; }
.whimtex-shader-graph-parameter-header .unity-toggle__text {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
}
.whimtex-shader-graph-parameter-header > .unity-base-field__input {
    min-width: 0;
    flex-shrink: 1;
}
.whimtex-shader-graph-parameter-header > .whimtex-shader-graph-parameter-port {
    height: auto;
    padding: 0;
    flex-shrink: 0;
}
.whimtex-shader-graph-parameter-port #type { display: none; }
.whimtex-shader-graph-parameter-port #connector {
    /* Same connector metrics as the parameter node below (native ShaderPort.uss). */
    width: 8px;
    height: 8px;
    margin-left: 4px;
    margin-right: 4px;
}
.whimtex-shader-graph-parameter-insertion {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background-color: var(--unity-colors-highlight-background);
}
.whimtex-shader-graph-status {
    flex-grow: 1;
    -unity-text-align: middle-right;
    padding-right: 6px;
}
.whimtex-shader-graph-canvas {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    background-color: rgb(32, 32, 32);
}
.whimtex-shader-graph--light .whimtex-shader-graph-canvas {
    background-color: rgb(170, 170, 170);
}
.whimtex-shader-graph-node {
    min-width: 0;
    overflow: visible;
}
.whimtex-shader-graph-node.whimtex-shader-graph-node--preview {
    min-width: 200px;
}
.whimtex-shader-graph-function-actions { flex-direction: row; flex-wrap: wrap; }
/* Default code editor width; content scrolls instead of sizing the node. */
.whimtex-shader-graph-function { width: 200px; }
.whimtex-shader-graph-function-port { flex-direction: column; }
.whimtex-shader-graph-function-port > .unity-base-field { min-width: 0; }
.whimtex-shader-graph-function-port > .unity-button { flex-shrink: 0; }
.whimtex-shader-graph-function-signature { white-space: normal; opacity: 0.65; }
.whimtex-shader-graph-function-code-foldout > .unity-foldout__content { margin-left: 0; }
.whimtex-shader-graph-function-code { min-width: 0; flex-shrink: 1; min-height: 80px; height: 160px; margin: 0; }
.whimtex-shader-graph-function-code > .unity-text-field__input { min-width: 0; }
.whimtex-shader-graph-function-resize { position: absolute; right: 1px; bottom: 1px; margin: 0; opacity: 0.6; cursor: resize-up-left; }
.whimtex-shader-graph-node--error #node-border {
    border-color: rgb(225, 90, 80);
    border-width: 2px;
}
.whimtex-shader-graph-node-field {
    min-width: 0;
}
.whimtex-shader-graph-node-field > .unity-base-field__label {
    min-width: 0;
    flex-shrink: 1;
}
.whimtex-shader-graph-properties .unity-base-field__label {
    min-width: 0;
    flex-shrink: 1;
}
.whimtex-shader-graph-source {
    height: auto;
    min-height: 0;
    flex-grow: 1;
    flex-shrink: 1;
}
.whimtex-shader-graph-output #title {
    background-color: rgba(88, 147, 157, 0.22);
}
.whimtex-shader-graph-output #title-label {
    -unity-font-style: bold;
}
.whimtex-shader-graph #node-border .whimtex-shader-graph-port--resource #connector,
.whimtex-shader-graph #node-border .whimtex-shader-graph-port--resource #connector #cap,
.whimtex-shader-graph #node-border .whimtex-shader-graph-port--boolean #connector,
.whimtex-shader-graph #node-border .whimtex-shader-graph-port--boolean #connector #cap,
.whimtex-shader-graph-parameter-header .whimtex-shader-graph-port--resource #connector,
.whimtex-shader-graph-parameter-header .whimtex-shader-graph-port--resource #cap,
.whimtex-shader-graph-parameter-header .whimtex-shader-graph-port--boolean #connector,
.whimtex-shader-graph-parameter-header .whimtex-shader-graph-port--boolean #cap {
    border-radius: 0;
}
.whimtex-shader-graph-port--boolean #connector {
    rotate: 45deg;
    scale: 0.8 0.8;
}
.whimtex-shader-graph-node-preview {
    width: 128px;
    height: 128px;
    align-self: center;
    flex-shrink: 0;
}
.whimtex-shader-graph-node-preview-image {
    flex-grow: 1;
}
.whimtex-shader-graph-preview {
    margin-bottom: 4px;
}
.whimtex-shader-graph-preview--collapsed {
    margin-bottom: 0;
}
/* Native preview sizes: 20x20 collapse, 56x16 expand and 16x16 icon. */
.whimtex-shader-graph-node #collapse-preview,
.whimtex-shader-graph-node #expand-preview {
    margin: 0;
    padding: 0;
    min-width: 0;
    min-height: 0;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
}
.whimtex-shader-graph-node #collapse-preview {
    position: absolute;
    top: 4px;
    align-self: center;
    width: 20px;
    height: 20px;
    border-width: 1px;
    border-radius: 1px;
    border-color: rgb(240, 240, 240);
    background-color: black;
    color: rgb(240, 240, 240);
    opacity: 0;
}
.whimtex-shader-graph-node:hover #collapse-preview,
.whimtex-shader-graph-node #collapse-preview:focus {
    opacity: 0.6;
}
.whimtex-shader-graph-node #collapse-preview:hover {
    opacity: 1;
}
.whimtex-shader-graph-node #expand-preview {
    align-self: center;
    width: 56px;
    height: 16px;
    border-width: 0;
    border-radius: 0;
    background-color: transparent;
}
.whimtex-shader-graph-node #expand-preview:hover {
    background-color: rgba(128, 128, 128, 0.14);
}
.whimtex-shader-graph-preview-chevron {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}
.whimtex-shader-graph-parameter-node {
    min-width: 0;
}
.whimtex-shader-graph-parameter-node #output {
    flex-grow: 1;
}
/* Match native ShaderPort.uss inside TokenNode; override Pill's compact Port rules. */
.whimtex-shader-graph-parameter-node #node-border .whimtex-shader-graph-port {
    height: 24px;
    padding-left: 4px;
    padding-right: 4px;
}
.whimtex-shader-graph-parameter-node #node-border #type {
    font-size: 11px;
    height: 16px;
    padding-left: 0;
    padding-right: 0;
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 4px;
    margin-bottom: 0;
}
.whimtex-shader-graph-parameter-node #node-border #connector {
    width: 8px;
    height: 8px;
    margin-left: 4px;
    margin-right: 4px;
}
.whimtex-shader-graph-port {
    /* Native ShaderPort.uss row metrics in Unity 6000.7. */
    height: 24px;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}
.whimtex-shader-graph-port-row {
    flex-direction: row;
    overflow: visible;
}
.whimtex-shader-graph-node #input,
.whimtex-shader-graph-node #contents,
.whimtex-shader-graph-node #top,
.whimtex-shader-graph-node #node-border,
.whimtex-shader-graph-node #collapsible-area {
    overflow: visible;
}
.whimtex-shader-graph-port-value {
    /* Native PortInputView.uss layout in Unity 6000.7. */
    position: absolute;
    left: -224px;
    width: 232px;
    height: 24px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
}
.whimtex-shader-graph-value-fields {
    flex-direction: row;
    align-items: center;
    background-color: rgba(63, 63, 63, 0.8);
    border-color: rgba(25, 25, 25, 0.8);
    border-width: 1px;
    border-radius: 2px;
    padding-left: 4px;
    padding-right: 4px;
    margin-right: 16px;
    max-width: 216px;
}
.whimtex-shader-graph--light .whimtex-shader-graph-value-fields {
    background-color: rgba(194, 194, 194, 0.95);
}
.whimtex-shader-graph-value-fields > .unity-float-field {
    /* Measured Vector2Field X component in Unity 6000.7: label 17 + input 28. */
    width: 45px;
}
.whimtex-shader-graph-value-fields > .unity-color-field {
    /* Native ColorRGBASlotControlView.uss width in Unity 6000.7. */
    width: 41px;
}
/* Measured native composite fields: label 17 + input 30, component spacing 4. */
.whimtex-shader-graph-value-fields > .unity-vector2-field {
    width: 98px;
}
.whimtex-shader-graph-value-fields > .unity-vector3-field {
    width: 149px;
}
.whimtex-shader-graph-value-fields > .unity-vector4-field {
    width: 200px;
}
.whimtex-shader-graph-value-fields .unity-base-field__input {
    margin-left: 0;
    margin-right: 0;
}
.whimtex-shader-graph-uv-mode {
    width: 74px;
}
.whimtex-shader-graph-value-stub {
    position: absolute;
    right: 0;
    width: 16px;
    height: 1px;
    top: 11px;
}
/* Native RedirectNode.uss spacing, with a narrower body and a 24px port row. */
.node.whimtex-shader-graph-reroute {
    width: 48px;
    height: 24px;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
}
.whimtex-shader-graph-reroute #node-border {
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
}
.whimtex-shader-graph-reroute #selection-border {
    margin: 0;
    border-radius: 8px;
}
.whimtex-shader-graph-reroute #node-border #contents #top #input,
.whimtex-shader-graph-reroute #node-border #contents #top #output {
    width: 50%;
    padding: 0;
    justify-content: center;
}
.whimtex-shader-graph-reroute #top {
    height: 24px;
    align-items: center;
}
.whimtex-shader-graph-reroute .port {
    width: 100%;
    height: 24px;
    padding: 0;
    margin: 0;
    align-items: center;
}
.whimtex-shader-graph-reroute #connector {
    margin-top: 0;
    margin-bottom: 0;
    align-self: center;
}
.whimtex-shader-graph-reroute .input > #connector {
    margin-left: 6px;
    margin-right: 0;
}
.whimtex-shader-graph-reroute .output > #connector {
    margin-left: 0;
    margin-right: 6px;
}
.whimtex-shader-graph-message {
    position: absolute;
    left: 100%;
    top: 4px;
    margin-left: 4px;
    width: 16px;
    height: 16px;
    overflow: visible;
}
.whimtex-shader-graph-message > #message-icon { width: 16px; height: 16px; }
.whimtex-shader-graph-message-popup {
    position: absolute;
    left: 100%;
    top: 0;
    margin-left: 4px;
    min-width: 180px;
    width: 320px;
    white-space: normal;
}
.whimtex-shader-graph-note { overflow: visible; }
/* Native GraphView Node, Unity 6000.7: body inset 3px, selection inset 1px,
   giving a 2px outward offset; selection radius 8px. Keep native state colors/width. */
.whimtex-shader-graph-canvas .sticky-note.whimtex-shader-graph-note > #selection-border {
    left: -2px;
    right: -2px;
    top: -2px;
    bottom: -2px;
    margin: 0;
    border-radius: 8px;
}
