
.whimtex-graph-catalog-preview { flex-shrink: 0; flex-direction: row; align-items: center; justify-content: center; }
.whimtex-graph-catalog-preview--large { width: 32px; height: 32px; margin-right: 6px; }
.whimtex-graph-catalog-preview--large .whimtex-graph-catalog-icon { width: 16px; padding-left: 0; margin: 0; }
.whimtex-graph-catalog-preview > .unity-image { width: 32px; height: 32px; }
