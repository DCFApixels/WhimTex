      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx2",
          "active": true,
          "code": "// @whimtex-effect Samples/Hot Solar Limb\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 1 [0 .. 1]\r\n// @param float _Radius = 0.32 [0.1 .. 0.38]\r\n// @param float _Width = 0.014 [0.002 .. 0.035]\r\n// @param float _RimPower = 1.5 [0.3 .. 6]\r\n// @param float _Fresnel = 0.7 [0 .. 1]\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n    float r=length(uv-.5);float d=abs(r-_Radius);\r\n    float z=sqrt(saturate(1-pow(r/_Radius,2)));\r\n    float f=pow(1-z,_RimPower)*(1-smoothstep(_Radius,_Radius+.003,r));\r\n    float a=max(exp(-pow(d/_Width,2)),f*_Fresnel);\r\n    return float4(1,.67,.18,a*_Opacity);\r\n}\r\n",
