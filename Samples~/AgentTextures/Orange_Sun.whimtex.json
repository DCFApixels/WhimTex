          "$name": ""
        },
        {
          "$type": "ShaderFX",
          "$id": "fx4",
          "active": true,
          "code": "// @whimtex-effect Samples/Stellar Granulation\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 1 [0 .. 1]\r\n// @param float _Radius = 0.32 [0.1 .. 0.38]\r\n// @param float _Contrast = 2 [0.5 .. 4]\r\n// @param float _Fresnel = 0.9 [0 .. 1]\r\n// @param float _RimPower = 1.4 [0.3 .. 6]\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n    float2 p=(uv-.5)/_Radius;float r=length(p);\r\n    float z=sqrt(saturate(1-dot(p,p)));\r\n    float n=saturate(color.r);\r\n    float macro=SampleInput(saturate(.5+(uv-.5)*.16)).r;\r\n    float heat=saturate((n-.5)*_Contrast+.5+(macro-.5)*.7);\r\n    float3 ember=float3(.22,.012,.0008);\r\n    float3 orange=float3(.92,.10,.002);\r\n    float3 hot=float3(1,.43,.035);\r\n    float3 col=lerp(ember,orange,smoothstep(.05,.6,heat));\r\n    col=lerp(col,hot,pow(heat,3));\r\n    col*=.52+.24*z;\r\n    float fresnel=pow(1-z,_RimPower)*_Fresnel;\r\n    col=lerp(col,float3(1,.58,.12),fresnel);\r\n    return float4(saturate(col),(1-smoothstep(.995,1.005,r))*_Opacity);\r\n}\r\n",
          "parameters": [
