      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Samples/Star Glare\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 1 [0 .. 1]\r\n// @param enum _Part = 2 { Halo: 0, Rays: 1, Core: 2 }\r\n// @param float _Angle = 24 [-180 .. 180]\r\n// @param float _Size = 1 [0.2 .. 2]\r\n// @param float _RayWidth = 1 [0.3 .. 3]\r\n// @param float _RayLength = 1 [0.3 .. 1.5]\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n    float2 p=(uv-.5)/_Size;\r\n    float r=length(p);float a=radians(_Angle);\r\n    float2 q=float2(p.x*cos(a)-p.y*sin(a),p.x*sin(a)+p.y*cos(a));\r\n    float halo=exp(-r*10)*.65+exp(-r*r/.036)*.2;\r\n    float rays=exp(-abs(q.x)*180/_RayWidth-abs(q.y)*13/_RayLength)+exp(-abs(q.y)*230/_RayWidth-abs(q.x)*16/_RayLength);\r\n    float2 s=float2(q.x+q.y,q.y-q.x)*.7071;\r\n    rays+=.30*(exp(-abs(s.x)*300-abs(s.y)*22)+exp(-abs(s.y)*300-abs(s.x)*22));\r\n    float core=exp(-pow(r/.022,2.4))+.6*exp(-r*r/.0013);\r\n    float alpha=_Part<.5?halo:(_Part<1.5?rays:core);\r\n    alpha*=1-smoothstep(.42,.49,length(uv-.5));\r\n    return float4(1,1,1,saturate(alpha)*_Opacity);\r\n}\r\n",
