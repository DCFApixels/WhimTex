      "swizzle": {
        "packed": 0
      },
      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx2",
          "active": true,
          "code": "// @whimtex-effect Samples/Lightning Path\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 1 [0 .. 1]\r\n// @param float _Width = 0.012 [0.0005 .. 0.012]\r\n// @param float _Bend = 0.143 [0 .. 0.3]\r\n// @param float _Seed = 22.7 [0 .. 100]\r\n// @param float _Glow = 0.53 [0 .. 1]\r\n// @param float _GlowWidth = 1.8 [1 .. 20]\r\n\r\nfloat PathX(float t){return .5+_Bend*(.68*sin(t*9+_Seed)+.28*sin(t*24+1.2)+.12*sin(t*63+2));}\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n    float d=1;float along=0;\r\n    for(int i=0;i<96;i++){\r\n        float t=i/96.0;float s=(i+1)/96.0;\r\n        float2 a=float2(PathX(t),.065+t*.87);float2 b=float2(PathX(s),.065+s*.87);\r\n        float2 ab=b-a;float h=saturate(dot(uv-a,ab)/dot(ab,ab));\r\n        float distance=length(uv-a-ab*h);\r\n        if(distance<d){d=distance;along=lerp(t,s,h);}\r\n    }\r\n    float width=_Width*(.8+.2*sin(along*57+_Seed));\r\n    float aa=max(fwidth(d),.0003);\r\n    float alpha=1-smoothstep(width*.4,width+aa,d);\r\n    alpha+=_Glow*exp(-d/max(width*_GlowWidth,.0001));\r\n    alpha*=smoothstep(.045,.085,uv.y)*(1-smoothstep(.915,.955,uv.y));\r\n    return float4(1,1,1,saturate(alpha)*_Opacity);\r\n}\r\n",
          "parameters": [
            {
              "name": "_Opacity",
              "type": "Float",
              "floatValue": 1.0,
              "id": "27a18d7271df4e998249a460e2030157",
              "declaredInCode": true
            },
            {
              "name": "_Width",
              "type": "Float",
              "floatValue": 0.012,
              "id": "a0c34967d0174fbcb9c5b91ee34c17d0",
              "declaredInCode": true
            },
            {
              "name": "_Bend",
              "type": "Float",
              "floatValue": 0.143,
              "id": "1ff2a97ceb844025bafe023f058cab3d",
              "declaredInCode": true
            },
            {
              "name": "_Seed",
              "type": "Float",
              "floatValue": 22.7,
              "id": "a721d8b0b5eb40db9ab8c13a91a88dc3",
              "declaredInCode": true
            },
            {
              "name": "_Glow",
              "type": "Float",
              "floatValue": 0.53,
              "id": "4c4a94bb8d1f4d14902a28e5d4048370",
              "declaredInCode": true
            },
            {
              "name": "_GlowWidth",
              "type": "Float",
              "floatValue": 1.8,
              "id": "fe3ddb710d694973a638dce580cfddad",
              "declaredInCode": true
            }
          ],
