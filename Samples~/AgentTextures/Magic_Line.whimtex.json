      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Learn/Magic Lens\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @group(Placement)\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1, 1)\r\n// @param float _Angle = 0 [-180 .. 180]\r\n// @endgroup\r\n// @group(Profile)\r\n// @param float _HalfLength = 0.377 [0.02 .. 0.48]\r\n// @param float _HalfHeight = 0.056 [0.002 .. 0.2]\r\n// @param float _Taper = 2 [1 .. 4]\r\n// @param float _EdgeSoftness = 0.6 [0 .. 16]\r\n// @endgroup\r\n// Analytic tapered lens. Edge softness is measured in canvas pixels,\r\n// independently of length, height and the direction of the boundary.\r\nfloat4 ApplyFX(float2 uv, float4 color) {\r\n float2 p=(LayerToLocal(uv)-_Center)*_CanvasSize.xy;\r\n float c=cos(radians(_Angle)), s=sin(radians(_Angle));\r\n p=float2(c*p.x+s*p.y,-s*p.x+c*p.y)/max(abs(_Scale),0.001);\r\n float lengthPx=max(_HalfLength*_CanvasSize.x,0.001);\r\n float heightPx=max(_HalfHeight*_CanvasSize.y,0.001);\r\n float x=abs(p.x)/lengthPx;\r\n float halfHeight=heightPx*saturate(1-pow(x,_Taper));\r\n float slope=_Taper*pow(max(x,0.000001),_Taper-1)*heightPx/lengthPx;\r\n float normalization=length(float2(slope,1)/max(abs(_Scale),0.001));\r\n float upper=(p.y-halfHeight)/normalization;\r\n float lower=(p.y+halfHeight)/normalization;\r\n float aa=max(0.5*max(fwidth(upper),fwidth(lower)),0.45);\r\n float softness=max(_EdgeSoftness,aa);\r\n // Integrate a finite strip instead of blurring an infinite side:\r\n // coverage goes continuously to zero when the two sides meet at a tip.\r\n float coverage=saturate(smoothstep(-softness,softness,lower)-smoothstep(-softness,softness,upper));\r\n return float4(1,1,1,coverage*_Opacity);\r\n}\r\n",
