      "fx": [
        {
          "name": "Panel Circuitry",
          "enabled": true,
          "code": "// @whimtex-effect Samples/Panel Circuitry\n// @control(_Opacity)\n// @param hidden float _Opacity = 1 [0 .. 1]\n// @param float _Grid = 8 [2 .. 32]\n// @param color _Tint = (0.485849082, 0.9685367, 1, 1)\n\nfloat4 ApplyFX(float2 uv,float4 color){\n float2 q=uv*_Grid;float2 id=floor(q);float2 p=frac(q);\n float h=frac(sin(dot(id,float2(17.1,81.7)))*13758.5);\n if(h>.5)p=p.yx;\n float path1=exp(-abs(p.y-.3)*280)*step(.1,p.x)*step(p.x,.7);\n float path2=exp(-abs(p.x-.7)*280)*step(.3,p.y)*step(p.y,.8);\n float node=exp(-abs(length(p-float2(.1,.3))-.027)*220);\n float marks=step(.76,p.x)*step(p.x,.89)*step(.12,p.y)*step(p.y,.21)*step(.55,frac(p.y*85));\n return float4(_Tint.rgb,saturate(path1+path2+node+marks*.5)*_Opacity);}\n"
