          "$type": "ShaderFX",
          "$id": "fx2",
          "active": true,
          "code": "// @whimtex-effect Learn/Glow Envelope\r\n// @param float _HalfLength = 0.47 [0.1 .. 0.8]\r\n// @param float _Taper = 3 [1 .. 8]\r\n// Attenuate distant tips without scaling or cropping the distance field.\r\nfloat4 ApplyFX(float2 uv,float4 color) {\r\n float x=abs(LayerToLocal(uv).x-0.5)/max(_HalfLength,0.001);\r\n color.a*=pow(saturate(1-x*x),_Taper);\r\n return color;\r\n}\r\n",
