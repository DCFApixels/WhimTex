/G encode the signed radial field; B is an independent ring profile. Alpha stays opaque.)\r\n// @endgroup\r\n\r\nfloat4 ApplyFX(float2 uv, float4 color)\r\n{\r\n    float2 p = (LayerToLocal(uv) - _Center) / max(abs(_Scale), 0.0001);\r\n    float radius = length(p);\r\n    float profileRadius = 0.2995 + (radius - _Radius) / max(_Width, 0.0001);\r\n    float t = saturate(profileRadius * 2);\r\n    float radial = (_VectorProfile_Sample(t) - 0.5) * _Strength;\r\n    float2 direction = p / max(radius, 0.000001);\r\n    direction.y *= 1 - 2 * _FlipY;\r\n    float3 data = float3(_Neutral + direction * radial, _BlueProfile_Sample(t) * _BlueStrength);\r\n    return float4(saturate(data), 1);\r\n}\r\n",
