        {
          "$type": "ShaderFX",
          "$id": "fx0",
          "active": true,
          "code": "// @whimtex-effect Learn/Particle Finish\r\n// @param color _Tint = (1, 1, 1, 1)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @param float _EdgeFade = 3 [0 .. 16]\r\nfloat4 ApplyFX(float2 uv,float4 color) {\r\n float2 edge=min(uv,1-uv)*_CanvasSize.xy;\r\n float frame=_EdgeFade>0 ? smoothstep(0,_EdgeFade,min(edge.x,edge.y)) : 1;\r\n return float4(color.rgb*_Tint.rgb,color.a*_Tint.a*_Opacity*frame);\r\n}\r\n",
          "parameters": [
