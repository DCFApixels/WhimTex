      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx2",
          "active": true,
          "code": "// @whimtex-effect Light/Irregular Radial Flare\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @group(Placement)\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1, 1)\r\n// @param float _Angle = 0 [-180 .. 180]\r\n// @endgroup\r\n// @group(Rays)\r\n// @param float _Seed = 47 [1 .. ~5000]\r\n// @param float _Count = 14 [4 .. 32]\r\n// @param float _Length = 0.37 [0.1 .. 0.48]\r\n// @param float _Width = 0.055 [0.01 .. 0.15]\r\n// @param float _Variation = 0.7 [0 .. 1]\r\n// @param float _RayPower = 0.95 [0 .. 2]\r\n// @param float _Filaments = 0.35 [0 .. 1]\r\n// @endgroup\r\n// @group(Core)\r\n// @param float _Core = 0.095 [0.02 .. 0.2]\r\n// @param float _CorePower = 1.4 [0 .. 3]\r\n// @endgroup\r\nfloat H(float x){return frac(sin(x*127.1+_Seed*311.7)*43758.5453);}\r\nfloat N(float2 p){\r\n fnl_state s=fnlCreateState((int)_Seed);s.noise_type=FNL_NOISE_OPENSIMPLEX2S;s.frequency=1;\r\n return fnlGetNoise2D(s,p.x,p.y)*.5+.5;\r\n}\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float2 p=(LayerToLocal(uv)-_Center)/max(abs(_Scale),.001);\r\n float angle=radians(-_Angle),c=cos(angle),s=sin(angle);\r\n p=float2(c*p.x-s*p.y,s*p.x+c*p.y);\r\n float r=length(p),density=_CorePower*exp(-r*r/(_Core*_Core));\r\n int count=(int)round(_Count);\r\n for(int i=0;i<32;i++){\r\n  if(i>=count)break;\r\n  float fi=(float)i;\r\n  float a=(fi+(H(fi+3)-.5)*.75)*6.2831853/count;\r\n  float2 dir=float2(cos(a),sin(a));\r\n  float t=dot(p,dir),side=dot(p,float2(-dir.y,dir.x));\r\n  float len=_Length*lerp(1,lerp(.56,1.1,H(fi+13)),_Variation);\r\n  float power=H(fi+47);\r\n  float width=_Width*lerp(1,lerp(.5,1.55,H(fi+29)),_Variation)*lerp(1.15,.9,power*power);\r\n  len*=lerp(.94,1.1,power*power);\r\n  float u=saturate(t/len);\r\n  float lateral=width*(1-u*lerp(.2,.9,H(fi+73)));\r\n  lateral=max(lateral,.005);\r\n  float ray=exp(-pow(abs(side)/lateral,2.5))*exp(-3*pow(max(t,0)/len,4));\r\n  ray*=smoothstep(-.025,.02,t);\r\n  ray*=lerp(.4,2.3,power*power)*_RayPower;\r\n  float fiber=N(float2(side/max(t,.05)*38, t*3)+fi*11);\r\n  ray*=lerp(1,.45+fiber,_Filaments*smoothstep(.06,.22,t));\r\n  density+=ray;\r\n }\r\n float a=saturate(1.12*(1-exp(-density)));\r\n return float4(1,1,1,a*_Opacity);\r\n}\r\n",
