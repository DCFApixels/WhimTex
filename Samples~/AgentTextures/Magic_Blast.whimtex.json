          "$type": "ShaderFX",
          "$id": "fx0",
          "active": true,
          "code": "// @whimtex-effect Light/Final Tint\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @param color _Tint = #FFFFFF\r\n// @param float _Brightness = 1 [0 .. ~3]\r\n// @param float _Grain = 0.055 [0 .. 0.2]\r\n// @param float _EdgeFade = 16 [0 .. 64]\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float edge=min(min(uv.x,1-uv.x)*_CanvasSize.x,min(uv.y,1-uv.y)*_CanvasSize.y);\r\n float fade=_EdgeFade>0?smoothstep(0.5,_EdgeFade+0.5,edge):1;\r\n float2 px=floor(uv*_CanvasSize.xy);\r\n float noise=frac(sin(dot(px,float2(12.9898,78.233)))*43758.5453)-.5;\r\n color.a=saturate(color.a+noise*_Grain*4*color.a*(1-color.a));\r\n return float4(color.rgb*_Tint.rgb*_Brightness,color.a*_Tint.a*_Opacity*fade);\r\n}\r\n",
