          "enabled": true,
          "code": "// @whimtex-effect Samples/Mineral Chip Distribution\n// @param float _Density = 0.23 [0 .. 1]\n\nfloat4 ApplyFX(float2 uv,float4 color){\n float2 cell=floor(uv*79);float h=frac(sin(dot(cell,float2(19.7,93.1)))*43758.5);\n color.a*=step(1-_Density,h);return color;}\n"
