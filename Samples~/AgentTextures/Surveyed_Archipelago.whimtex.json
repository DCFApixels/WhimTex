          "$type": "ShaderFX",
          "$id": "fx0",
          "active": true,
          "code": "// @whimtex-effect Samples/Survey Routes\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 0.8 [0 .. 1]\r\n// @param color _Tint = (1, 0.9019608, 0.7058824, 1)\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float path=.5+.17*sin(uv.x*8)+.055*sin(uv.x*23);\r\n float dash=step(.35,frac(uv.x*65));float route=exp(-abs(uv.y-path)*850)*dash;\r\n float marks=0;\r\n for(int i=0;i<4;i++){float x=.17+i*.21;float y=.5+.17*sin(x*8)+.055*sin(x*23);\r\n float2 p=uv-float2(x,y);float r=length(p);marks+=exp(-abs(r-.009)*1300)+exp(-r*900);\r\n marks+=(1-smoothstep(.0008,.002,abs(p.x)))*step(abs(p.y),.019)+(1-smoothstep(.0008,.002,abs(p.y)))*step(abs(p.x),.019);}\r\n return float4(_Tint.rgb,saturate(route+marks)*_Opacity);}\r\n",
