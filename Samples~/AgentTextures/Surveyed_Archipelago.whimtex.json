              "type": "Float",
              "floatValue": 18.0,
              "id": "716f0f91d6aa42ec806d53d80d5be233",
              "declaredInCode": true
            }
          ],
          "shaderKey": "1cd2c5a3f92849e1b260877f5d9bcf5a",
          "$name": ""
        },
        {
          "$type": "ShaderFX",
          "$id": "fx3",
          "active": true,
          "code": "// @whimtex-effect Samples/Topographic Lines\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 0.4 [0 .. 1]\r\n// @group(Contours)\r\n// @param float _Levels = 14 [2 .. 64]\r\n// @param float _Width = 0.025 [0.01 .. 0.3]\r\n// @param color _Ink = (1, 0.905882359, 0.7411765, 1)\r\n// @endgroup\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color) {\r\n float value=color.r*_Levels;\r\n float dist=abs(frac(value+.5)-.5);\r\n float aa=max(fwidth(value),.002);\r\n float cover=1-smoothstep(_Width,_Width+aa,dist);\r\n return float4(_Ink.rgb,cover*_Opacity*_Ink.a);\r\n}\r\n",
