          "active": true,
          "code": "// @whimtex-effect Samples/Survey Grid\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 0.25 [0 .. 1]\r\n// @param float _Grid = 8 [2 .. 32]\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float2 p=abs(frac(uv*_Grid+.5)-.5);float grid=1-smoothstep(.006,.015,min(p.x,p.y));\r\n float cross=(1-smoothstep(.01,.02,p.x))*step(p.y,.07)+(1-smoothstep(.01,.02,p.y))*step(p.x,.07);\r\n float frame=1-smoothstep(.0015,.003,min(abs(uv.x-.035),min(abs(uv.x-.965),min(abs(uv.y-.035),abs(uv.y-.965)))));\r\n return float4(.68,.83,.73,saturate(grid*.35+cross+frame*.6)*_Opacity);}\r\n",
