                  "floatValue": 0.0,
                  "id": "ce25bbd65a2940d6bf758a464e45c1f7",
                  "declaredInCode": true
                },
                {
                  "name": "_Area",
                  "type": "Transform2D",
                  "transformValue": {
                    "position": {
                      "x": 0.5,
