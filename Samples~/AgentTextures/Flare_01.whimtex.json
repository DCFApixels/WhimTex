    {
      "id": "c65e1ea80cfb4545a4f2a7f1c4a9b5b2",
      "layerName": "Four Point Star",
      "enabled": true,
      "clippingMask": false,
      "opacity": 1.0,
      "blendMode": "Normal",
      "colorRange": "Standard",
