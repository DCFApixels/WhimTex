      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Learn/Diffraction Shape\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @group(Placement)\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1, 1)\r\n// @param float _Angle = 0 [-180 .. 180]\r\n// @endgroup\r\n// @group(Shape; _Style)\r\n// @param hidden enum _Style = Star {Star:0, Rays:1, Lens:2}\r\n// @param float _Radius = 0.37 [0.03 .. 0.48]\r\n// @param float _Pinch = 0.55 [0.2 .. 1]\r\n// @param float _Softness = 0.002 [0 .. 0.08]\r\n// @param float _Core = 0.023 [0.002 .. 0.12]\r\n// @param float _RayCount = 12 [2 .. 60]\r\n// @param float _RaySharpness = 28 [2 .. 100]\r\n// @param float _Seed = 29 [1 .. ~5000]\r\n// @endgroup\r\n\r\nfloat LearnHash(float2 p){ return frac(sin(dot(p,float2(127.1,311.7)))*43758.5453); }\r\nfloat LearnNoise(float2 p, float seed){\r\n fnl_state s=fnlCreateState((int)seed);s.noise_type=FNL_NOISE_OPENSIMPLEX2S;s.frequency=1;\r\n return fnlGetNoise2D(s,p.x,p.y)*.5+.5;\r\n}\r\nfloat LearnFbm(float2 p,float seed){\r\n fnl_state s=fnlCreateState((int)seed);s.noise_type=FNL_NOISE_OPENSIMPLEX2S;s.frequency=1;\r\n s.fractal_type=FNL_FRACTAL_FBM;s.octaves=3;s.gain=.42;\r\n return fnlGetNoise2D(s,p.x,p.y)*.5+.5;\r\n}\r\nfloat2 LearnRotate(float2 p,float angle){float c=cos(radians(angle)),s=sin(radians(angle));return float2(c*p.x-s*p.y,s*p.x+c*p.y);}\r\nfloat LearnEdge(float d,float softness){float w=max(fwidth(d),max(softness,.00001));return 1-smoothstep(-w,w,d);}\r\nfloat LearnGauss(float x){return exp(-x*x);}\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\nfloat2 p=LearnRotate(LayerToLocal(uv)-_Center,-_Angle)/max(abs(_Scale),.001);\r\n\r\nfloat r=length(p);float a=atan2(p.y,p.x);float coverage=0;\r\nif(_Style<.5){\r\n float2 q=abs(p)/_Radius;\r\n float d=pow(pow(q.x,_Pinch)+pow(q.y,_Pinch),1/_Pinch)-1;\r\n coverage=LearnEdge(d,_Softness*20);\r\n}else if(_Style<1.5){\r\n float ray=pow(abs(cos(a*round(_RayCount)*.5)),_RaySharpness);\r\n float varied=.5+.5*LearnNoise(float2(cos(a),sin(a))*8,_Seed);\r\n coverage=exp(-r/max(_Radius*.35,.001))*ray*varied;\r\n coverage+=exp(-r*r/max(_Core*_Core,.000001));\r\n coverage*=1-smoothstep(_Radius*.85,_Radius*1.3,r);\r\n}else{\r\n float2 q=float2(p.x/_Radius,p.y/max(.003,_Core));\r\n float d=abs(q.y)+pow(abs(q.x),1.35)-1;\r\n coverage=LearnEdge(d,_Softness*20);\r\n}\r\nreturn float4(1,1,1,saturate(coverage)*_Opacity);\r\n}\r\n",
