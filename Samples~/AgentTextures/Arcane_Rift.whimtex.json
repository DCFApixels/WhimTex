        {
          "$type": "ShaderFX",
          "$id": "fx2",
          "active": true,
          "code": "// @whimtex-effect Samples/Fractured Orbitals\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 0.85 [0 .. 1]\r\n// @group(Orbitals)\r\n// @param float _Radius = 0.29 [0.1 .. 0.45]\r\n// @param float _Seed = 7 [0 .. ~100]\r\n// @param color _Tint = (0.490196079, 0.9764706, 1, 1)\r\n// @endgroup\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float2 p=uv-.5;float r=length(p);float a=atan2(p.y,p.x+1e-7);float coverage=0;\r\n for(int i=0;i<4;i++){float rad=_Radius+i*.032;float phase=a*(11+i*3)+i*2.1;\r\n float broken=smoothstep(-.25,.05,sin(phase)+.2*sin(a*31));\r\n float band=exp(-abs(r-rad)*1800)*broken;\r\n float ticks=pow(saturate(cos(a*(64+i*11))),30)*exp(-abs(r-rad-.006)*400);\r\n coverage+=band+ticks*.5;}\r\n float wavy=_Radius-.023+sin(a*17+_Seed)*.004+sin(a*49)*.002;\r\n coverage+=exp(-abs(r-wavy)*1100)*smoothstep(-.2,.2,sin(a*5));\r\n return float4(_Tint.rgb,saturate(coverage)*_Opacity);}\r\n",
          "parameters": [
            {
              "name": "_Opacity",
              "type": "Float",
              "floatValue": 0.85,
              "id": "d9535ab1c14d41c0b633597b261bcc1e",
