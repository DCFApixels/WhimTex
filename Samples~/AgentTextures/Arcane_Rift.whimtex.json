        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Samples/Energy Motes\r\n// @control(_Amount)\r\n// @param hidden float _Amount = 0.65 [0 .. 1]\r\n// @param float _Seed = 53 [0 .. ~1000]\r\n// @param color _Tint = (0.647058845, 0.8666667, 1, 1)\r\n\r\nfloat HashM(float2 p){return frac(sin(dot(p,float2(127.1,311.7))+_Seed)*43758.5453);}\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float2 q=uv*38;float2 id=floor(q);float2 local=frac(q);\r\n float h=HashM(id);float2 center=float2(HashM(id+2.7),HashM(id+15.4))*.7+.15;\r\n float d=length((local-center)*float2(1,1.7));float size=lerp(.025,.11,HashM(id+87));\r\n float spark=(1-smoothstep(size*.35,size,d))+exp(-d*18)*.18;\r\n float r=length(uv-.5);float region=smoothstep(.16,.22,r)*(1-smoothstep(.40,.48,r));\r\n return float4(_Tint.rgb,saturate(spark*step(.68,h)*region*_Amount));}\r\n",
          "parameters": [
