        },
        {
          "$type": "ShaderFX",
          "$id": "fx4",
          "active": true,
          "code": "// @whimtex-effect Samples/Plasma Envelope\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 1 [0 .. 1]\r\n// @group(Ring)\r\n// @param float _Radius = 0.34 [0.1 .. 0.45]\r\n// @param float _Width = 0.035 [0.01 .. 0.15]\r\n// @param float _Roughness = 0.035 [0 .. 0.1]\r\n// @endgroup\r\n// @param gradient _Tint = (0, 0, 0, 1) -> (1, 1, 1, 1)\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color) {\r\n float n=saturate(color.r); float d=length(uv-0.5);\r\n float ridge=abs(d-_Radius+(n-0.5)*_Roughness);\r\n float body=exp(-pow(ridge/_Width,2.0)*3.0);\r\n float filament=pow(saturate(n),2.2);\r\n float a=saturate(body*(0.12+1.7*filament))*_Opacity;\r\n a*=1-smoothstep(.43,.48,d); a*=smoothstep(.20,.24,d);\r\n float t=saturate(0.2+filament*1.5+exp(-ridge*220.0)*0.3);\r\n return float4(_Tint_Sample(t).rgb,a);\r\n}\r\n",
          "parameters": [
