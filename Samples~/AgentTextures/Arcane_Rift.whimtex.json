        {
          "$type": "ShaderFX",
          "$id": "fx0",
          "active": true,
          "code": "// @whimtex-effect Samples/Spiral Filaments\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 0.55 [0 .. 1]\r\n// @param float _Turns = 2.4 [0.1 .. 5]\r\n// @param float _Count = 11 [2 .. 32]\r\n// @param color _Tint = (0.5803922, 0.458823532, 1, 1)\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float2 p=uv-.5;float r=length(p);float a=atan2(p.y,p.x+1e-7);\r\n float phase=a*_Count+r*_Turns*70+sin(a*3+r*25)*1.7;\r\n float thread=pow(saturate(cos(phase)),42);\r\n float fade=smoothstep(.12,.23,r)*(1-smoothstep(.32,.46,r));\r\n float gaps=smoothstep(-.2,.4,sin(a*7+r*35));\r\n return float4(_Tint.rgb,thread*fade*gaps*_Opacity);}\r\n",
          "parameters": [
            {
              "name": "_Opacity",
              "type": "Float",
              "floatValue": 0.55,
              "id": "98fd1aa491d24f12b21502454011ad56",
