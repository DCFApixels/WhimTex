          "$type": "ShaderFX",
          "$id": "fx0",
          "active": true,
          "code": "// @whimtex-effect Impact/Tone\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @param color _Tint = #FFFFFF\r\n// @param float _Brightness = 1 [0 .. ~3]\r\nfloat4 ApplyFX(float2 uv,float4 color) { return float4(color.rgb*_Tint.rgb*_Brightness,color.a*_Tint.a*_Opacity); }\r\n",
