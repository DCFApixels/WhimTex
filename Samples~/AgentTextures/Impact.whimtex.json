      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Impact/Fractured Light\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @group(Placement)\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1.05, 1.05)\r\n// @param float _Angle = 0 [-180 .. 180]\r\n// @endgroup\r\n// @group(Silhouette)\r\n// @param float _Radius = 0.205 [0.05 .. 0.4]\r\n// @param float _Width = 0.062 [0.005 .. 0.15]\r\n// @param float _Spikes = 0.22 [0 .. 0.35]\r\n// @param float _Count = 10 [3 .. 32]\r\n// @param float _Sharpness = 4.5 [1 .. 10]\r\n// @param float _Warp = 0.075 [0 .. 0.15]\r\n// @param float _Softness = 0.026 [0.001 .. 0.05]\r\n// @endgroup\r\n// @group(Light)\r\n// @param float _Brightness = 2.1 [0 .. 4]\r\n// @param float _Falloff = 2.4 [0 .. 4]\r\n// @param float _Breakup = 0.55 [0 .. 1]\r\n// @param float _Patchiness = 0.7 [0 .. 1]\r\n// @param float _Detail = 0.22 [0 .. 1]\r\n// @param float _Seed = 137 [1 .. ~5000]\r\n// @endgroup\r\nfloat ImpactN(float2 p,float seed) {\r\n fnl_state s=fnlCreateState((int)seed);s.noise_type=FNL_NOISE_OPENSIMPLEX2S;s.frequency=1;\r\n return .5+.5*fnlGetNoise2D(s,p.x,p.y);\r\n}\r\nfloat4 ApplyFX(float2 uv,float4 color) {\r\n float ca=cos(radians(_Angle)),sa=sin(radians(_Angle));\r\n float2 p=(LayerToLocal(uv)-_Center)/max(abs(_Scale),.001);\r\n p=float2(ca*p.x+sa*p.y,-sa*p.x+ca*p.y);\r\n float r=length(p);float2 dir=p/max(r,.00001);float a=atan2(p.y,p.x);\r\n float broad=ImpactN(dir*3,_Seed+37);\r\n float phase=a*round(_Count)+1.7*sin(a*3);\r\n float wave=1-abs(atan2(sin(phase),cos(phase)))/3.14159265;\r\n float spoke=pow(saturate(wave),_Sharpness);\r\n spoke*=.35+.85*ImpactN(dir*4,_Seed+81);\r\n float radius=_Radius+(broad-.5)*_Warp;\r\n float outer=radius+_Spikes*spoke+(broad-.5)*_Warp;\r\n float inner=radius-_Width+_Spikes*.2*ImpactN(dir*2,_Seed+13);\r\n float radial=saturate((r-inner)/max(outer-inner,.001));\r\n float micro=ImpactN(dir*16+float2(r*14,0),_Seed);\r\n float soft=max(_Softness,fwidth(r));\r\n float shape=smoothstep(inner-soft*1.5,inner+soft*1.5,r)*(1-smoothstep(outer-soft,outer+soft,r));\r\n float light=exp(-_Falloff*radial);\r\n float clouds=ImpactN(dir*5+float2(r*8,3),_Seed+23);\r\n light*=lerp(1,.35+clouds*1.2,_Breakup);\r\n light*=1+_Detail*(micro-.5);\r\n float clump=ImpactN(dir*3.7+float2(3.1,5.8),_Seed+19);\r\n float clump2=ImpactN(dir*11+float2(r*5,2),_Seed+83);\r\n float patch=lerp(1,lerp(.22,1.8,smoothstep(.22,.76,clump))*(.65+.7*clump2),_Patchiness);\r\n float alpha=1-exp(-shape*light*_Brightness*patch);\r\n return float4(1,1,1,saturate(alpha)*_Opacity);\r\n}\r\n",
          "parameters": [
