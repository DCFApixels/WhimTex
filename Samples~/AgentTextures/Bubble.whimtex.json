      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx3",
          "active": true,
          "code": "// @whimtex-effect Samples/Bubble Reflection\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 0.5 [0 .. 1]\r\n// @param float _Radius = 0.39 [0.1 .. 0.45]\r\n// @param float _Depth = 0.085 [0.01 .. 0.2]\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n    float2 p=uv-.5;\r\n    float r=length(p);\r\n    float edge=1-smoothstep(_Radius-.007,_Radius,r);\r\n    float2 direction=p/max(r,.0001);\r\n    float lower=pow(saturate(dot(direction,normalize(float2(.50,-1)))*.5+.5),3);\r\n    float upper=pow(saturate(dot(direction,normalize(float2(-.6,1)))*.5+.5),5);\r\n    float depth=exp(-pow((r-(_Radius-.045))/_Depth,2));\r\n    float reflection=depth*(.75*lower+.30*upper);\r\n    return float4(1,1,1,saturate(reflection*_Opacity*edge));\r\n}\r\n",
          "parameters": [
            {
              "name": "_Opacity",
              "type": "Float",
              "floatValue": 0.5,
              "id": "db80fbecfd2c491c9baf2dc085a528a9",
