      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx2",
          "active": true,
          "code": "// @whimtex-effect Samples/Bubble Rim\r\n// @control(_Opacity)\r\n// @param hidden float _Opacity = 1 [0 .. 1]\r\n// @param float _Radius = 0.39 [0.1 .. 0.45]\r\n// @param float _Width = 0.014 [0.002 .. 0.06]\r\n// @param float _Softness = 0.032 [0.005 .. 0.1]\r\n\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n    float2 p=uv-.5;\r\n    float r=length(p);\r\n    float inset=_Radius-r;\r\n    float outer=smoothstep(-.003,.003,inset);\r\n    float ring=exp(-pow((inset-.008)/_Width,2));\r\n    float soft=exp(-max(inset,0)/_Softness)*.60;\r\n    float angle=dot(p/max(r,.0001),normalize(float2(-.7,1)));\r\n    float alpha=outer*saturate(max(ring,soft)*(.82+.18*angle))*_Opacity;\r\n    return float4(1,1,1,alpha);\r\n}\r\n",
          "parameters": [
            {
              "name": "_Opacity",
              "type": "Float",
              "floatValue": 1.0,
              "id": "52a8a9a9fb454db2b90c489aa7e6ddcb",
              "declaredInCode": true
            },
            {
