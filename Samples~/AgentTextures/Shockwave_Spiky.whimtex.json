      "modifiers": [
        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Learn/Procedural Inward Shockwave\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1, 1)\r\n// @param float _Angle = 0 [-180 .. 180]\r\n// @param float _Radius = 0.356 [0.05 .. 0.48]\r\n// @param float _RimWidth = 0.019 [0.002 .. 0.1]\r\n// @param float _SpikeDepth = 0.205 [0 .. 0.3]\r\n// @param float _SpikeCount = 7 [3 .. 24]\r\n// @param float _Seed = 47 [0 .. 10000]\r\n// @param float _Variation = 0.85 [0 .. 1]\r\n// @param float _SpikeWidth = 0.70 [0.2 .. 1.5]\r\n// @param float _Curvature = 0.8 [0.3 .. 1.5]\r\n// @param float _GapFlatness = 4 [2 .. 8]\r\n// @param float _Bend = 0.8 [0 .. 1]\r\n// @param float _RimVariation = 0.018 [0 .. 0.08]\r\n// @param float _Softness = 0.001 [0 .. 0.02]\r\n// Each sector has a zero-intrusion anchor on the shared rim.\r\n// Neighbouring spikes share endpoints; gap depth does not depend on overlap.\r\n// Integer hashing keeps each spike's spacing, depth and sweep independent.\r\nfloat ShockRandom(uint i, uint stream) {\r\n uint h = i * 747796405u + (uint)round(abs(_Seed)) * 2891336453u + stream * 277803737u + 1013904223u;\r\n h = (h ^ (h >> 16)) * 2246822519u;\r\n h = (h ^ (h >> 13)) * 3266489917u;\r\n h ^= h >> 16;\r\n return (h & 16777215u) / 16777216.0;\r\n}\r\nfloat4 ApplyFX(float2 uv, float4 color) {\r\n const float tau=6.28318530718;\r\n float2 p=(LayerToLocal(uv)-_Center)/max(abs(_Scale),0.001);\r\n float co=cos(radians(_Angle)), si=sin(radians(_Angle));\r\n p=float2(co*p.x+si*p.y,-si*p.x+co*p.y);\r\n float r=length(p), a=atan2(p.y,p.x);\r\n float n=clamp(round(_SpikeCount),3,24), stepAngle=tau/n;\r\n float phase=tau*ShockRandom(0u,7u);\r\n float outer=_Radius*(1+_RimVariation*(sin(a*2+phase)+0.45*sin(a*3-phase)));\r\n float thickness=min(_RimWidth,outer*0.8);\r\n float intrusion=0;\r\n [loop] for (int i=0; i<24; ++i) {\r\n  if(i >= (int)n) break;\r\n  int j=(i+1 < (int)n) ? i+1 : 0;\r\n  float left=stepAngle*(i+0.32*_Variation*(2*ShockRandom(i,0u)-1))+phase;\r\n  float right=stepAngle*(i+1+0.32*_Variation*(2*ShockRandom(j,0u)-1))+phase;\r\n  float span=right-left;\r\n  float delta=frac((a-left)/tau)*tau;\r\n  if(delta <= span) {\r\n   float t=saturate(delta/span);\r\n   float gap=0.5+0.23*_Bend*_Variation*(2*ShockRandom(i,3u)-1);\r\n   bool leftHalf=t<gap;\r\n   int spike=leftHalf ? i : j;\r\n   float u=leftHalf ? t/gap : (1-t)/(1-gap);\r\n   float widthVariation=lerp(1,0.7+0.6*ShockRandom(spike,2u),_Variation);\r\n   float x=pow(saturate(u),_Curvature);\r\n   float shape=0.7/max(_SpikeWidth*widthVariation,0.01);\r\n   float shoulder=(1-x)/max(1+(shape-1)*x,0.0001);\r\n   float profile=pow(saturate(shoulder),_GapFlatness);\r\n   float depth=_SpikeDepth*lerp(1,0.30+ShockRandom(spike,1u),_Variation);\r\n   intrusion=depth*profile;\r\n   break;\r\n  }\r\n }\r\n float inner=max(outer-thickness-intrusion,_Radius*0.12);\r\n float od=r-outer, id=inner-r;\r\n float oa=max(min(fwidth(od)*0.65,0.004),_Softness);\r\n float ia=max(min(fwidth(id)*0.65,0.004),_Softness);\r\n float coverage=(1-smoothstep(-oa,oa,od))*(1-smoothstep(-ia,ia,id));\r\n return float4(1,1,1,coverage*_Opacity);\r\n}\r\n",
