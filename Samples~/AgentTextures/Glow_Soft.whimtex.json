    {
      "id": "6406123b4ade451eaad09ce8a0bc25d0",
      "layerName": "Irregular Light Rays",
      "enabled": true,
      "clippingMask": false,
      "opacity": 1.0,
      "blendMode": "Normal",
      "colorRange": "Standard",
