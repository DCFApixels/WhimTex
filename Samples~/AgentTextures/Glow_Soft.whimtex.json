      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Learn/Soft Flare Core\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1, 1)\r\n// @param float _Angle = 25 [-180 .. 180]\r\n// @param float _CoreRadius = 0.037 [0.005 .. 0.1]\r\n// @param float _GlowRadius = 0.12 [0.02 .. 0.3]\r\n// @param float _Glow = 0.36 [0 .. 1]\r\n// @param float _CrossLength = 0.065 [0.01 .. 0.2]\r\n// @param float _CrossWidth = 0.012 [0.002 .. 0.05]\r\nfloat4 ApplyFX(float2 uv,float4 color) {\r\n float2 p=(LayerToLocal(uv)-_Center)/max(abs(_Scale),.001);\r\n float c=cos(radians(_Angle)),s=sin(radians(_Angle));\r\n p=float2(c*p.x+s*p.y,-s*p.x+c*p.y);\r\n float r2=dot(p,p);\r\n float core=3.2*exp(-r2/(_CoreRadius*_CoreRadius));\r\n float cross=.7*exp(-p.x*p.x/(_CrossLength*_CrossLength)-p.y*p.y/(_CrossWidth*_CrossWidth));\r\n cross+=.3*exp(-p.y*p.y/(_CrossLength*_CrossLength*.5)-p.x*p.x/(_CrossWidth*_CrossWidth));\r\n float glow=_Glow*exp(-r2/(_GlowRadius*_GlowRadius));\r\n float a=(1-exp(-(core+cross+glow)))*_Opacity;\r\n float edge=min(min(uv.x,1-uv.x),min(uv.y,1-uv.y));\r\n return float4(1,1,1,a*smoothstep(0,.065,edge));\r\n}\r\n",
