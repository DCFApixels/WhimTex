      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx2",
          "active": true,
          "code": "// @whimtex-effect Learn/Soft Irregular Rays\r\n// @control(_Opacity)\r\n// @param float _Opacity = 0.95 [0 .. 1]\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1, 1)\r\n// @param float _Angle = 26 [-180 .. 180]\r\n// @param float _Length = 0.34 [0.05 .. 0.65]\r\n// @param float _Width = 0.11 [0.015 .. 0.2]\r\n// @param float _Count = 18 [4 .. 40]\r\n// @param float _Variation = 0.75 [0 .. 1]\r\n// @param float _FineRays = 0.24 [0 .. 1]\r\n// @param float _Seed = 29 [1 .. ~5000]\r\nfloat FlareHash(float x){return frac(sin(x*127.1+_Seed*311.7)*43758.5453);}\r\nfloat4 ApplyFX(float2 uv,float4 color){\r\n float2 p=(LayerToLocal(uv)-_Center)/max(abs(_Scale),.001);\r\n float sum=0;\r\n float count=round(_Count);\r\n [loop] for(int i=0;i<40;i++){\r\n  if(i>=count)break;\r\n  float h=FlareHash(i+1.17), j=FlareHash(i+32.5), k=FlareHash(i+81.3);\r\n  float a=6.2831853*(i+(h-.5)*_Variation*.9)/count+radians(_Angle);\r\n  float2 d=float2(cos(a),sin(a));\r\n  float t=dot(p,d), v=dot(p,float2(-d.y,d.x));\r\n  float len=_Length*lerp(1,lerp(.38,1.35,j),_Variation);\r\n  float amplitude=lerp(.7,lerp(.18,1,k),_Variation);\r\n  float width=.006+max(t,0)*_Width*lerp(.55,1.8,h);\r\n  float axial=exp(-max(t,0)/max(len*.42,.001))*exp(-pow(max(t,0)/max(len,.001),4));\r\n  float front=smoothstep(-.015,.018,t);\r\n  float body=exp(-v*v/(width*width));\r\n  float fine=exp(-v*v/(width*width*.085));\r\n  sum+=1.3*amplitude*front*axial*(body+.5*_FineRays*fine);\r\n  float b=a+(k-.5)*.24;\r\n  float2 d2=float2(cos(b),sin(b));\r\n  float t2=dot(p,d2),v2=dot(p,float2(-d2.y,d2.x));\r\n  float w2=.0035+max(t2,0)*_Width*.48;\r\n  float l2=len*lerp(.48,.85,h);\r\n  float tail=exp(-max(t2,0)/max(l2*.6,.001))*exp(-pow(max(t2,0)/max(l2,.001),4));\r\n  sum+=.5*amplitude*smoothstep(-.012,.018,t2)*tail*exp(-v2*v2/(w2*w2));\r\n }\r\n float ca=cos(radians(_Angle)),sa=sin(radians(_Angle));\r\n float2 q=float2(ca*p.x+sa*p.y,-sa*p.x+ca*p.y);\r\n float streak=exp(-abs(q.x)/.22)*exp(-q.y*q.y/pow(.0025+abs(q.x)*.016,2));\r\n float2 q2=float2(ca*p.x-sa*p.y,sa*p.x+ca*p.y);\r\n streak+=.7*exp(-abs(q2.x)/.23)*exp(-q2.y*q2.y/pow(.003+abs(q2.x)*.018,2));\r\n sum+=.13*streak;\r\n float r=length(p);\r\n float fade=1-smoothstep(.39,.51,r);\r\n return float4(1,1,1,(1-exp(-sum))*_Opacity*fade);\r\n}\r\n",
          "parameters": [
