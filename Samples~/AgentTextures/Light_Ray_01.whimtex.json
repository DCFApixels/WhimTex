      "fx": [
        {
          "$type": "ShaderFX",
          "$id": "fx1",
          "active": true,
          "code": "// @whimtex-effect Light/Ray\r\n// @control(_Opacity)\r\n// @param float _Opacity = 1 [0 .. 1]\r\n// @group(Placement)\r\n// @param point _Center = (0.5, 0.5)\r\n// @param float2 _Scale = (1, 1)\r\n// @param float _Angle = 0 [-180 .. 180]\r\n// @endgroup\r\n// @group(Beam)\r\n// @param float _Start = 0 [-0.1 .. 0.4]\r\n// @param float _Length = 1 [0.05 .. 1.2]\r\n// @param float _NearWidth = 0.18 [0.005 .. 0.5]\r\n// @param float _FarWidth = 0.28 [0.005 .. 0.5]\r\n// @param float _Edge = 0.002 [0.0001 .. 0.05]\r\n// @endgroup\r\n// @group(Light)\r\n// @param float _Entrance = 0.038 [0.001 .. 0.4]\r\n// @param float _Peak = 0.25 [0 .. 0.6]\r\n// @param float _Falloff = 1.7 [0.2 .. 5]\r\n// @param float _Rise = 0.36 [0 .. 2]\r\n// @param float _Brightness = 0.89 [0 .. 2]\r\n// @param float _Strands = 0.025 [0 .. 1]\r\n// @param float _Seed = 52 [1 .. ~5000]\r\n// @endgroup\r\nfloat RayNoise(float2 p) {\r\n fnl_state s=fnlCreateState((int)_Seed);s.noise_type=FNL_NOISE_OPENSIMPLEX2S;s.frequency=1;\r\n return .5+.5*fnlGetNoise2D(s,p.x,p.y);\r\n}\r\nfloat4 ApplyFX(float2 uv,float4 color) {\r\n float2 p=LayerToLocal(uv)-_Center;\r\n float c=cos(radians(_Angle)),s=sin(radians(_Angle));\r\n p=float2(c*p.x+s*p.y,-s*p.x+c*p.y)/max(abs(_Scale),.001);\r\n float x=p.x+.5;float t=(x-_Start)/max(_Length,.001);\r\n float w=lerp(_NearWidth,_FarWidth,saturate(t));\r\n float edge=max(_Edge,fwidth(p.y)*.65);\r\n float body=1-smoothstep(w-edge,w+edge,abs(p.y));\r\n float entrance=1-exp(-pow(max(0,x-_Start)/max(_Entrance,.001),2));\r\n float peak=saturate(_Peak);\r\n float tail=saturate((t-peak)/max(1-peak,.001));\r\n float rise=pow(max(saturate(t/max(peak,.001)),.00001),_Rise);\r\n float light=entrance*rise*pow(saturate(1-tail*tail),_Falloff);\r\n float threads=RayNoise(float2(p.y/max(w,.001)*15,t*.7));\r\n float alpha=body*light*_Brightness*lerp(1,.7+threads*.6,_Strands);\r\n return float4(1,1,1,saturate(alpha)*_Opacity);\r\n}\r\n",
